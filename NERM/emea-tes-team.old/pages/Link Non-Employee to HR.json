  "page_contents": [
    {
      "content": "Link Non-Employee to Employee",
      "created_at": "2026-08-27T17:44:50.699-04:00",
      "id": "067ddaf4-774b-455d-bd8f-93a7cec70979",
      "type": "FormHeading",
      "uid": "642c7bbe6fb043eeac804683f4520495",
      "updated_at": "2026-08-27T17:44:50.699-04:00"
    },
    {
      "content": "Provide the employees HR employee number to match the Non-Employee with the HR system.   Select 'Yes' to terminate the non-employee and transfer them to an employee.  Select 'No' to link the person with their employee record and continue to have an employee profile and non-employee assignments.",
