  "page_contents": [
    {
      "content": "Changing these settings will impact the processes and functioning of the application. ",
      "created_at": "2026-08-27T17:44:49.095-04:00",
      "id": "ddcd5b5e-6bce-4fce-afd5-f5ed2d8d4c2e",
      "type": "FormHeading",
      "uid": "e2a8150bd6e84af4bd223fc744f06b0f",
      "updated_at": "2026-08-27T17:44:49.095-04:00"
    },
    {
      "content": "Customer Specific Attributes",
      "created_at": "2026-08-27T17:44:49.142-04:00",
      "id": "f30dd34c-ac19-4ea9-bc79-8419e123c7c5",
      "type": "SmallHeading",
      "uid": "6356f7cd62084424be65ad18603090ab",
      "updated_at": "2026-08-27T17:44:49.142-04:00"
    },
    {
      "content": "These attributes are presented on pages and notifications and can be changed at anytime to reflect the customer information.",
      "created_at": "2026-08-27T17:44:49.182-04:00",
      "id": "c66fb3f6-5d5b-4ca3-a1cc-fbea74799fe0",
      "type": "Paragraph",
      "uid": "902267b30d4549d7a434efa087b37832",
      "updated_at": "2026-08-27T17:44:49.182-04:00"
    },
    {
      "content": "Features ",
      "created_at": "2026-08-27T17:44:49.225-04:00",
      "id": "38cebb5e-c576-4f14-9961-c7eaedfb2dfe",
      "type": "SmallHeading",
      "uid": "8488633d123a4a1e87180a24df883c21",
      "updated_at": "2026-08-27T17:44:49.225-04:00"
    },
    {
      "content": "These attributes will change how processes function in the application.  They can be changed at any time but will not impact any existing assignments.  See the Administrator's Guide for details.",
      "created_at": "2026-08-27T17:44:49.265-04:00",
      "id": "cde3a1c5-9895-403e-b5fa-ffc83f309f8c",
      "type": "Paragraph",
      "uid": "f581619eaf6b419186a1238eb49aa28b",
      "updated_at": "2026-08-27T17:44:49.265-04:00"
    },
    {
      "content": "Organization Approvals",
      "created_at": "2026-08-27T17:44:49.306-04:00",
      "id": "f09bc431-1805-49b9-9d23-aea0935c562f",
      "type": "SmallHeading",
      "uid": "63ee61ff433345e08f01255c1509b6a6",
      "updated_at": "2026-08-27T17:44:49.306-04:00"
    },
    {
      "content": "This attribute enable(checked) or disable(unchecked) organization and sub-organization termination requests to have an approvals sent to the organization's sponsor(s). When enabling these settings, ensure that all organizations have at least one sponsor set.",
      "created_at": "2026-08-27T17:44:49.345-04:00",
      "id": "b32ba4f3-f4b4-4765-be4d-1437e834d346",
      "type": "Paragraph",
      "uid": "c82fd429c1474fda90a10e468a215233",
      "updated_at": "2026-08-27T17:44:49.345-04:00"
    },
    {
      "content": "Assignment Approvals",
      "created_at": "2026-08-27T17:44:49.394-04:00",
      "id": "97339924-60db-44e8-b9f9-8a2f4769a4cf",
      "type": "SmallHeading",
      "uid": "bbd9780b4f2647fba09a6dea3c12139b",
      "updated_at": "2026-08-27T17:44:49.394-04:00"
    },
    {
      "content": "These attributes enable(checked) or disable(unchecked) assignment sponsor and/or department approvals for New assignments, updates to assignments, changes to assignment end dates, and the ending of an assignment.   When enabling these settings, ensure that assignments have sponsors set and that all departments have at least one approver set.",
      "created_at": "2026-08-27T17:44:49.434-04:00",
      "id": "d7c845d0-0014-43d9-9d84-4e17145f7dc3",
      "type": "Paragraph",
      "uid": "e132961c676944fbb2510612c395406e",
      "updated_at": "2026-08-27T17:44:49.434-04:00"
    },
    {
      "content": "Non-Human Approvals",
      "created_at": "2026-08-27T17:44:49.477-04:00",
      "id": "635fe042-1867-40a1-8f16-9422ccf830c7",
      "type": "SmallHeading",
      "uid": "aed6d72e81f5477b88b720d4eba11735",
      "updated_at": "2026-08-27T17:44:49.477-04:00"
    },
    {
      "content": "These attributes enable(checked) or disable(unchecked) non-human owner and/or non-human type approvals for New, Update, and Terminate actions on non-humans.  When enabling these settings, ensure that non-humans have owners set and that non-human types have at least one approver set where approval is needed.",
      "created_at": "2026-08-27T17:44:49.517-04:00",
      "id": "e404ef39-ff87-4431-b0cc-9b67e62f6193",
      "type": "Paragraph",
      "uid": "819efbf4b7dd4572a61691c9c46a8286",
      "updated_at": "2026-08-27T17:44:49.517-04:00"
    },
    {
      "content": "Data Loader Settings",
      "created_at": "2026-08-27T17:44:49.559-04:00",
      "id": "0ee05a70-0564-4e6c-805a-d5c04c4971b4",
      "type": "SmallHeading",
      "uid": "09e2a03457e149fa9f5da78621ab87fd",
      "updated_at": "2026-08-27T17:44:49.559-04:00"
    },
    {
      "content": "This attribute changes the requirement checks performed by the Data Loader api's.  See the Administrator's Guide for further information.",
      "created_at": "2026-08-27T17:44:49.596-04:00",
      "id": "95ffe52f-16f4-4a14-97ea-8b615887dbe4",
      "type": "Paragraph",
      "uid": "6fbcd033f79a4b3da2e2f61fe555ba18",
      "updated_at": "2026-08-27T17:44:49.596-04:00"
    }
  ]
}
