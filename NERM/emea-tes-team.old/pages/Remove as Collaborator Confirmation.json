    {
      "content": "You are about to remove the collaborator access for  {{ profile.name }}. <br>\r\n<br>\r\nThis will remove their ability to manage non-employees for {% if attribute.collaborator_type == \"suborganization\" %} the sub-organization {{ attribute.managed_suborganization }} in {{ attribute.managed_suborganization.first.suborganization_organization.first.organization_name }} {% else %} the organization {{ attribute.managed_organization }} {% endif %}.   \r\n",
