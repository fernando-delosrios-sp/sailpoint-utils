    {
      "content": "Problem with assignment request",
      "created_at": "2026-08-27T17:44:45.897-04:00",
      "id": "8236ebdf-4b8d-4f07-a819-f7c2d719c8f1",
      "type": "FormHeading",
      "uid": "701506d78f6d46c1a372b896a3d3610c",
      "updated_at": "2026-08-27T17:44:45.897-04:00"
    },
    {
      "content": "A request was made by {{ requester.name }} for an assignment with the department below.   Department approval is enabled and this department has no approvers defined. ",
      "created_at": "2026-08-27T17:44:45.936-04:00",
      "id": "0d569d0b-1e0b-438b-8e8c-c44b4cc1e2d5",
      "type": "Paragraph",
      "uid": "01bcadeb0fd241dc83cf3dca8d3f297a",
      "updated_at": "2026-08-27T17:44:45.936-04:00"
    },
    {
      "content": "Either add at least one approver to the department, or reject this request and notify the requester to select a different department.",
      "created_at": "2026-08-27T17:44:45.973-04:00",
      "id": "97d7e095-6e25-4a2e-adb5-2b7bfc687c7e",
      "type": "Paragraph",
      "uid": "58ef3d2222c84ad18d4f585dba62568f",
      "updated_at": "2026-08-27T17:44:45.973-04:00"
    },
    {
      "content": "Click 'Reject' to send the request back to the requester to choose a different department.  Click 'Approve' to be taken to the Update Department page to set an approver.",
      "created_at": "2026-08-27T17:44:46.023-04:00",
