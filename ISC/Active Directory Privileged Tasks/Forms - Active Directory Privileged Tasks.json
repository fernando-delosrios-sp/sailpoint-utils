        {
          "id": "1093420843919",
          "elementType": "SECTION",
          "config": {
            "alignment": "LEFT",
            "description": "",
            "formElements": [
              {
                "config": {
                  "description": "<p style=\"margin: 0 0 8px 0; line-height: 1.5; color: #475569;\">Create a security group directly in Active Directory. Choose a unique name, manager, group type, and organizational unit.</p><p style=\"margin: 0; line-height: 1.5; color: #475569;\">All fields are required. We validate the name before creating anything and notify the manager when complete.</p>",
                  "label": "Instructions",
                  "showLabel": false
                },
                "elementType": "DESCRIPTION",
                "id": "910366814581",
                "key": "",
                "validations": []
              },
              {
                "config": {
                  "default": "",
                  "description": "",
                  "helpText": "Used for the group CN, sAMAccountName, and display name. Maximum 64 characters.",
                  "label": "Group name",
                  "placeholder": "e.g. Finance Report Readers",
                  "required": true
                },
                "elementType": "TEXT",
                "id": "743881035847",
                "key": "name",
                "validations": [
                  {
                    "validationType": "REQUIRED"
                  },
                  {
                    "config": {
                      "message": "Use 1-64 letters, numbers, spaces, periods, underscores, or hyphens. Start and end with a letter or number.",
                      "regex": "^[A-Za-z0-9]([A-Za-z0-9 _.-]{0,62}[A-Za-z0-9])?$"
                    },
                    "validationType": "REGEX"
                  }
                ]
              },
              {
                "config": {
                  "dataSource": {
                    "config": {
                      "objectType": "IDENTITY"
                    },
                    "dataSourceType": "INTERNAL"
                  },
                  "forceSelect": true,
                  "helpText": "Select the user to set as the group manager. They will receive a notification once the group is created.",
                  "label": "Group manager",
                  "maximum": 1,
                  "placeholder": "Start typing a person's name...",
                  "required": true
                },
                "elementType": "SELECT",
                "id": "50372023181",
                "key": "managerIdentity",
                "validations": [
                  {
                    "validationType": "DATA_SOURCE"
                  },
                  {
                    "validationType": "REQUIRED"
                  }
                ]
              },
              {
                "config": {
                  "dataSource": {
                    "config": {
                      "options": [
                        {
                          "label": "Global",
                          "subLabel": "",
                          "value": "Global Security"
                        },
                        {
                          "label": "Universal",
                          "subLabel": "",
                          "value": "Universal Security"
                        },
                        {
                          "label": "Domain Local",
                          "subLabel": "",
                          "value": "Domain Local Security"
                        }
                      ]
                    },
                    "dataSourceType": "STATIC"
                  },
                  "forceSelect": true,
                  "helpText": "Choose the group scope that matches how the group will be used.",
                  "label": "Group type",
                  "maximum": 1,
                  "placeholder": "Select a group type...",
                  "required": true
                },
                "elementType": "SELECT",
                "id": "1683611067788",
                "key": "type",
                "validations": [
                  {
                    "validationType": "DATA_SOURCE"
                  },
                  {
                    "validationType": "REQUIRED"
                  }
                ]
              },
              {
                "config": {
                  "dataSource": {
                    "config": {
                      "formInputId": "locations",
                      "sortBy": "ASC"
                    },
                    "dataSourceType": "FORM_INPUT"
                  },
                  "forceSelect": true,
                  "helpText": "Choose the organizational unit where the group will be created.",
                  "label": "Organizational unit",
                  "maximum": 1,
                  "placeholder": "Select an organizational unit...",
                  "required": true
                },
                "elementType": "SELECT",
                "id": "221382798682",
                "key": "organizationalUnit",
                "validations": [
                  {
                    "validationType": "DATA_SOURCE"
                  },
                  {
                    "validationType": "REQUIRED"
                  }
                ]
              }
            ],
            "label": "Security group details",
            "labelStyle": "h2",
            "showLabel": true
          },
          "validations": []
        }
      ],
      "formConditions": []
    }
  },
