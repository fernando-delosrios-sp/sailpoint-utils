{
  "name": "Service Account",
  "description": "Minimal AD User create for machine-account requests. Avoids empty optional attrs that can hang IQService.",
  "usageType": "CREATE_MACHINE_ACCOUNT",
  "subtypeId": "fac66722-b86f-46b4-9776-17a1d595be73",
  "fields": [
    {
      "name": "ObjectType",
      "transform": { "type": "static", "attributes": { "value": "User" } },
      "attributes": { "cloudRequired": "true" },
      "isRequired": false,
      "type": "string",
      "isMultiValued": false
    },
    {
      "name": "sAMAccountName",
      "transform": { "type": "static", "attributes": { "value": "${userInput.sAMAccountName}" } },
      "attributes": { "cloudMaxSize": "20", "cloudMaxUniqueChecks": "50", "cloudRequired": "true" },
      "isRequired": true,
      "type": "string",
      "isMultiValued": false
    },
    {
      "name": "distinguishedName",
      "transform": { "type": "static", "attributes": { "value": "CN=${userInput.sAMAccountName},OU=NHI,OU=emea-tes-team,OU=Demo,DC=seri,DC=sailpointdemo,DC=com" } },
      "attributes": { "cloudMaxUniqueChecks": "50", "cloudRequired": "true" },
      "isRequired": true,
      "type": "string",
      "isMultiValued": false
    },
    {
      "name": "displayName",
      "transform": { "type": "static", "attributes": { "value": "${userInput.displayName}" } },
      "attributes": {},
      "isRequired": false,
      "type": "string",
      "isMultiValued": false
    },
    {
      "name": "description",
      "transform": { "type": "static", "attributes": { "value": "${userInput.description}" } },
      "attributes": {},
      "isRequired": false,
      "type": "string",
      "isMultiValued": false
    },
    {
      "name": "employeeType",
      "transform": { "type": "static", "attributes": { "value": "service-account" } },
      "attributes": {},
      "isRequired": false,
      "type": "string",
      "isMultiValued": false
    },
    {
      "name": "userPrincipalName",
      "transform": { "type": "static", "attributes": { "value": "${userInput.upnUsername}@seri.sailpointdemo.com" } },
      "attributes": {},
      "isRequired": false,
      "type": "string",
      "isMultiValued": false
    },
    {
      "name": "department",
      "transform": { "type": "static", "attributes": { "value": "${userInput.environment}" } },
      "attributes": {},
      "isRequired": false,
      "type": "string",
      "isMultiValued": false
    },
    {
      "name": "password",
      "transform": { "type": "static", "attributes": { "value": "Admiral1$$" } },
      "attributes": { "cloudRequired": "true" },
      "isRequired": true,
      "type": "secret",
      "isMultiValued": false
    },
    {
      "name": "IIQDisabled",
      "transform": { "type": "static", "attributes": { "value": "false" } },
      "attributes": {},
      "isRequired": false,
      "type": "boolean",
      "isMultiValued": false
    }
  ]
}
