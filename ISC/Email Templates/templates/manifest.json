{
  "languages": [
    "en",
    "es",
    "fr",
    "it",
    "de",
    "pt",
    "ar",
    "nl"
  ],
  "settings": [
    {
      "variable": "mailDefaultLanguage",
      "default": "en",
      "description": "language when preferredLanguage is missing or unsupported (en, es, fr, it, de, pt, ar, nl)"
    },
    {
      "variable": "mailOrgName",
      "default": "EMEA TES Team",
      "description": "tenant owner or team name in the banner, sign-off and footer"
    },
    {
      "variable": "mailBannerTagline",
      "default": "Identity & Access",
      "description": "small text above the tenant owner name in the banner"
    },
    {
      "variable": "mailColorPrimary",
      "default": "#0033A1",
      "description": "banner, headings and buttons"
    },
    {
      "variable": "mailColorDark",
      "default": "#011E69",
      "description": "start of the banner gradient"
    },
    {
      "variable": "mailColorAccent",
      "default": "#0071CE",
      "description": "links, section titles and information boxes"
    },
    {
      "variable": "mailColorHighlight",
      "default": "#CC27B0",
      "description": "banner stripe and warning boxes"
    },
    {
      "variable": "mailSupportEmail",
      "default": "",
      "description": "support address shown in the footer; empty hides it"
    }
  ],
  "subjectLimit": 255,
  "subjectFallback": {
    "user_invitation-custom": "Welcome to $__global.productName",
    "user_invitation-custom.my-apps": "#set($mailOrgName = 'EMEA TES Team')Welcome to ${mailOrgName} – your access details"
  },
  "variants": {
    "user_invitation-custom": {
      "name": "my-apps",
      "file": "variants/user_invitation-custom.my-apps.json",
      "settings": [
        {
          "variable": "mailMyAppsUrl",
          "default": "https://myapps.microsoft.com",
          "description": "Microsoft My Apps address"
        },
        {
          "variable": "mailSignInDomain",
          "default": "emea-tes-team.cloud",
          "description": "domain of the sign-in email, after the username"
        }
      ]
    }
  },
