      "type": "FORM_DEFINITION"
    },
    "object": {
      "id": "db530ffe-d20c-4166-bd4d-e40d521a18cf",
      "name": "ET - Instructions",
      "description": "Acknowledgement that the operator understands emergency termination is audited and irreversible without further HR updates.",
      "owner": {
        "type": "IDENTITY",
        "id": "YOUR_OWNER_IDENTITY_ID",
        "name": "YOUR_OWNER_IDENTITY_NAME"
      },
      "usedBy": [],
      "formInput": [
        {
          "id": "username",
          "type": "STRING",
          "label": "Operator name",
          "description": "Display name of the person initiating the emergency termination."
        }
      ],
      "formElements": [
        {
          "id": "1144046420884",
          "elementType": "SECTION",
          "config": {
            "alignment": "LEFT",
            "description": "",
            "formElements": [
              {
                "config": {
                  "description": "<p style=\"margin: 0 0 8px 0; line-height: 1.5; color: #475569;\">Hello <strong>{{$.form.input.username}}</strong>.</p><p style=\"margin: 0 0 8px 0; line-height: 1.5; color: #475569;\">Emergency termination immediately changes an active worker's lifecycle state in Identity Security Cloud. Use it only when the HR system cannot be updated in time.</p><p style=\"margin: 0; line-height: 1.5; color: #475569;\">This action is audited. Confirm that you understand before continuing.</p>",
                  "label": "Introduction",
                  "showLabel": false
                },
                "elementType": "DESCRIPTION",
                "id": "1195095076399",
                "key": "",
                "validations": []
              },
              {
                "config": {
                  "default": false,
                  "falseLabel": "No",
                  "helpText": "Select Yes only if you understand that this process is audited and should be used for genuine emergencies.",
                  "label": "I understand this is audited",
                  "trueLabel": "Yes"
                },
                "elementType": "TOGGLE",
                "id": "1087534078162",
                "key": "userAcknowledgement",
                "validations": []
              }
            ],
            "label": "Acknowledgement",
            "labelStyle": "h2",
            "showLabel": true
          },
          "validations": []
        }
      ],
      "formConditions": []
    }
  },
  {
    "version": 1,
    "self": {
      "id": "2c59c0f1-72af-4c84-a518-6e934b0d36e6",
      "name": "ET - Select User",
      "type": "FORM_DEFINITION"
    },
    "object": {
      "id": "2c59c0f1-72af-4c84-a518-6e934b0d36e6",
      "name": "ET - Select User",
      "description": "Select an active direct report and provide a required justification for emergency termination.",
      "owner": {
        "type": "IDENTITY",
        "id": "YOUR_OWNER_IDENTITY_ID",
        "name": "YOUR_OWNER_IDENTITY_NAME"
      },
      "usedBy": [],
      "formInput": [
        {
          "id": "username",
          "type": "STRING",
          "label": "Operator name",
          "description": "Display name of the person initiating the emergency termination. Used to list their direct reports."
        }
      ],
      "formElements": [
        {
          "id": "1144046420884",
          "elementType": "SECTION",
          "config": {
            "alignment": "LEFT",
            "description": "",
            "formElements": [
              {
                "config": {
                  "description": "<p style=\"margin: 0 0 8px 0; line-height: 1.5; color: #475569;\">Select the active worker who reports to you and explain why their access must be terminated immediately.</p><p style=\"margin: 0; line-height: 1.5; color: #475569;\">Only active direct reports are listed. The justification is required and is shown to the approver.</p>",
                  "label": "Introduction",
                  "showLabel": false
                },
                "elementType": "DESCRIPTION",
                "id": "1195095076399",
                "key": "",
                "validations": []
              },
              {
                "config": {
                  "dataSource": {
                    "config": {
                      "filters": {
                        "manager.displayName": {
                          "exclude": false,
                          "value": "{{$.form.input.username}}"
                        }
                      },
                      "indices": [
                        "identities"
                      ],
                      "label": "attributes.displayName",
                      "query": "attributes.cloudLifecycleState:active",
                      "sublabel": "attributes.email",
                      "value": "id"
                    },
                    "dataSourceType": "SEARCH_V2"
                  },
                  "forceSelect": true,
                  "helpText": "Choose exactly one active direct report. The value stored is their identity ID.",
                  "label": "Selected person",
                  "maximum": 1,
                  "placeholder": "Start typing a name...",
                  "required": true
                },
                "elementType": "SELECT",
                "id": "1641681738546",
                "key": "selectedIndividual",
                "validations": [
                  {
                    "validationType": "DATA_SOURCE"
                  },
                  {
                    "validationType": "REQUIRED"
                  }
                ]
              },
              {
                "config": {
                  "default": "",
                  "description": "",
                  "helpText": "Describe why this emergency termination is required. This text is shown to the approver and retained for audit.",
                  "label": "Justification",
                  "placeholder": "e.g. Immediate security incident; HR update not yet available",
                  "required": true,
                  "resize": true,
                  "rows": 3
                },
                "elementType": "TEXTAREA",
                "id": "625087201363",
                "key": "justification",
                "validations": [
                  {
                    "validationType": "REQUIRED"
                  }
                ]
              }
            ],
            "label": "Select person",
            "labelStyle": "h2",
            "showLabel": true
          },
          "validations": []
        }
      ],
      "formConditions": []
    }
  },
