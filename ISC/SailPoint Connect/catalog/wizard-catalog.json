{
  "version": 1,
  "menuFlow": ["Project", "Action", "Integration", "Product", "Variant", "CredentialKind", "ReuseOrCreate", "Access"],
  "actions": ["BuildRequirements", "Check", "BuildScript", "Run"],
  "products": {
    "fabric": {
      "label": "SailPoint Fabric",
      "access": ["ReadOnly", "ReadWrite"],
      "legacyCoreSwitches": ["SaaSConnector", "Connector"]
    },
    "entro": {
      "label": "Entro",
      "access": ["ReadOnly"],
      "legacyCoreSwitches": ["Entro", "GcpEntro", "WorkspaceEntro"]
    },
    "ciem": {
      "label": "CIEM",
      "access": ["ReadOnly", "ReadWrite"],
      "legacyCoreSwitches": ["CiemConnector"]
    }
  },
  "policies": {
    "oneProductPerRun": true,
    "mutations": "additive-only",
    "update": {
      "rotateSecrets": false,
      "reusePromptWhenDiscriminatorsMatch": true
    }
  },
  "credentialKinds": {
    "entra.appClientSecret": {
      "label": "Entra application (client secret)",
      "discriminators": ["TenantId", "ClientId"],
      "secretFields": ["ClientSecret"],
      "checkSubject": "EntraApplication"
    },
    "aws.iamAssumeRole": {
      "label": "AWS IAM role (ExternalId trust)",
      "discriminators": ["RoleName", "AccountId"],
      "secretFields": [],
      "checkSubject": "IamRole"
    },
    "gcp.serviceAccountKey": {
      "label": "GCP service account key (JSON)",
      "discriminators": ["ProjectId", "ServiceAccountId", "ServiceAccountName"],
      "secretFields": ["PrivateKey", "ClientSecret"],
      "checkSubject": "GcpServiceAccount"
    },
    "gcp.workloadIdentity": {
      "label": "GCP Workload Identity Federation",
      "discriminators": ["ProjectId", "OrganizationId"],
      "secretFields": [],
      "checkSubject": "GcpServiceAccount"
    },
    "google.workspaceDomainDelegation": {
      "label": "Google Workspace domain-wide delegation",
      "discriminators": ["ClientId", "ProjectId"],
      "secretFields": [],
      "checkSubject": "Manual"
    },
    "google.oauthClientCredentials": {
      "label": "Google OAuth client credentials",
      "discriminators": ["ClientId", "ProjectId"],
      "secretFields": ["ClientSecret"],
      "checkSubject": "GcpServiceAccount"
    },
    "github.appInstallation": {
      "label": "GitHub App (installation + PEM)",
      "discriminators": ["Organization", "AppId", "InstallationId"],
      "secretFields": ["PrivateKey"],
      "checkSubject": "GitHubToken"
    },
    "github.pat": {
      "label": "GitHub personal access token",
      "discriminators": ["Organization"],
      "secretFields": ["Token"],
      "checkSubject": "GitHubToken"
    },
    "okta.jwtServiceApp": {
      "label": "Okta OAuth service app (JWT + PEM)",
      "discriminators": ["OktaDomain", "ClientId"],
      "secretFields": ["PrivateKey", "PrivateKeyPassword"],
      "checkSubject": "Manual"
    },
    "okta.apiServicesPublicKey": {
      "label": "Okta API Services app (Entro public key)",
      "discriminators": ["OktaDomain", "ClientId"],
      "secretFields": [],
      "checkSubject": "Manual"
    },
    "oauth.clientIdSecret": {
      "label": "OAuth2 client ID and secret",
      "discriminators": ["ClientId", "BaseUrl", "InstanceUrl"],
      "secretFields": ["ClientSecret", "ConsumerSecret"],
      "checkSubject": "Manual"
    },
    "salesforce.connectedAppOrToken": {
      "label": "Salesforce Connected App or bearer token",
      "discriminators": ["InstanceUrl", "ConsumerKey"],
      "secretFields": ["ConsumerSecret", "AccessToken"],
      "checkSubject": "Manual"
    },
    "slack.botUserAppTokens": {
      "label": "Slack bot, user, and app-level tokens",
      "discriminators": ["WorkspaceName"],
      "secretFields": ["BotUserOAuthToken", "UserOAuthToken", "AppLevelToken"],
      "checkSubject": "Manual"
    },
    "snowflake.keyPairUser": {
      "label": "Snowflake key-pair user",
      "discriminators": ["AccountUrl", "EntroUser"],
      "secretFields": [],
      "checkSubject": "Manual"
    },
    "vault.policyToken": {
      "label": "HashiCorp Vault policy token",
      "discriminators": ["VaultAddress"],
      "secretFields": ["AccessToken"],
      "checkSubject": "Manual"
    },
    "gitlab.accessToken": {
      "label": "GitLab access token",
      "discriminators": ["BaseUrl"],
      "secretFields": ["AccessToken"],
      "checkSubject": "Manual"
    },
    "servicenow.restApiKey": {
      "label": "ServiceNow REST API key",
      "discriminators": ["InstanceUrl"],
      "secretFields": ["AccessToken"],
      "checkSubject": "Manual"
    }
  },
  "integrations": [
    {
      "id": "aws",
      "title": "Amazon Web Services",
      "cli": "aws",
      "launcher": "AWS.ps1",
      "platformName": "AWS",
      "products": {
        "fabric": {
          "bindings": [
            {
              "variantId": "saas",
              "label": "AWS SaaS connector",
              "definitionId": "aws-saas-connector",
              "definitionModule": "modules/Definitions/Aws.Connector.psm1",
              "folderName": "Amazon-Web-Services-SaaS",
              "credentialKinds": ["aws.iamAssumeRole"]
            }
          ]
        },
        "ciem": {
          "bindings": [
            {
              "variantId": "aws-ciem",
              "label": "AWS CIEM connector",
              "definitionId": "aws-ciem-connector",
              "definitionModule": "modules/Definitions/Aws.Connector.psm1",
              "folderName": "Amazon-Web-Services-CIEM",
              "credentialKinds": ["aws.iamAssumeRole"]
            }
          ]
        },
        "entro": {
          "bindings": [
            {
              "variantId": "aws",
              "label": "Entro AWS account",
              "definitionId": "aws-entro",
              "definitionModule": "modules/Definitions/Aws.Entro.psm1",
              "folderName": "Entro-AWS",
              "credentialKinds": ["aws.iamAssumeRole"]
            }
          ]
        }
      }
    },
