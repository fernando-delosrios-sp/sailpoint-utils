{
  "definition": {
    "start": "Configuration",
    "steps": {
      "Configuration": {
        "actionId": "sp:define-variable",
        "attributes": {
          "id": "sp:define-variable",
          "variables": [
            {
              "description": "Source id whose entitlements populate the lookup table (Admin > Connections > Sources).",
              "name": "sourceId",
              "transforms": [],
              "variableA": "YOUR_SOURCE_ID"
            },
            {
              "description": "Name of the existing lookup transform to replace on each run.",
              "name": "transformName",
              "transforms": [],
              "variableA": "YOUR_LOOKUP_TRANSFORM_NAME"
            },
            {
              "description": "ISC API base URL (no trailing slash).",
              "name": "url",
              "transforms": [],
              "variableA": "https://{tenant}.api.identitynow-demo.com"
            },
            {
              "description": "Optional lookup default value. Leave blank to omit the default entry.",
              "name": "defaultValue",
              "transforms": [],
              "variableA": ""
            },
            {
              "description": "Accumulated JSON table fragments (comma-prefixed key/value pairs).",
              "name": "tableEntries",
              "transforms": [],
              "variableA": ""
            },
            {
              "description": "Set to true when at least one key/value pair was appended.",
              "name": "tableHasEntries",
              "transforms": [],
              "variableA": "false"
            },
            {
              "description": "Scratch: escaped key for the current loop item.",
              "name": "entryKey",
              "transforms": [],
              "variableA": ""
            },
            {
              "description": "Scratch: escaped value for the current loop item.",
              "name": "entryValue",
              "transforms": [],
              "variableA": ""
            }
          ]
        },
        "description": "Set sourceId, transformName, and url before enabling. Replace KEY_ATTRIBUTE and VALUE_ATTRIBUTE in every serial loop step with the entitlement attribute names that hold the lookup key and value. Built-in fields: use $.loop.loopInput.value or $.loop.loopInput.name instead of attributes.*.",
        "displayName": "Configuration",
        "nextStep": "List Entitlements Page 0",
        "type": "Mutation"
      },
      "List Entitlements Page 0": {
        "actionId": "sp:http",
        "attributes": {
          "authenticationType": "OAuth",
          "param_authenticationRef": "oauth",
          "param_oauth": {
            "mapping": {
              "auth_client_id": "clientId",
              "auth_client_secret": "clientSecret",
              "auth_credential_location": "credentialLocation",
              "auth_token_url": "tokenURL"
            },
            "paramID": "YOUR_OAUTH_PARAMETER_ID",
            "paramType": "1.4"
          },
          "param_oauth_scopes": {
            "mapping": {
              "auth_scopes": "scopes"
            },
            "paramID": "YOUR_OAUTH_SCOPES_PARAMETER_ID",
            "paramType": "3.1"
          },
          "requestContentType": "json",
          "method": "get",
          "url": "{$.defineVariable.url}/v3/entitlements?limit=250&offset=0&sorters=id&filters=source.id%20eq%20%22{$.defineVariable.sourceId}%22"
        },
        "catch": [
          {
            "next": "End Step - Failure"
          }
        ],
        "description": "First page of entitlements for the configured source.",
        "displayName": "List entitlements (page 0)",
        "nextStep": "Check Any Entitlements",
        "type": "action",
        "versionNumber": 3
      },
      "Check Any Entitlements": {
        "actionId": "sp:compare-numbers",
        "choiceList": [
          {
            "comparator": "NumericGreaterThan",
            "nextStep": "Serial Loop Page 0",
            "variableA.$": "$.listEntitlementsPage0.body.length()",
            "variableB": 0
          }
        ],
        "defaultStep": "End Step - Failure Empty Source",
        "description": "Refuse to replace the transform when the source has no entitlements.",
        "displayName": "Any entitlements?",
        "type": "choice"
      },
      "Serial Loop Page 0": {
        "actionId": "sp:loop:serial",
        "attributes": {
          "input.$": "$.listEntitlementsPage0.body",
          "loopType": "forLoop",
          "start": "Key Present",
          "steps": {
            "Key Present": {
              "actionId": "sp:compare-unary",
              "choiceList": [
                {
                  "comparator": "IsPresent",
                  "nextStep": "Key Not Empty",
                  "variableA.$": "$.loop.loopInput.attributes.KEY_ATTRIBUTE"
                }
              ],
              "defaultStep": "Iteration Done",
              "displayName": "Lookup key present?",
              "type": "choice"
            },
            "Key Not Empty": {
              "actionId": "sp:compare-strings",
              "choiceList": [
                {
                  "comparator": "StringEquals",
                  "nextStep": "Iteration Done",
                  "variableA.$": "$.loop.loopInput.attributes.KEY_ATTRIBUTE",
                  "variableB": ""
                }
              ],
              "defaultStep": "Set Entry Key",
              "displayName": "Lookup key non-empty?",
              "type": "choice"
            },
            "Set Entry Key": {
              "actionId": "sp:update-variable",
              "attributes": {
                "id": "sp:update-variable",
                "variables": [
                  {
                    "name": "$.defineVariable.entryKey",
                    "transforms": [
                      {
                        "id": "sp:transform:replace:string",
                        "input": {
                          "pattern": "\\",
                          "replacement": "\\\\"
                        }
                      },
                      {
                        "id": "sp:transform:replace:string",
                        "input": {
                          "pattern": "\"",
                          "replacement": "\\\""
                        }
                      }
                    ],
                    "variableA.$": "$.loop.loopInput.attributes.KEY_ATTRIBUTE"
                  }
                ]
              },
              "displayName": "Escape lookup key",
              "nextStep": "Set Entry Value",
              "type": "Mutation"
            },
            "Set Entry Value": {
              "actionId": "sp:update-variable",
              "attributes": {
                "id": "sp:update-variable",
                "variables": [
                  {
                    "name": "$.defineVariable.entryValue",
                    "transforms": [
                      {
                        "id": "sp:transform:replace:string",
                        "input": {
                          "pattern": "\\",
                          "replacement": "\\\\"
                        }
                      },
                      {
                        "id": "sp:transform:replace:string",
                        "input": {
                          "pattern": "\"",
                          "replacement": "\\\""
                        }
                      }
                    ],
                    "variableA.$": "$.loop.loopInput.attributes.VALUE_ATTRIBUTE"
                  }
                ]
              },
              "displayName": "Escape lookup value",
              "nextStep": "Append Table Entry",
              "type": "Mutation"
            },
            "Append Table Entry": {
              "actionId": "sp:update-variable",
              "attributes": {
                "id": "sp:update-variable",
                "variables": [
                  {
                    "name": "$.defineVariable.tableEntries",
                    "transforms": [
                      {
                        "id": "sp:transform:concatenate:string",
                        "input": {
                          "variableB": ",\"{{$.defineVariable.entryKey}}\":\"{{$.defineVariable.entryValue}}\""
                        }
                      }
                    ],
                    "variableA.$": "$.defineVariable.tableEntries"
                  },
                  {
                    "name": "$.defineVariable.tableHasEntries",
                    "transforms": [],
                    "variableA": "true"
                  }
                ]
              },
              "displayName": "Append lookup pair",
              "nextStep": "Iteration Done",
              "type": "Mutation"
            },
            "Iteration Done": {
              "displayName": "Iteration complete",
              "type": "success"
            }
          }
        },
        "catch": [
          {
            "next": "End Step - Failure"
          }
        ],
        "description": "Append key/value pairs from the first entitlement page. Edit KEY_ATTRIBUTE and VALUE_ATTRIBUTE in JSON paths.",
        "displayName": "Build table (page 0)",
        "nextStep": "Check Page 0 Full",
        "type": "action",
        "versionNumber": 1
      },
      "Check Page 0 Full": {
        "actionId": "sp:compare-numbers",
        "choiceList": [
          {
            "comparator": "NumericEquals",
            "nextStep": "List Entitlements Page 1",
            "variableA.$": "$.listEntitlementsPage0.body.length()",
            "variableB": 250
          }
        ],
        "defaultStep": "Check Table Has Entries",
        "displayName": "Page 0 has 250 items?",
        "type": "choice"
      },
