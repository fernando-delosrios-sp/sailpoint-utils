        "attributes": {
          "authenticationType": "OAuth",
          "param_authenticationRef": "oauth",
          "param_oauth": {
            "mapping": {
              "auth_client_id": "clientId",
              "auth_client_secret": "clientSecret",
              "auth_credential_location": "credentialLocation",
              "auth_token_url": "tokenURL"
            },
            "paramID": "YOUR_OAUTH_PARAMETER_ID",
            "paramType": "1.4"
          },
          "param_oauth_scopes": {
            "mapping": {
              "auth_scopes": "scopes"
            },
            "paramID": "YOUR_OAUTH_SCOPES_PARAMETER_ID",
            "paramType": "3.1"
          },
          "requestContentType": "json",
          "method": "get",
          "url": "{{$.defineVariable.url}}/v3/entitlements?limit=1&offset=1000&sorters=id&filters=source.id%20eq%20%22{{$.defineVariable.sourceId}}%22"
        },
        "catch": [
          {
            "next": "End Step - Failure"
          }
        ],
        "description": "If any row exists, the source exceeds the 1000-entitlement workflow limit.",
        "displayName": "Probe entitlements (offset 1000)",
        "nextStep": "Check Over 1000 Limit",
        "type": "action",
        "versionNumber": 3
      },
      "Check Over 1000 Limit": {
        "actionId": "sp:compare-numbers",
        "choiceList": [
          {
            "comparator": "NumericGreaterThan",
            "nextStep": "End Step - Failure Over Limit",
            "variableA.$": "$.probeEntitlementsOver1000.body.length()",
            "variableB": 0
          }
        ],
        "defaultStep": "Check Table Has Entries",
        "displayName": "More than 1000 entitlements?",
        "type": "choice"
      },
      "Check Table Has Entries": {
        "actionId": "sp:compare-strings",
        "choiceList": [
          {
            "comparator": "StringEquals",
            "nextStep": "Get Transform By Name",
            "variableA.$": "$.defineVariable.tableHasEntries",
            "variableB": "true"
          }
        ],
        "defaultStep": "End Step - Failure Empty Table",
        "description": "Every entitlement had a blank lookup key.",
        "displayName": "Table has entries?",
        "type": "choice"
      },
      "Get Transform By Name": {
        "actionId": "sp:http",
        "attributes": {
          "authenticationType": "OAuth",
          "param_authenticationRef": "oauth",
          "param_oauth": {
            "mapping": {
              "auth_client_id": "clientId",
              "auth_client_secret": "clientSecret",
              "auth_credential_location": "credentialLocation",
              "auth_token_url": "tokenURL"
            },
            "paramID": "YOUR_OAUTH_PARAMETER_ID",
            "paramType": "1.4"
          },
          "param_oauth_scopes": {
            "mapping": {
              "auth_scopes": "scopes"
            },
            "paramID": "YOUR_OAUTH_SCOPES_PARAMETER_ID",
            "paramType": "3.1"
          },
          "requestContentType": "json",
          "method": "get",
          "url": "{{$.defineVariable.url}}/v3/transforms?filters=name%20eq%20%22{{$.defineVariable.transformName}}%22"
        },
        "catch": [
          {
            "next": "End Step - Failure"
          }
        ],
        "description": "Resolve the target transform id and confirm it exists.",
        "displayName": "Get transform by name",
        "nextStep": "Check Transform Found",
        "type": "action",
        "versionNumber": 3
      },
      "Check Transform Found": {
        "actionId": "sp:compare-numbers",
        "choiceList": [
          {
            "comparator": "NumericGreaterThan",
            "nextStep": "Check Transform Type",
            "variableA.$": "$.getTransformByName.body.length()",
            "variableB": 0
          }
        ],
        "defaultStep": "End Step - Failure Transform Missing",
        "displayName": "Transform found?",
        "type": "choice"
      },
      "Check Transform Type": {
        "actionId": "sp:compare-strings",
        "choiceList": [
          {
            "comparator": "StringEquals",
            "nextStep": "Sync Table Entries",
            "variableA.$": "$.getTransformByName.body[0].type",
            "variableB": "lookup"
          }
        ],
        "defaultStep": "End Step - Failure Transform Missing",
        "description": "Only lookup transforms are replaced.",
        "displayName": "Transform is lookup?",
        "type": "choice"
      },
      "Sync Table Entries": {
        "actionId": "sp:define-variable",
        "attributes": {
          "id": "sp:define-variable",
          "variables": [
            {
              "description": "Read accumulated table fragments after serial loops (avoids stale inline templating).",
              "name": "syncedTableEntries",
              "transforms": [],
              "variableA.$": "$.defineVariable.tableEntries"
            }
          ]
        },
        "displayName": "Sync table entries",
        "nextStep": "Check Default Value",
        "type": "Mutation"
      },
      "Check Default Value": {
        "actionId": "sp:compare-unary",
        "choiceList": [
          {
            "comparator": "IsPresent",
            "nextStep": "Check Default Non Empty",
            "variableA.$": "$.defineVariable.defaultValue"
          }
        ],
        "defaultStep": "Wrap Table Object",
        "displayName": "Default configured?",
        "type": "choice"
      },
      "Check Default Non Empty": {
        "actionId": "sp:compare-strings",
        "choiceList": [
          {
            "comparator": "StringEquals",
            "nextStep": "Wrap Table Object",
            "variableA.$": "$.defineVariable.defaultValue",
            "variableB": ""
          }
        ],
        "defaultStep": "Append Default To Table",
        "displayName": "Default non-empty?",
        "type": "choice"
      },
      "Replace Transform": {
        "actionId": "sp:http",
        "attributes": {
          "authenticationType": "OAuth",
          "param_authenticationRef": "oauth",
          "param_oauth": {
            "mapping": {
              "auth_client_id": "clientId",
              "auth_client_secret": "clientSecret",
              "auth_credential_location": "credentialLocation",
              "auth_token_url": "tokenURL"
            },
            "paramID": "YOUR_OAUTH_PARAMETER_ID",
            "paramType": "1.4"
          },
          "param_oauth_scopes": {
            "mapping": {
              "auth_scopes": "scopes"
            },
            "paramID": "YOUR_OAUTH_SCOPES_PARAMETER_ID",
            "paramType": "3.1"
          },
          "requestContentType": "json",
          "method": "put",
          "url": "{{$.defineVariable.url}}/v3/transforms/{{$.getTransformByName.body[0].id}}",
          "jsonRequestBody.$": "$.defineVariable.transformPutBody"
        },
        "catch": [
          {
            "next": "End Step - Failure"
          }
        ],
        "description": "Replaces the entire lookup transform attributes.table with the built map.",
        "displayName": "Replace lookup transform",
        "nextStep": "End Step - Success",
        "type": "action",
        "versionNumber": 3
      },
      "End Step - Success": {
        "description": "The lookup transform was replaced with entitlements from the configured source.",
        "displayName": "Success: Transform Replaced",
        "type": "success"
      },
      "End Step - Failure": {
        "description": "An HTTP request failed. The transform was not replaced.",
        "displayName": "Failure: Dynamic Lookup Table",
        "failureName": "Dynamic Lookup Table Failed",
        "type": "failure"
      },
      "End Step - Failure Empty Source": {
        "description": "The source returned no entitlements. The transform was not replaced.",
        "displayName": "Failure: Empty Source",
        "failureName": "Empty Source",
        "type": "failure"
      },
      "End Step - Failure Empty Table": {
        "description": "No entitlement had a usable lookup key. The transform was not replaced.",
        "displayName": "Failure: Empty Table",
        "failureName": "Empty Lookup Table",
        "type": "failure"
      },
      "End Step - Failure Over Limit": {
        "description": "The source has more than 1000 entitlements. The transform was not replaced.",
        "displayName": "Failure: Over 1000 Entitlements",
        "failureName": "Entitlement Limit Exceeded",
        "type": "failure"
      },
      "End Step - Failure Transform Missing": {
        "description": "The named transform was not found or is not type lookup. The transform was not replaced.",
        "displayName": "Failure: Transform Not Found",
        "failureName": "Transform Not Found",
        "type": "failure"
      },
      "Wrap Table Object": {
        "actionId": "sp:define-variable",
        "attributes": {
          "id": "sp:define-variable",
          "variables": [
            {
              "description": "Lookup table object JSON (keys from entitlements plus optional default).",
              "name": "tableJsonObject",
              "transforms": [
                {
                  "id": "sp:transform:concatenate:string",
                  "input": {
                    "variableB.$": "$.defineVariable.syncedTableEntries"
                  }
                },
                {
                  "id": "sp:transform:concatenate:string",
                  "input": {
                    "variableB": "}"
                  }
                },
                {
                  "id": "sp:transform:replace:string",
                  "input": {
                    "pattern": "{,",
                    "replacement": "{"
                  }
                }
              ],
              "variableA": "{"
            }
          ]
        },
        "displayName": "Wrap table object",
        "nextStep": "Build Put Body",
        "type": "Mutation"
      },
      "Append Default To Table": {
        "actionId": "sp:define-variable",
        "attributes": {
          "id": "sp:define-variable",
          "variables": [
            {
              "name": "syncedTableEntries",
              "transforms": [
                {
                  "id": "sp:transform:concatenate:string",
                  "input": {
                    "variableB": ",\"default\":\""
                  }
                },
                {
                  "id": "sp:transform:concatenate:string",
                  "input": {
                    "variableB.$": "$.defineVariable.defaultValue"
                  }
                },
                {
                  "id": "sp:transform:concatenate:string",
                  "input": {
                    "variableB": "\""
                  }
                }
              ],
              "variableA.$": "$.defineVariable.syncedTableEntries"
            }
          ]
        },
        "displayName": "Append default entry",
        "nextStep": "Wrap Table Object",
        "type": "Mutation"
      },
      "Build Put Body": {
        "actionId": "sp:define-variable",
        "attributes": {
          "id": "sp:define-variable",
          "variables": [
            {
              "name": "transformPutBody",
              "transforms": [
                {
                  "id": "sp:transform:concatenate:string",
                  "input": {
                    "variableB.$": "$.getTransformByName.body[0].name"
                  }
                },
                {
                  "id": "sp:transform:concatenate:string",
                  "input": {
                    "variableB": "\",\"type\":\"lookup\",\"attributes\":{\"table\": "
                  }
                },
                {
                  "id": "sp:transform:concatenate:string",
                  "input": {
                    "variableB.$": "$.defineVariable.tableJsonObject"
                  }
                },
                {
                  "id": "sp:transform:concatenate:string",
                  "input": {
                    "variableB": "}}"
                  }
                }
              ],
              "variableA": "{\"name\":\""
            }
          ]
        },
        "displayName": "Build PUT body",
        "nextStep": "Replace Transform",
        "type": "Mutation"
      }
    }
  },
  "owner": {
    "type": "IDENTITY",
    "id": "YOUR_OWNER_IDENTITY_ID",
    "name": "YOUR_OWNER_NAME"
  },
  "trigger": {
    "type": "SCHEDULED",
    "attributes": {
      "cronString": "0 2 * * *",
      "frequency": "cronSchedule",
      "timeZone": "UTC"
    }
  },
  "name": "Dynamic Lookup Table",
  "description": "Scheduled integration: rebuild a lookup transform from entitlements on a configured source (sourceId, transformName, key attribute, value attribute). Each run fully replaces attributes.table on the existing lookup transform.",
  "enabled": false
}
