{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Role",
  "type": "object",
  "required": ["name", "owner"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": ["string", "null"] },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "enabled": { "type": "boolean" },
    "requestable": { "type": "boolean" },
    "owner": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string" },
        "id": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"] }
      }
    },
    "accessProfiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": ["string", "null"] },
          "name": { "type": ["string", "null"] }
        }
      }
    },
    "entitlements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": ["string", "null"] },
          "name": { "type": ["string", "null"] },
          "type": { "type": "string" }
        }
      }
    },
    "membership": { "type": ["object", "null"] },
    "accessRequestConfig": { "type": ["object", "null"] },
    "revocationRequestConfig": { "type": ["object", "null"] },
    "segments": { "type": "array" },
    "dimensional": { "type": "boolean" },
    "dimensionRefs": { "type": "array" }
  }
}
