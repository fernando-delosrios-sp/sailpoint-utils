{
  "name": "AMCM Approval",
  "description": "Single external-trigger workflow for access-item changes, full restores, and drift sync. Branches on $.trigger.kind: 'change' asks the configured governance group first and, when owner approval is enabled, every changed item's owner in parallel afterwards; 'restore' and 'drift' ask only the governance group. Posts the decision back to GitHub via repository_dispatch.",
  "definition": {
    "start": "Configuration",
    "steps": {
      "Configuration": {
        "actionId": "sp:define-variable",
        "attributes": {
          "id": "sp:define-variable",
          "variables": [
            {
              "description": "Full repository_dispatch URL for the target repository",
              "name": "githubDispatchUrl",
              "transforms": [],
              "variableA": "https://api.github.com/repos/YOUR_GITHUB_OWNER/YOUR_GITHUB_REPO/dispatches"
            },
            {
            "description": "Full Authorization header value, e.g. 'Bearer ghp_xxx' (fine-grained PAT or GitHub App installation token with contents:write). Sent as a literal Authorization header, not basicAuthPassword — ISC only accepts a $.secrets.<id> reference there, which can't be set via the workflow write API.",
            "name": "githubDispatchToken",
            "transforms": [],
            "variableA": "YOUR_GITHUB_DISPATCH_TOKEN"
            },
            {
              "description": "Ask each changed item's owner to approve after the governance group approves. Set to 'false' to make the governance group the only approver. Admins may change this value later.",
              "name": "ownerApprovalEnabled",
              "transforms": [],
              "variableA": "YOUR_OWNER_APPROVAL_ENABLED"
            }
          ]
        },
        "displayName": "Configuration",
        "nextStep": "Change or Restore",
        "type": "Mutation"
      },
      "Change or Restore": {
        "choiceList": [
          {
            "comparator": "StringEquals",
            "variableA.$": "$.trigger.kind",
            "variableB": "restore",
            "nextStep": "Governance Approval Restore"
          },
          {
            "comparator": "StringEquals",
            "variableA.$": "$.trigger.kind",
            "variableB": "drift",
            "nextStep": "Governance Approval Drift"
          }
        ],
        "defaultStep": "Governance Approval Change",
        "displayName": "Route on trigger payload kind (change vs restore vs drift)",
        "type": "choice"
      },
      "Governance Approval Change": {
        "actionId": "sp:generic-approval",
        "attributes": {
          "name": "Access model change approval",
          "description.$": "$.trigger.approvalText",
          "requestedBy": "WORKFLOW_OWNER",
          "requestedFor": "WORKFLOW_OWNER",
          "reAuthRequired": false,
          "approvalType": "SINGLE",
          "singleApproverCategory": "GOVERNANCE_GROUP",
          "singleApproverGovernanceGroupId": "YOUR_GOVERNANCE_GROUP_ID",
          "priority": "MEDIUM",
          "approvalReminder": "false",
          "approvalTimeout": "YOUR_APPROVAL_TIMEOUT_DAYS",
          "approvalActionAtTimeout": "EXPIRED"
        },
        "displayName": "Governance group approval (change)",
        "nextStep": "Governance Decision Change",
        "type": "action",
        "versionNumber": 1
      },
      "Governance Decision Change": {
        "choiceList": [
          {
            "comparator": "StringEquals",
            "variableA.$": "$.governanceApprovalChange.status",
            "variableB": "APPROVED",
            "nextStep": "Owner Approval Required"
          },
          {
            "comparator": "StringEquals",
            "variableA.$": "$.governanceApprovalChange.status",
            "variableB": "EXPIRED",
            "nextStep": "Dispatch Expired Change"
          }
        ],
        "defaultStep": "Dispatch Rejected Change",
        "displayName": "Governance approved?",
        "type": "choice"
      },
      "Owner Approval Required": {
        "choiceList": [
          {
            "comparator": "StringEquals",
            "variableA.$": "$.configuration.ownerApprovalEnabled",
            "variableB": "true",
            "nextStep": "Any Owners"
          }
        ],
        "defaultStep": "Dispatch Approved Change",
        "displayName": "Is item owner approval configured?",
        "type": "choice"
      },
      "Any Owners": {
        "choiceList": [
          {
            "comparator": "IsPresent",
            "variableA.$": "$.trigger.owners[0].id",
            "nextStep": "Loop Owner Approvals"
          }
        ],
        "defaultStep": "Dispatch Approved Change",
        "displayName": "Any item owners to ask?",
        "type": "choice"
      },
      "Loop Owner Approvals": {
        "actionId": "sp:loop:iterator",
        "attributes": {
          "context.$": "$",
          "input.$": "$.trigger.owners",
          "start": "Owner Approval",
          "steps": {
            "Owner Approval": {
              "actionId": "sp:generic-approval",
              "attributes": {
                "name": "Access model change approval (item owner)",
                "description.$": "$.loop.context.trigger.approvalText",
                "requestedBy": "WORKFLOW_OWNER",
                "requestedFor": "WORKFLOW_OWNER",
                "reAuthRequired": false,
                "approvalType": "SINGLE",
                "singleApproverCategory": "IDENTITY",
                "singleApproverIdentityId.$": "$.loop.loopInput.id",
                "priority": "MEDIUM",
                "approvalReminder": "false",
                "approvalTimeout": "YOUR_APPROVAL_TIMEOUT_DAYS",
                "approvalActionAtTimeout": "EXPIRED"
              },
              "displayName": "Item owner approval",
              "nextStep": "Owner Decision",
              "type": "action",
              "versionNumber": 1
            },
            "Owner Decision": {
              "choiceList": [
                {
                  "comparator": "StringEquals",
                  "variableA.$": "$.ownerApproval.status",
                  "variableB": "APPROVED",
                  "nextStep": "Owner Approved"
                }
              ],
              "defaultStep": "Owner Rejected",
              "displayName": "Owner approved?",
              "type": "choice"
            },
            "Owner Approved": {
              "displayName": "Owner approved",
              "type": "success"
            },
            "Owner Rejected": {
              "actionId": "sp:operator-failure",
              "failureName": "Owner Rejected",
              "displayName": "Owner rejected",
              "type": "failure"
            }
          }
        },
        "displayName": "Ask every item owner in parallel",
        "nextStep": "Any Owner Rejected",
        "type": "action",
        "versionNumber": 1
      },
      "Any Owner Rejected": {
        "choiceList": [
          {
            "comparator": "IsPresent",
            "variableA.$": "$.loopOwnerApprovals.loopOutput.failureItems[0]",
            "nextStep": "Dispatch Owner Rejected"
          }
        ],
        "defaultStep": "Dispatch Approved Change",
        "displayName": "Did any owner reject?",
        "type": "choice"
      },
      "Dispatch Approved Change": {
        "actionId": "sp:http",
        "attributes": {
          "method": "post",
          "url.$": "$.configuration.githubDispatchUrl",
          "requestContentType": "json",
          "jsonRequestBody": {
            "event_type": "isc-change-decision",
            "client_payload": {
              "decision": "approved",
              "diffHash.$": "$.trigger.diffHash",
              "pr": {
                "number.$": "$.trigger.pr.number",
                "title.$": "$.trigger.pr.title",
                "url.$": "$.trigger.pr.url",
                "author.$": "$.trigger.pr.author"
              },
              "headSha.$": "$.trigger.pr.headSha",
              "comment.$": "$.governanceApprovalChange.comments",
              "executionId.$": "$.trigger.executionId"
            }
          },
          "requestHeaders": {
            "Authorization.$": "$.configuration.githubDispatchToken",
            "Accept": "application/vnd.github+json",
            "X-GitHub-Api-Version": "2022-11-28"
          }
        },
        "displayName": "GitHub: change approved",
        "nextStep": "Success",
        "type": "action",
        "versionNumber": 2
      },
      "Dispatch Rejected Change": {
        "actionId": "sp:http",
        "attributes": {
          "method": "post",
          "url.$": "$.configuration.githubDispatchUrl",
          "requestContentType": "json",
          "jsonRequestBody": {
            "event_type": "isc-change-decision",
            "client_payload": {
              "decision": "rejected",
              "diffHash.$": "$.trigger.diffHash",
              "pr": {
                "number.$": "$.trigger.pr.number",
                "title.$": "$.trigger.pr.title",
                "url.$": "$.trigger.pr.url",
                "author.$": "$.trigger.pr.author"
              },
              "headSha.$": "$.trigger.pr.headSha",
              "comment.$": "$.governanceApprovalChange.comments",
              "executionId.$": "$.trigger.executionId"
            }
          },
          "requestHeaders": {
            "Authorization.$": "$.configuration.githubDispatchToken",
            "Accept": "application/vnd.github+json",
            "X-GitHub-Api-Version": "2022-11-28"
          }
        },
        "displayName": "GitHub: change rejected by governance group",
        "nextStep": "End Rejected",
        "type": "action",
        "versionNumber": 2
      },
      "Dispatch Owner Rejected": {
        "actionId": "sp:http",
        "attributes": {
          "method": "post",
          "url.$": "$.configuration.githubDispatchUrl",
          "requestContentType": "json",
          "jsonRequestBody": {
            "event_type": "isc-change-decision",
            "client_payload": {
              "decision": "rejected",
              "diffHash.$": "$.trigger.diffHash",
              "pr": {
                "number.$": "$.trigger.pr.number",
                "title.$": "$.trigger.pr.title",
                "url.$": "$.trigger.pr.url",
                "author.$": "$.trigger.pr.author"
              },
              "headSha.$": "$.trigger.pr.headSha",
              "comment": "Rejected by an access item owner.",
              "executionId.$": "$.trigger.executionId"
            }
          },
          "requestHeaders": {
            "Authorization.$": "$.configuration.githubDispatchToken",
            "Accept": "application/vnd.github+json",
            "X-GitHub-Api-Version": "2022-11-28"
          }
        },
        "displayName": "GitHub: change rejected by item owner",
        "nextStep": "End Rejected",
        "type": "action",
        "versionNumber": 2
      },
      "Dispatch Expired Change": {
        "actionId": "sp:http",
        "attributes": {
          "method": "post",
          "url.$": "$.configuration.githubDispatchUrl",
          "requestContentType": "json",
          "jsonRequestBody": {
            "event_type": "isc-change-decision",
            "client_payload": {
              "decision": "expired",
              "diffHash.$": "$.trigger.diffHash",
              "pr": {
                "number.$": "$.trigger.pr.number",
                "title.$": "$.trigger.pr.title",
                "url.$": "$.trigger.pr.url",
                "author.$": "$.trigger.pr.author"
              },
              "headSha.$": "$.trigger.pr.headSha",
              "executionId.$": "$.trigger.executionId"
            }
          },
          "requestHeaders": {
            "Authorization.$": "$.configuration.githubDispatchToken",
            "Accept": "application/vnd.github+json",
            "X-GitHub-Api-Version": "2022-11-28"
          }
        },
        "displayName": "GitHub: change approval expired",
        "nextStep": "End Rejected",
        "type": "action",
        "versionNumber": 2
      },
      "Governance Approval Restore": {
        "actionId": "sp:generic-approval",
        "attributes": {
          "name": "Access model restore approval",
          "description.$": "$.trigger.approvalText",
          "requestedBy": "WORKFLOW_OWNER",
          "requestedFor": "WORKFLOW_OWNER",
          "reAuthRequired": false,
          "approvalType": "SINGLE",
          "singleApproverCategory": "GOVERNANCE_GROUP",
          "singleApproverGovernanceGroupId": "YOUR_GOVERNANCE_GROUP_ID",
          "priority": "HIGH",
          "approvalReminder": "false",
          "approvalTimeout": "YOUR_APPROVAL_TIMEOUT_DAYS",
          "approvalActionAtTimeout": "EXPIRED"
        },
        "displayName": "Governance group approval (restore)",
        "nextStep": "Decision Restore",
        "type": "action",
        "versionNumber": 1
      },
      "Decision Restore": {
        "choiceList": [
          {
            "comparator": "StringEquals",
            "variableA.$": "$.governanceApprovalRestore.status",
            "variableB": "APPROVED",
            "nextStep": "Dispatch Approved Restore"
          }
        ],
        "defaultStep": "Dispatch Rejected Restore",
        "displayName": "Approved?",
        "type": "choice"
      },
      "Dispatch Approved Restore": {
        "actionId": "sp:http",
        "attributes": {
          "method": "post",
          "url.$": "$.configuration.githubDispatchUrl",
          "requestContentType": "json",
          "jsonRequestBody": {
            "event_type": "isc-restore-decision",
            "client_payload": {
              "decision": "approved",
              "planHash.$": "$.trigger.planHash",
              "sourceTag.$": "$.trigger.sourceTag",
              "requester.$": "$.trigger.requester",
              "comment.$": "$.governanceApprovalRestore.comments",
              "executionId.$": "$.trigger.executionId"
            }
          },
          "requestHeaders": {
            "Authorization.$": "$.configuration.githubDispatchToken",
            "Accept": "application/vnd.github+json",
            "X-GitHub-Api-Version": "2022-11-28"
          }
        },
        "displayName": "GitHub: restore approved",
        "nextStep": "Success",
        "type": "action",
        "versionNumber": 2
      },
      "Dispatch Rejected Restore": {
        "actionId": "sp:http",
        "attributes": {
          "method": "post",
          "url.$": "$.configuration.githubDispatchUrl",
          "requestContentType": "json",
          "jsonRequestBody": {
            "event_type": "isc-restore-decision",
            "client_payload": {
              "decision": "rejected",
              "planHash.$": "$.trigger.planHash",
              "sourceTag.$": "$.trigger.sourceTag",
              "requester.$": "$.trigger.requester",
              "comment.$": "$.governanceApprovalRestore.comments",
              "executionId.$": "$.trigger.executionId"
            }
          },
          "requestHeaders": {
            "Authorization.$": "$.configuration.githubDispatchToken",
            "Accept": "application/vnd.github+json",
            "X-GitHub-Api-Version": "2022-11-28"
          }
        },
        "displayName": "GitHub: restore rejected",
        "nextStep": "End Rejected",
        "type": "action",
        "versionNumber": 2
      },
      "Governance Approval Drift": {
        "actionId": "sp:generic-approval",
        "attributes": {
          "name": "Access model drift approval",
          "description.$": "$.trigger.approvalText",
          "requestedBy": "WORKFLOW_OWNER",
          "requestedFor": "WORKFLOW_OWNER",
          "reAuthRequired": false,
          "approvalType": "SINGLE",
          "singleApproverCategory": "GOVERNANCE_GROUP",
          "singleApproverGovernanceGroupId": "YOUR_GOVERNANCE_GROUP_ID",
          "priority": "MEDIUM",
          "approvalReminder": "false",
          "approvalTimeout": "YOUR_APPROVAL_TIMEOUT_DAYS",
          "approvalActionAtTimeout": "EXPIRED"
        },
        "displayName": "Governance group approval (drift)",
        "nextStep": "Decision Drift",
        "type": "action",
        "versionNumber": 1
      },
      "Decision Drift": {
        "choiceList": [
          {
            "comparator": "StringEquals",
            "variableA.$": "$.governanceApprovalDrift.status",
            "variableB": "APPROVED",
            "nextStep": "Dispatch Approved Drift"
          },
          {
            "comparator": "StringEquals",
            "variableA.$": "$.governanceApprovalDrift.status",
            "variableB": "EXPIRED",
            "nextStep": "Dispatch Expired Drift"
          }
        ],
        "defaultStep": "Dispatch Rejected Drift",
        "displayName": "Approved?",
        "type": "choice"
      },
      "Dispatch Approved Drift": {
        "actionId": "sp:http",
        "attributes": {
          "method": "post",
          "url.$": "$.configuration.githubDispatchUrl",
          "requestContentType": "json",
          "jsonRequestBody": {
            "event_type": "isc-drift-decision",
            "client_payload": {
              "decision": "approved",
              "driftHash.$": "$.trigger.driftHash",
              "comment.$": "$.governanceApprovalDrift.comments",
              "executionId.$": "$.trigger.executionId"
            }
          },
          "requestHeaders": {
            "Authorization.$": "$.configuration.githubDispatchToken",
            "Accept": "application/vnd.github+json",
            "X-GitHub-Api-Version": "2022-11-28"
          }
        },
        "displayName": "GitHub: drift approved",
        "nextStep": "Success",
        "type": "action",
        "versionNumber": 2
      },
      "Dispatch Rejected Drift": {
        "actionId": "sp:http",
        "attributes": {
          "method": "post",
          "url.$": "$.configuration.githubDispatchUrl",
          "requestContentType": "json",
          "jsonRequestBody": {
            "event_type": "isc-drift-decision",
            "client_payload": {
              "decision": "rejected",
              "driftHash.$": "$.trigger.driftHash",
              "comment.$": "$.governanceApprovalDrift.comments",
              "executionId.$": "$.trigger.executionId"
            }
          },
          "requestHeaders": {
            "Authorization.$": "$.configuration.githubDispatchToken",
            "Accept": "application/vnd.github+json",
            "X-GitHub-Api-Version": "2022-11-28"
          }
        },
        "displayName": "GitHub: drift rejected",
        "nextStep": "End Rejected",
        "type": "action",
        "versionNumber": 2
      },
      "Dispatch Expired Drift": {
        "actionId": "sp:http",
        "attributes": {
          "method": "post",
          "url.$": "$.configuration.githubDispatchUrl",
          "requestContentType": "json",
          "jsonRequestBody": {
            "event_type": "isc-drift-decision",
            "client_payload": {
              "decision": "expired",
              "driftHash.$": "$.trigger.driftHash",
              "comment.$": "$.governanceApprovalDrift.comments",
              "executionId.$": "$.trigger.executionId"
            }
          },
          "requestHeaders": {
            "Authorization.$": "$.configuration.githubDispatchToken",
            "Accept": "application/vnd.github+json",
            "X-GitHub-Api-Version": "2022-11-28"
          }
        },
        "displayName": "GitHub: drift expired",
        "nextStep": "End Rejected",
        "type": "action",
        "versionNumber": 2
      },
      "Success": {
        "actionId": "sp:operator-success",
        "attributes": {
          "description": "Decision approved and GitHub notified"
        },
        "displayName": "Success",
        "type": "success"
      },
      "End Rejected": {
        "actionId": "sp:operator-success",
        "attributes": {
          "description": "Decision rejected or expired and GitHub notified"
        },
        "displayName": "Rejected",
        "type": "success"
      }
    }
  },
  "trigger": {
    "type": "EXTERNAL",
    "attributes": {
      "id": "idn:external-http",
      "description": "GitHub Actions posts a change payload (kind=\"change\": approvalText, owners, pr, diffHash), a restore payload (kind=\"restore\": approvalText, sourceTag, planHash, requester), or a drift payload (kind=\"drift\": approvalText, driftHash) when the daily backup finds ISC edited outside the PR flow."
    }
  },
  "enabled": false,
  "creator": {
    "type": "IDENTITY",
    "id": "YOUR_OWNER_IDENTITY_ID",
    "name": "YOUR_OWNER_IDENTITY_NAME"
  }
}
