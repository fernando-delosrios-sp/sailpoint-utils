{
  "definition": {
    "start": "Collect Details",
    "steps": {
      "Check Identity Exists": {
        "actionId": "sp:compare-boolean",
        "choiceList": [
          {
            "comparator": "BooleanEquals",
            "nextStep": "Load Matched Identity",
            "variableA.$": "$.reviewDuplicates.formData.newIdentity",
            "variableB": false
          }
        ],
        "defaultStep": "Check Manager Approval Required",
        "displayName": "Identity exists?",
        "type": "choice"
      },
      "Check Duplicate Count": {
        "actionId": "sp:compare-numbers",
        "choiceList": [
          {
            "comparator": "NumericGreaterThan",
            "nextStep": "Review Duplicates",
            "variableA.$": "$.searchIdentities.identities.length()",
            "variableB": 0
          }
        ],
        "defaultStep": "Check Manager Approval Required",
        "displayName": "Potential duplicates found?",
        "type": "choice"
      },
      "Set Configuration": {
        "actionId": "sp:define-variable",
        "attributes": {
          "id": "sp:define-variable",
          "variables": [
            {
              "description": "Identity search query combining fuzzy name match and exact email.",
              "name": "Identity Query",
              "transforms": [],
              "variableA": "(attributes.firstname:{{$.collectDetails.formData.firstName}}~2 AND attributes.lastname:{{$.collectDetails.formData.lastName}}~2) OR attributes.email:\"{{$.collectDetails.formData.email}}\""
            },
            {
              "description": "ISC API base URL for account creation.",
              "name": "ISC API URL",
              "transforms": [],
              "variableA": "https://company24509-poc.api.identitynow-demo.com"
            },
            {
              "description": "ISC UI base URL for identity deep links.",
              "name": "ISC UI URL",
              "transforms": [],
              "variableA": "https://company24509-poc.identitynow-demo.com"
            },
            {
              "description": "Source ID for the accounts API (configure in tenant).",
              "name": "Accounts Source",
              "transforms": [],
              "variableA": "xxx"
            },
            {
              "description": "Set to true to require the selected manager to approve before the account is created. Any other value skips the approval form.",
              "name": "Manager Approval Required",
              "transforms": [],
              "variableA": "true"
            },
            {
              "description": "Display name as entered by the operator.",
              "name": "Display Name",
              "transforms": [],
              "variableA": "{{$.collectDetails.formData.firstName}} {{$.collectDetails.formData.lastName}}"
            },
            {
              "description": "Sanitized username for the new account.",
              "name": "Account Name",
              "transforms": [
                {
                  "id": "sp:transform:replace:string",
                  "input": {
                    "pattern": " ",
                    "replacement": ""
                  }
                },
                {
                  "id": "sp:transform:replace:string",
                  "input": {
                    "pattern": "[^A-Za-z0-9.]",
                    "replacement": ""
                  }
                },
                {
                  "id": "sp:transform:replace:string",
                  "input": {
                    "pattern": "A",
                    "replacement": "a"
                  }
                },
                {
                  "id": "sp:transform:replace:string",
                  "input": {
                    "pattern": "B",
                    "replacement": "b"
                  }
                },
                {
                  "id": "sp:transform:replace:string",
                  "input": {
                    "pattern": "C",
                    "replacement": "c"
                  }
                },
                {
                  "id": "sp:transform:replace:string",
                  "input": {
                    "pattern": "D",
                    "replacement": "d"
                  }
                },
                {
                  "id": "sp:transform:replace:string",
                  "input": {
                    "pattern": "E",
                    "replacement": "e"
                  }
                },
                {
                  "id": "sp:transform:replace:string",
                  "input": {
                    "pattern": "F",
                    "replacement": "f"
                  }
                },
                {
                  "id": "sp:transform:replace:string",
                  "input": {
                    "pattern": "G",
                    "replacement": "g"
                  }
                },
                {
                  "id": "sp:transform:replace:string",
                  "input": {
                    "pattern": "H",
                    "replacement": "h"
                  }
                },
                {
                  "id": "sp:transform:replace:string",
                  "input": {
                    "pattern": "I",
                    "replacement": "i"
                  }
                },
                {
                  "id": "sp:transform:replace:string",
                  "input": {
                    "pattern": "J",
                    "replacement": "j"
                  }
                },
                {
                  "id": "sp:transform:replace:string",
                  "input": {
                    "pattern": "K",
                    "replacement": "k"
                  }
                },
                {
                  "id": "sp:transform:replace:string",
                  "input": {
                    "pattern": "L",
                    "replacement": "l"
                  }
                },
                {
                  "id": "sp:transform:replace:string",
                  "input": {
                    "pattern": "M",
                    "replacement": "m"
                  }
                },
                {
                  "id": "sp:transform:replace:string",
                  "input": {
                    "pattern": "N",
                    "replacement": "n"
                  }
                },
                {
                  "id": "sp:transform:replace:string",
                  "input": {
                    "pattern": "O",
                    "replacement": "o"
                  }
                },
                {
                  "id": "sp:transform:replace:string",
                  "input": {
                    "pattern": "P",
                    "replacement": "p"
                  }
                },
                {
                  "id": "sp:transform:replace:string",
                  "input": {
                    "pattern": "Q",
                    "replacement": "q"
                  }
                },
                {
                  "id": "sp:transform:replace:string",
                  "input": {
                    "pattern": "R",
                    "replacement": "r"
                  }
                },
                {
                  "id": "sp:transform:replace:string",
                  "input": {
                    "pattern": "S",
                    "replacement": "s"
                  }
                },
                {
                  "id": "sp:transform:replace:string",
                  "input": {
                    "pattern": "T",
                    "replacement": "t"
                  }
                },
                {
                  "id": "sp:transform:replace:string",
                  "input": {
                    "pattern": "U",
                    "replacement": "u"
                  }
                },
                {
                  "id": "sp:transform:replace:string",
                  "input": {
                    "pattern": "V",
                    "replacement": "v"
                  }
                },
                {
                  "id": "sp:transform:replace:string",
                  "input": {
                    "pattern": "W",
                    "replacement": "w"
                  }
                },
                {
                  "id": "sp:transform:replace:string",
                  "input": {
                    "pattern": "X",
                    "replacement": "x"
                  }
                },
                {
                  "id": "sp:transform:replace:string",
                  "input": {
                    "pattern": "Y",
                    "replacement": "y"
                  }
                },
                {
                  "id": "sp:transform:replace:string",
                  "input": {
                    "pattern": "Z",
                    "replacement": "z"
                  }
                }
              ],
              "variableA": "{{$.collectDetails.formData.firstName}}.{{$.collectDetails.formData.lastName}}"
            }
          ]
        },
        "displayName": "Set configuration",
        "nextStep": "Search Identities",
        "type": "Mutation"
      },
      "End Success": {
        "actionId": "sp:operator-success",
        "displayName": "Done",
        "type": "success"
      },
      "Load Matched Identity": {
        "actionId": "sp:get-identity",
        "attributes": {
          "id.$": "$.reviewDuplicates.formData.identities",
          "resultSelector": [
            "$.loadMatchedIdentity.attributes.lastname",
            "$.loadMatchedIdentity.attributes.email",
            "$.loadMatchedIdentity.attributes.displayName",
            "$.loadMatchedIdentity.attributes.firstname"
          ]
        },
        "displayName": "Load matched identity",
        "nextStep": "Show Matched Identity",
        "type": "action",
        "versionNumber": 2
      },
      "Search Identities": {
        "actionId": "sp:get-identities",
        "attributes": {
          "inputQuery.$": "$.setConfiguration.identityQuery",
          "searchBy": "searchQuery"
        },
        "displayName": "Search for matching identities",
        "nextStep": "Check Duplicate Count",
        "type": "action",
        "versionNumber": 2
      },
      "Create Account": {
        "actionId": "sp:http",
        "attributes": {
          "authenticationType": "OAuth",
          "jsonRequestBody": {
            "attributes": {
              "sourceId": "{{$.setConfiguration.accountsSource}}",
              "id": "{{$.setConfiguration.accountName}}",
              "name": "{{$.setConfiguration.accountName}}",
              "givenName": "{{$.collectDetails.formData.firstName}}",
              "familyName": "{{$.collectDetails.formData.lastName}}",
              "e-mail": "{{$.collectDetails.formData.email}}",
              "location": "{{$.collectDetails.formData.location}}",
              "manager": "{{$.collectDetails.formData.manager}}"
            }
          },
          "method": "post",
          "param_authenticationRef": "oauth",
          "param_oauth": {
            "mapping": {
              "auth_client_id": "clientId",
              "auth_client_secret": "clientSecret",
              "auth_credential_location": "credentialLocation",
              "auth_token_url": "tokenURL"
            },
            "paramID": "",
            "paramType": "1.4"
          },
          "requestContentType": "json",
          "url": "{{$.setConfiguration.iSCAPIURL}}/accounts/v1"
        },
        "displayName": "Create account on source",
        "nextStep": "Show Account Created",
        "type": "action",
        "versionNumber": 3
      },
      "Collect Details": {
        "actionId": "sp:interactive-form",
        "attributes": {
          "formDefinitionId": "cbd73c0c-ea5b-4bc4-8359-e733b2468a87",
          "interactiveProcessId.$": "$.trigger.interactiveProcessId",
          "message": "<p><span style=\"font-size: 18pt; color: #236fa1;\"><strong>Step 1 of 2</strong></span> \u2014 Enter the new hire's details.</p>",
          "ownerId.$": "$.trigger.launchedBy.id",
          "title": "New hire details"
        },
        "displayName": "New hire details",
        "nextStep": "Set Configuration",
        "type": "action",
        "versionNumber": 1
      },
      "Review Duplicates": {
        "actionId": "sp:interactive-form",
        "attributes": {
          "formDefinitionId": "7e08da3e-f229-437d-82bc-c2f75274b447",
          "inputForForm_array_identities.$": "$.searchIdentities.identities",
          "inputForForm_array_identities_label": "$.name",
          "inputForForm_array_identities_subLabel": "$.email",
          "inputForForm_array_identities_value": "$.id",
          "interactiveProcessId.$": "$.trigger.interactiveProcessId",
          "message": "<p><span style=\"font-size: 18pt; color: #236fa1;\"><strong>Step 2 of 2</strong></span> \u2014 Confirm whether this person is already in the directory.</p>",
          "ownerId.$": "$.trigger.launchedBy.id",
          "title": "Review possible matches"
        },
        "displayName": "Review possible matches",
        "nextStep": "Check Identity Exists",
        "type": "action",
        "versionNumber": 1
      },
      "Show Matched Identity": {
        "actionId": "sp:interactive-message",
        "attributes": {
          "category": "INFO",
          "interactiveProcessId.$": "$.trigger.interactiveProcessId",
          "message": "<p style=\"margin: 0 0 16px 0; line-height: 1.5;\">No new record was created. The person you selected already has a profile.</p>\n<table style=\"border-collapse: collapse; margin: 0 0 20px 0; width: 100%; max-width: 480px;\">\n<tr>\n<td style=\"padding: 8px 24px 8px 0; vertical-align: top; width: 120px; color: #64748b;\">Name</td>\n<td style=\"padding: 8px 0; vertical-align: top;\"><strong>{{$.loadMatchedIdentity.attributes.displayName}}</strong></td>\n</tr>\n<tr>\n<td style=\"padding: 8px 24px 8px 0; vertical-align: top; color: #64748b;\">First name</td>\n<td style=\"padding: 8px 0; vertical-align: top;\">{{$.loadMatchedIdentity.attributes.firstname}}</td>\n</tr>\n<tr>\n<td style=\"padding: 8px 24px 8px 0; vertical-align: top; color: #64748b;\">Last name</td>\n<td style=\"padding: 8px 0; vertical-align: top;\">{{$.loadMatchedIdentity.attributes.lastname}}</td>\n</tr>\n<tr>\n<td style=\"padding: 8px 24px 8px 0; vertical-align: top; color: #64748b;\">Email</td>\n<td style=\"padding: 8px 0; vertical-align: top;\">{{$.loadMatchedIdentity.attributes.email}}</td>\n</tr>\n</table>\n<p style=\"margin: 0;\"><a href=\"{{$.setConfiguration.iSCUIURL}}/ui/a/admin/identities/{{$.loadMatchedIdentity.id}}/details/attributes\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color: #236fa1; font-weight: 600;\">View full profile</a></p>",
          "ownerId.$": "$.trigger.launchedBy.id",
          "title": "Already in the directory"
        },
        "displayName": "Confirm existing person",
        "nextStep": "End Success",
        "type": "action",
        "versionNumber": 1
      },
      "Show Account Created": {
        "actionId": "sp:interactive-message",
        "attributes": {
          "category": "INFO",
          "interactiveProcessId.$": "$.trigger.interactiveProcessId",
          "message": "<p style=\"margin: 0 0 16px 0; line-height: 1.5;\">Thank you. A record has been created for your new hire. Access and applications will be assigned according to your organisation's standard process.</p>\n<table style=\"border-collapse: collapse; margin: 0 0 20px 0; width: 100%; max-width: 480px;\">\n<tr>\n<td style=\"padding: 8px 24px 8px 0; vertical-align: top; width: 120px; color: #64748b;\">Name</td>\n<td style=\"padding: 8px 0; vertical-align: top;\"><strong>{{$.setConfiguration.displayName}}</strong></td>\n</tr>\n<tr>\n<td style=\"padding: 8px 24px 8px 0; vertical-align: top; color: #64748b;\">Email</td>\n<td style=\"padding: 8px 0; vertical-align: top;\">{{$.collectDetails.formData.email}}</td>\n</tr>\n<tr>\n<td style=\"padding: 8px 24px 8px 0; vertical-align: top; color: #64748b;\">Sign-in name</td>\n<td style=\"padding: 8px 0; vertical-align: top;\">{{$.setConfiguration.accountName}}</td>\n</tr>\n<tr>\n<td style=\"padding: 8px 24px 8px 0; vertical-align: top; color: #64748b;\">Location</td>\n<td style=\"padding: 8px 0; vertical-align: top;\">{{$.collectDetails.formData.location}}</td>\n</tr>\n<tr>\n<td style=\"padding: 8px 24px 8px 0; vertical-align: top; color: #64748b;\">Manager</td>\n<td style=\"padding: 8px 0; vertical-align: top;\">{{$.collectDetails.formData.manager}}</td>\n</tr>\n</table>\n<p style=\"margin: 0; color: #64748b;\"><em>Please allow a short time for the new record to appear across all systems.</em></p>",
          "ownerId.$": "$.trigger.launchedBy.id",
          "title": "Onboarding request submitted"
        },
        "displayName": "Confirm submission",
        "nextStep": "End Success",
        "type": "action",
        "versionNumber": 1
      },
      "Get Manager": {
        "actionId": "sp:get-identities",
        "attributes": {
          "inputQuery": "attributes.uid:\"{{$.collectDetails.formData.manager}}\"",
          "searchBy": "searchQuery"
        },
        "displayName": "Get selected manager",
        "nextStep": "Get Operator",
        "type": "action",
        "versionNumber": 2
      },
      "Get Operator": {
        "actionId": "sp:get-identity",
        "attributes": {
          "id.$": "$.trigger.launchedBy.id"
        },
        "displayName": "Get requesting operator",
        "nextStep": "Notify Waiting For Approval",
        "type": "action",
        "versionNumber": 2
      },
      "Notify Waiting For Approval": {
        "actionId": "sp:interactive-message",
        "attributes": {
          "category": "INFO",
          "interactiveProcessId.$": "$.trigger.interactiveProcessId",
          "message": "<p style=\"margin: 0 0 16px 0; line-height: 1.5;\">The request for <strong>{{$.setConfiguration.displayName}}</strong> has been sent to <strong>{{$.getManager.identities[0].attributes.displayName}}</strong> for approval. Keep this window open, or return when you are notified of the decision.</p>",
          "ownerId.$": "$.trigger.launchedBy.id",
          "title": "Waiting for manager approval"
        },
        "displayName": "Waiting for manager approval",
        "nextStep": "Manager Approval",
        "type": "action",
        "versionNumber": 1
      },
      "Manager Approval": {
        "actionId": "sp:forms",
        "attributes": {
          "deadline": "2d",
          "formDefinitionId": "8d0bf25e-d40a-4ac4-97cf-0c50c243d6e3",
          "inputForForm_accountName.$": "$.setConfiguration.accountName",
          "inputForForm_displayName.$": "$.setConfiguration.displayName",
          "inputForForm_email.$": "$.collectDetails.formData.email",
          "inputForForm_firstName.$": "$.collectDetails.formData.firstName",
          "inputForForm_lastName.$": "$.collectDetails.formData.lastName",
          "inputForForm_location.$": "$.collectDetails.formData.location",
          "inputForForm_requestorName.$": "$.getOperator.attributes.displayName",
          "notificationBody": "Please review and approve a new hire directory record.",
          "notificationSubject": "Approve new hire: {{$.setConfiguration.displayName}}",
          "recipient.$": "$.getManager.identities[0].id",
          "reminder": "1h",
          "reminderBody": "A new hire approval is still waiting for your decision."
        },
        "displayName": "Manager approval",
        "nextStep": "Check Approved",
        "type": "action",
        "versionNumber": 1
      },
      "Check Approved": {
        "actionId": "sp:compare-boolean",
        "choiceList": [
          {
            "comparator": "BooleanEquals",
            "nextStep": "Create Account",
            "variableA.$": "$.managerApproval.formData.approvalDecision",
            "variableB": true
          }
        ],
        "defaultStep": "Show Approval Rejected",
        "displayName": "Approved?",
        "type": "choice"
      },
      "Show Approval Rejected": {
        "actionId": "sp:interactive-message",
        "attributes": {
          "category": "INFO",
          "interactiveProcessId.$": "$.trigger.interactiveProcessId",
          "message": "<p style=\"margin: 0 0 16px 0; line-height: 1.5;\">The manager declined this onboarding request. No directory record was created.</p>\n<table style=\"border-collapse: collapse; margin: 0 0 20px 0; width: 100%; max-width: 480px;\">\n<tr>\n<td style=\"padding: 8px 24px 8px 0; vertical-align: top; width: 120px; color: #64748b;\">Name</td>\n<td style=\"padding: 8px 0; vertical-align: top;\"><strong>{{$.setConfiguration.displayName}}</strong></td>\n</tr>\n<tr>\n<td style=\"padding: 8px 24px 8px 0; vertical-align: top; color: #64748b;\">Manager</td>\n<td style=\"padding: 8px 0; vertical-align: top;\">{{$.getManager.identities[0].attributes.displayName}}</td>\n</tr>\n<tr>\n<td style=\"padding: 8px 24px 8px 0; vertical-align: top; color: #64748b;\">Comments</td>\n<td style=\"padding: 8px 0; vertical-align: top;\">{{$.managerApproval.formData.approvalComments}}</td>\n</tr>\n</table>",
          "ownerId.$": "$.trigger.launchedBy.id",
          "title": "Onboarding declined"
        },
        "displayName": "Confirm declined",
        "nextStep": "End Success",
        "type": "action",
        "versionNumber": 1
      },
      "Check Manager Approval Required": {
        "actionId": "sp:compare-strings",
        "choiceList": [
          {
            "comparator": "StringEquals",
            "nextStep": "Get Manager",
            "variableA.$": "$.setConfiguration.managerApprovalRequired",
            "variableB": "true"
          }
        ],
        "defaultStep": "Create Account",
        "description": "Check the Set configuration variable Manager Approval Required. true sends the standalone approval form to the selected manager; any other value creates the account immediately.",
        "displayName": "Manager approval required?",
        "type": "choice"
      }
    }
  },
  "trigger": {
    "type": "EVENT",
    "attributes": {
      "filter.$": "$[?(@.workflowId == '5633af6d-7f3c-4e31-b7aa-76132327d60f')]",
      "id": "idn:interactive-process-launched",
      "integrationId": null
    }
  },
  "id": "5633af6d-7f3c-4e31-b7aa-76132327d60f",
  "name": "Identity Match & Onboard",
  "description": "Onboard new hires with a directory match check and manager approval before creating a record.",
  "executionCount": 3,
  "failureCount": 0,
  "enabled": false
}
