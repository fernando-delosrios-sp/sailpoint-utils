            "formElements": [
              {
                "config": {
                  "description": "<p style=\"text-align: center;\"><span style=\"font-size: 24pt;\"><strong>Identity Match &amp; Onboard</strong></span></p><p style=\"text-align: center;\"><span style=\"font-size: 18pt; color: #236fa1;\"><strong>Enter the new person's details</strong></span></p><p>We will search ISC for identities with a similar name or the same work email before creating an account. If no match is found, an account is created on the configured source.</p><p>Please provide the legal first and last name, work email, and the person's manager.</p>",
                  "label": "Introduction",
                  "showLabel": false
                },
                "elementType": "DESCRIPTION",
                "id": "2109847362510",
                "key": "",
                "validations": []
              },
              {
                "config": {
                  "default": "",
                  "description": "",
                  "helpText": "Legal given name as it should appear on the identity.",
                  "label": "First name",
                  "placeholder": "e.g. Jane",
                  "required": true
                },
                "elementType": "TEXT",
                "id": "1651301651952",
                "key": "firstName",
                "validations": [
                  {
                    "validationType": "REQUIRED"
                  }
                ]
              },
              {
                "config": {
                  "default": "",
                  "description": "",
                  "helpText": "Legal family name as it should appear on the identity.",
                  "label": "Last name",
                  "placeholder": "e.g. Smith",
                  "required": true
                },
                "elementType": "TEXT",
                "id": "729244046977",
                "key": "lastName",
                "validations": [
                  {
                    "validationType": "REQUIRED"
                  }
                ]
              },
              {
                "config": {
                  "default": "",
                  "description": "",
                  "helpText": "Corporate email address used for duplicate detection and account correlation.",
                  "label": "Work email",
                  "placeholder": "e.g. jane.smith@company.com",
                  "required": true
                },
                "elementType": "TEXT",
                "id": "3847291056382",
                "key": "email",
                "validations": [
                  {
                    "validationType": "REQUIRED"
                  }
                ]
              },
              {
                "config": {
                  "dataSource": {
                    "config": {
                      "indices": [
                        "identities"
                      ],
                      "label": "displayName",
                      "query": "isManager:true",
                      "sublabel": "email",
                      "value": "name"
                    },
                    "dataSourceType": "SEARCH_V2"
                  },
                  "forceSelect": true,
                  "helpText": "Select the new person's manager. Only identities flagged as managers are listed.",
