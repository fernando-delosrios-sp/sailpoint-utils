                "key": "newIdentity",
                "validations": []
              }
            ],
            "label": "Possible matches",
            "labelStyle": "h2",
            "showLabel": true
          },
          "validations": []
        }
      ],
      "formConditions": [
        {
          "ruleOperator": "AND",
          "rules": [
            {
              "sourceType": "ELEMENT",
              "source": "newIdentity",
              "operator": "EQ",
              "valueType": "BOOLEAN",
              "value": "true"
