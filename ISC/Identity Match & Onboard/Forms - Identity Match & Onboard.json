    "object": {
      "id": "cbd73c0c-ea5b-4bc4-8359-e733b2468a87",
      "name": "Identity Match & Onboard - Details input",
      "description": "Collect personal details for a new identity before duplicate check and account creation.",
      "owner": {
        "type": "IDENTITY",
        "id": "b41994df5dcf447483c8446436f29c79",
        "name": "Fernando de los Ríos"
      },
      "usedBy": [],
      "formInput": [],
      "formElements": [
        {
          "id": "1443979870514",
          "elementType": "SECTION",
          "config": {
            "alignment": "LEFT",
            "description": "",
            "formElements": [
              {
                "config": {
                  "description": "<p style=\"text-align: center;\"><span style=\"font-size: 24pt;\"><strong>Identity Match &amp; Onboard</strong></span></p><p style=\"text-align: center;\"><span style=\"font-size: 18pt; color: #236fa1;\"><strong>Enter the new person's details</strong></span></p><p>We will search ISC for identities with a similar name or the same work email before creating an account. If no match is found, an account is created on the configured source.</p><p>Please provide the legal first and last name, work email, and the person's manager.</p>",
                  "label": "Introduction",
                  "showLabel": false
                },
                "elementType": "DESCRIPTION",
                "id": "2109847362510",
                "key": "",
                "validations": []
              },
              {
                "config": {
                  "default": "",
                  "description": "",
                  "helpText": "Legal given name as it should appear on the identity.",
                  "label": "First name",
                  "placeholder": "e.g. Jane",
                  "required": true
                },
                "elementType": "TEXT",
                "id": "1651301651952",
                "key": "firstName",
                "validations": [
                  {
                    "validationType": "REQUIRED"
                  }
                ]
              },
              {
                "config": {
                  "default": "",
                  "description": "",
                  "helpText": "Legal family name as it should appear on the identity.",
                  "label": "Last name",
                  "placeholder": "e.g. Smith",
                  "required": true
                },
                "elementType": "TEXT",
                "id": "729244046977",
                "key": "lastName",
                "validations": [
                  {
                    "validationType": "REQUIRED"
                  }
                ]
              },
              {
                "config": {
                  "default": "",
                  "description": "",
                  "helpText": "Corporate email address used for duplicate detection and account correlation.",
                  "label": "Work email",
                  "placeholder": "e.g. jane.smith@company.com",
                  "required": true
                },
                "elementType": "TEXT",
                "id": "3847291056382",
                "key": "email",
                "validations": [
                  {
                    "validationType": "REQUIRED"
                  }
                ]
              },
              {
                "config": {
                  "dataSource": {
                    "config": {
                      "indices": [
                        "identities"
                      ],
                      "label": "displayName",
                      "query": "isManager:true",
                      "sublabel": "email",
                      "value": "name"
                    },
                    "dataSourceType": "SEARCH_V2"
                  },
                  "forceSelect": true,
                  "helpText": "Select the new person's manager. Only identities flagged as managers are listed.",
                  "label": "Manager",
                  "maximum": 1,
                  "placeholder": "Search managers...",
                  "required": true
                },
                "elementType": "SELECT",
                "id": "9173846502913",
                "key": "manager",
                "validations": [
                  {
                    "validationType": "DATA_SOURCE"
                  },
                  {
                    "validationType": "REQUIRED"
                  }
                ]
              },
              {
                "config": {
                  "description": "<p><strong>What happens next?</strong></p><ol><li>ISC searches for identities with a similar name or matching email.</li><li>If matches are found, you review them and confirm whether this is a new person.</li><li>If no match applies, a source account is created with a generated username.</li></ol>",
                  "label": "Next steps",
                  "showLabel": false
                },
                "elementType": "DESCRIPTION",
                "id": "5839201746382",
                "key": "",
                "validations": []
              }
            ],
            "label": "Personal details",
            "labelStyle": "h2",
            "showLabel": true
          },
          "validations": []
        }
      ],
      "formConditions": []
    }
