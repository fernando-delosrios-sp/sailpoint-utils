          ],
          "effects": [
            {
              "config": {
                "element": "469892241994"
              },
              "effectType": "HIDE"
            },
            {
              "config": {
                "element": "5821938472610"
              },
              "effectType": "HIDE"
            },
            {
              "config": {
                "element": "469892241994"
              },
              "effectType": "OPTIONAL"
            }
          ]
        },
        {
          "ruleOperator": "AND",
          "rules": [
            {
              "sourceType": "ELEMENT",
              "source": "newIdentity",
              "operator": "EQ",
              "valueType": "BOOLEAN",
              "value": "false"
            }
          ],
          "effects": [
            {
              "config": {
                "element": "469892241994"
              },
              "effectType": "REQUIRE"
            }
          ]
        }
