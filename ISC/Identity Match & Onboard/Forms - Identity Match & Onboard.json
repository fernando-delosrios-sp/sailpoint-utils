      "description": "Review possible duplicate identities and confirm whether to create a new account.",
      "owner": {
        "type": "IDENTITY",
        "id": "b41994df5dcf447483c8446436f29c79",
        "name": "Fernando de los Ríos"
      },
      "usedBy": [],
