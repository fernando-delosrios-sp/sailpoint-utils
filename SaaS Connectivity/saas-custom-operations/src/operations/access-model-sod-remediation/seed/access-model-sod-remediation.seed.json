{
    "description": "Access model SoD remediation — policy owner selects side to remove from role or access profile.",
    "formInput": [
        { "id": "accessItemId", "type": "STRING", "label": "Access Item ID", "description": "Role or access profile under review" },
        { "id": "accessItemType", "type": "STRING", "label": "Access Item Type", "description": "ROLE or ACCESS_PROFILE" },
        { "id": "accessItemTypeTagHtml", "type": "STRING", "label": "Access Item Type Tag HTML", "description": "Pre-rendered type pill HTML for access item display" },
        { "id": "remediationSectionLabel", "type": "STRING", "label": "Remediation Section Label", "description": "Role Composition Remediation or Access Profile Remediation" },
        { "id": "accessItemName", "type": "STRING", "label": "Access Item Name", "description": "Display name of the access item" },
        { "id": "policyId", "type": "STRING", "label": "Policy ID", "description": "Violated SoD policy id" },
        { "id": "policyName", "type": "STRING", "label": "Policy Name", "description": "Violated SoD policy name" },
        { "id": "situationSummaryHtml", "type": "STRING", "label": "Situation Summary", "description": "HTML context panel for the violation situation" },
        { "id": "parentRequestId", "type": "STRING", "label": "Parent Request ID", "description": "Scan invoke requestId that launched this form (workflow correlation key)" },
        { "id": "groupAIds", "type": "STRING", "label": "Group A Entitlement IDs", "description": "JSON array of entitlement ids on group A side (launch-time workflow key)" },
        { "id": "groupBIds", "type": "STRING", "label": "Group B Entitlement IDs", "description": "JSON array of entitlement ids on group B side (launch-time workflow key)" },
        { "id": "groupColumnsHtmlPlain", "type": "STRING", "label": "Group Columns HTML (Plain)", "description": "Side-by-side plain group columns before side selection" },
        { "id": "groupColumnsHtmlWhenGroupARemoved", "type": "STRING", "label": "Group Columns HTML (Group A Removed)", "description": "Side-by-side columns when group A is selected for removal" },
        { "id": "groupColumnsHtmlWhenGroupBRemoved", "type": "STRING", "label": "Group Columns HTML (Group B Removed)", "description": "Side-by-side columns when group B is selected for removal" }
    ],
    "formElements": [
        {
            "id": "ctx-section",
            "elementType": "SECTION",
            "config": {
                "alignment": "LEFT",
                "description": "",
                "label": "Situation",
                "labelStyle": "h2",
                "showLabel": true,
                "formElements": [
                    {
                        "id": "ctx-summary",
                        "elementType": "DESCRIPTION",
                        "key": "",
                        "config": {
                            "label": "Situation",
                            "showLabel": false,
                            "description": "{{$.form.input.situationSummaryHtml}}"
                        },
                        "validations": []
                    }
                ]
            },
            "validations": []
        },
        {
            "id": "correct-section",
            "elementType": "SECTION",
            "config": {
                "alignment": "LEFT",
                "description": "Select the side whose entitlements should be removed from this access item definition. Green = kept, red = removed.",
                "label": "Remediation",
                "labelStyle": "h2",
                "showLabel": false,
                "formElements": [
                    {
                        "id": "remediation-section-heading",
                        "elementType": "DESCRIPTION",
                        "key": "",
                        "config": {
                            "label": "Remediation section heading",
                            "showLabel": false,
                            "description": "<h2 style='margin:0 0 12px; font-size:1.25rem; font-weight:600;'>{{$.form.input.remediationSectionLabel}}</h2>"
                        },
                        "validations": []
                    },
                    {
                        "id": "remediation-side-select",
                        "elementType": "SELECT",
                        "key": "remediationSide",
                        "config": {
                            "label": "Side to remediate",
                            "required": true,
                            "forceSelect": false,
                            "maximum": 1,
                            "dataSource": {
                                "dataSourceType": "STATIC",
                                "config": {
                                    "options": [
                                        { "label": "Group A", "value": "groupA", "sublabel": "Remove group A entitlements" },
                                        { "label": "Group B", "value": "groupB", "sublabel": "Remove group B entitlements" }
                                    ]
                                }
                            }
                        },
                        "validations": [{ "validationType": "REQUIRED" }, { "validationType": "DATA_SOURCE" }]
                    },
                    {
                        "id": "group-columns-preview-intro",
                        "elementType": "DESCRIPTION",
                        "key": "",
                        "config": {
                            "label": "Entitlement comparison preview",
                            "showLabel": false,
                            "description": "<p><em>Compare both outcomes below, then select the side to remove above. Green = kept, red = removed.</em></p>"
                        },
                        "validations": []
                    },
                    {
                        "id": "group-columns-plain",
                        "elementType": "DESCRIPTION",
                        "key": "",
                        "config": {
                            "label": "Entitlement comparison preview",
                            "showLabel": false,
                            "description": "{{$.form.input.groupColumnsHtmlPlain}}"
                        },
                        "validations": []
                    },
                    {
                        "id": "group-columns-when-a-removed",
                        "elementType": "DESCRIPTION",
                        "key": "",
                        "config": {
                            "label": "Entitlement comparison preview",
                            "showLabel": false,
                            "description": "{{$.form.input.groupColumnsHtmlWhenGroupARemoved}}"
                        },
                        "validations": []
                    },
                    {
                        "id": "group-columns-when-b-removed",
                        "elementType": "DESCRIPTION",
                        "key": "",
                        "config": {
                            "label": "Entitlement comparison preview",
                            "showLabel": false,
                            "description": "{{$.form.input.groupColumnsHtmlWhenGroupBRemoved}}"
                        },
                        "validations": []
                    },
                    {
                        "id": "comments",
                        "elementType": "TEXTAREA",
                        "key": "comments",
                        "config": {
                            "label": "Comments",
                            "required": false,
                            "placeholder": "Optional notes for the remediation workflow"
                        },
                        "validations": []
                    }
                ]
            },
            "validations": []
        }
    ],
    "formConditions": [
        {
            "ruleOperator": "AND",
            "rules": [
                {
                    "sourceType": "ELEMENT",
                    "source": "remediationSide",
                    "operator": "EM",
                    "valueType": "STRING",
                    "value": ""
                }
            ],
            "effects": [{ "effectType": "SHOW", "config": { "element": "group-columns-plain" } }]
        },
        {
            "ruleOperator": "AND",
            "rules": [
                {
                    "sourceType": "ELEMENT",
                    "source": "remediationSide",
                    "operator": "EQ",
                    "valueType": "STRING",
                    "value": "Group A"
                }
            ],
            "effects": [{ "effectType": "SHOW", "config": { "element": "group-columns-when-a-removed" } }]
        },
        {
            "ruleOperator": "AND",
            "rules": [
                {
                    "sourceType": "ELEMENT",
                    "source": "remediationSide",
                    "operator": "EQ",
                    "valueType": "STRING",
                    "value": "Group B"
                }
            ],
            "effects": [{ "effectType": "SHOW", "config": { "element": "group-columns-when-b-removed" } }]
        }
    ]
}
