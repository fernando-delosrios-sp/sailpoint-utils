{
  "name": "saas-custom-operations",
  "version": "0.3.0",
  "main": "dist/index.js",
  "scripts": {
    "clean": "shx rm -rf ./dist ./.dev-dist",
    "prebuild": "shx rm -rf ./dist && npm run codegen:schemas",
    "build": "npx ncc build ./src/index.ts -o ./dist -m -C",
    "codegen:schemas": "tsx scripts/generate-operation-schemas.ts",
    "dev": "cross-env NODE_OPTIONS=--enable-source-maps spcx run .dev-dist/index.js",
    "debug": "spcx run .dev-dist/index.js",
    "prettier": "npx prettier --write .",
    "templates": "tsx scripts/generate-templates.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
    "test": "vitest run --coverage",
    "call:op": "tsx scripts/call-op.ts",
    "prepack-zip": "npm ci && npm run build",
    "pack-zip": "spcx package"
  },
  "private": true,
  "dependencies": {
    "@sailpoint/connector-sdk": "^1.0.0",
    "sailpoint-api-client": "^2.1.10"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vercel/ncc": "^0.38.1",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "7.0.3",
    "prettier": "^2.3.2",
    "shx": "^0.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "prettier": {
    "printWidth": 120,
    "trailingComma": "es5",
    "tabWidth": 4,
    "semi": false,
    "singleQuote": true
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
