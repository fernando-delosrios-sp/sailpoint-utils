import express, { type Request, type Response } from "express";

const app = express();

app.use(express.json());

// ---- Global Variable for Access Token ----
// Note: In a multi-user or high-concurrency production environment, storing the token
// globally can lead to race conditions. Consider passing the token through context.
let access_token: string | null = null;

// ---- Interfaces ----

interface SourceRef {
    id: string;
    name?: string;
}

interface EntitlementRef {
    type: "ENTITLEMENT";
    id: string;
    name?: string;
    source?: SourceRef; // Holds the source details (name & id) if resolved
}

interface AccessRef {
    type: "ENTITLEMENT";
    id: string;
    name?: string;
    source?: SourceRef; // Holds the source details if resolved
}

interface AccessProfileRef {
    id: string;
    name?: string;
    type: "ACCESS_PROFILE";
    entitlements?: EntitlementRef[];
}

interface AccessModelAttributeValue {
    name: string;
    status: string;
    value: string;
}

interface AccessModelAttribute {
    description?: string;
    key: string;
    multiselect?: boolean;
    name?: string;
    objectTypes?: string[];
    status?: string;
    type?: string;
    values?: AccessModelAttributeValue[];
}

interface AccessModelMetadata {
    attributes?: AccessModelAttribute[];
}

interface GetRequestedItems {
  id?: string;
  type?: "ACCESS_PROFILE" | "ENTITLEMENT" | "ROLE";
  accessModelMetadata?: AccessModelMetadata;
  accessProfiles?: AccessProfileRef[];
  entitlements?: EntitlementRef[];
  [key: string]: unknown;
}

interface ViolatedPolicy {
    type: string;
    id: string;
    name: string;
}

interface ViolationCheckResult {
    message?: {
        locale: string;
        localeOrigin: string;
        text: string;
    };
    violatedPolicies?: ViolatedPolicy[] | null;
}

interface SodViolationContext {
    state: string;
    violationCheckResult?: ViolationCheckResult;
    uuid?: string;
}

interface AccessRequestItem {
    name: string;
    id: string;
    sodViolationContext?: SodViolationContext;
    [key: string]: unknown;
}

interface GetAccessRequestStatus {
    type?: "ACCESS_PROFILE" | "ENTITLEMENT" | "ROLE";
    accessRequestId?: string;
    requestedFor?: { id: string; name?: string; type?: string };
    sodViolationContext?: SodViolationContext;
    [key: string]: unknown;
}

interface OpenAccessRequestItem {
    id: string;
    name?: string;
    type: string;
    state?: string;
    accessRequestId?: string;
    requestedFor?: { id: string; name?: string; type?: string };
    [key: string]: unknown;
}

interface RoleDetail {
    id: string;
    name?: string;
    entitlements?: EntitlementRef[];
    accessProfiles?: AccessProfileRef[];
    [key: string]: unknown;
}

interface IdentityWithNewAccess {
    identityId: string;
    accessRefs: AccessRef[];
}

interface ViolationPrediction {
    identityId?: string;
    violationContexts?: unknown[];
    message?: {
        locale: string;
        localeOrigin: string;
        text: string;
    };
    [key: string]: unknown;
}

interface XdrData {
    attributes?: {
        department?: string | null;
        displayName?: string | null;
        jobTitle?: string | null;
        location?: string | null;
        manager?: string | null;
    };
    firstDetectionDate?: string;
    id?: string;
    identityId?: string;
    ignoreDate?: string | null;
    ignored?: boolean;
    latestDetectionDate?: string;
    score?: number;
    type?: string;
    unignoreDate?: string | null;
    unignoreType?: string | null;
}

interface AccessRequestStatusPayload {
    getAccessRequestStatus?: GetAccessRequestStatus | null;
    getRequestedItems?: GetRequestedItems | null;
    getXdrData?: XdrData | null;
}

// This interface combines the details of an Access Profile from the V3 API
interface AccessProfileDetail {
    id: string;
    name?: string;
    source?: SourceRef;
    entitlements?: EntitlementRef[];
    [key: string]: unknown;
}

interface SodPolicyCriteriaItem {
    type: "ENTITLEMENT";
    id: string;
    name?: string;
}

interface SodPolicyCriteriaSide {
    name?: string;
    criteriaList: SodPolicyCriteriaItem[];
}

interface SodPolicy {
    id: string;
    name: string;
    conflictingAccessCriteria?: {
        leftCriteria: SodPolicyCriteriaSide;
        rightCriteria: SodPolicyCriteriaSide;
    } | null;
    [key: string]: unknown;
}

interface DetectedViolation {
    policyId: string;
    policyName: string;
    matchedLeft: string[];
    matchedRight: string[];
}

interface CheckSodPendingRequestBody {
    identityId: string;
}

interface EntitlementDetail {
    id: string;
    name?: string;
    source?: SourceRef;
    [key: string]: unknown;
}

interface RecommendationResponse {
  request: RecommendationRequestItem;
  recommendation: "YES" | "NO" | "MAYBE";
  interpretations: string[];
  translationMessages: unknown[];
  recommenderCalculations: unknown;
}

interface RecommendationApiResponse {
  responses: RecommendationResponse[];
}

interface RecommendationRequestItem {
  identityId: string;
  item: {
    id: string;
    type: "ACCESS_PROFILE" | "ENTITLEMENT" | "ROLE";
  };
}

interface RecommendationRequestBody {
  requests: RecommendationRequestItem[];
  excludeInterpretations?: string;
  includeTranslationMessages?: string;
  includeDebugInformation?: string;
  prescribeMode?: string;
}

function buildRecommendationRequest(
  getAccessRequestStatus: GetAccessRequestStatus | null | undefined,
  getRequestedItems: GetRequestedItems | null | undefined
): RecommendationRequestItem | null {
  const identityId = getAccessRequestStatus?.requestedFor?.id;
  const itemId = getRequestedItems?.id;
  const itemType = getAccessRequestStatus?.type;

  if (!identityId || !itemId || !itemType) {
    return null;
  }

  return {
    identityId,
    item: { id: itemId, type: itemType },
  };
}

async function fetchRecommendations(
  apiBaseUrl: string,
  requests: RecommendationRequestItem[],
  token: string
): Promise<RecommendationResponse[] | null> {
  const url = `${apiBaseUrl}/recommendations/v1/request`;

  const body: RecommendationRequestBody = {
    requests,
    excludeInterpretations: "false",
    includeTranslationMessages: "false",
    includeDebugInformation: "false",
    prescribeMode: "false",
  };

  console.log("→ Request-URL:", url);
  console.log("→ Body:", JSON.stringify(body, null, 2));

  const response = await fetch(url, {
    method: "POST",
    headers: {
      Authorization: `Bearer ${token}`,
      "Content-Type": "application/json",
      Accept: "application/json",
      "X-SailPoint-Experimental": "true",
    },
    body: JSON.stringify(body),
  });

  console.log("← Status:", response.status);

  if (!response.ok) {
    const errorBody = await response.text();
    console.error(`Fehler bei Recommendations: ${response.status} - ${errorBody}`);
    return null;
  }

  const result = (await response.json()) as RecommendationApiResponse;
  console.log("← Antwort:", JSON.stringify(result, null, 2));

  return result.responses;
}
/**
 * Fetches detailed metadata for a single entitlement.
 * Useful for determining which Source is associated with the entitlement.
 */
async function fetchEntitlementDetail(
    apiBaseUrl: string,
    entitlementId: string,
    token: string
): Promise<EntitlementDetail | null> {
    const url = `${apiBaseUrl}/entitlements/v2/${entitlementId}`;
    const response = await fetch(url, {
        headers: {
            Authorization: `Bearer ${token}`,
            Accept: "application/json",
        },
    });

    if (!response.ok) {
        console.error(`Error loading Entitlement ${entitlementId}: ${response.status}`);
        return null;
    }
    return (await response.json()) as EntitlementDetail;
}

/**
 * Enriches Entitlement References by fetching details if they lack source information.
 */
async function enrichEntitlementsWithSource(
    apiBaseUrl: string,
    entitlements: EntitlementRef[],
    token: string
): Promise<EntitlementRef[]> {
    return Promise.all(
        entitlements.map(async (ent) => {
            if (ent.source) return ent; // Already has source info, skip fetching
            const detail = await fetchEntitlementDetail(apiBaseUrl, ent.id, token);
            return {
                ...ent,
                ...(detail?.source !== undefined && { source: detail.source }),
            };
        })
    );
}

/**
 * Fetches entitlements for a given Access Profile using an optimized single API call.
 * This function now hits the v3 endpoint to get the profile detail, which includes both the source and its entitlements.
 */
async function fetchAccessProfileEntitlements(
    apiBaseUrl: string,
    accessProfileId: string,
    token: string
): Promise<EntitlementRef[]> {
    const url = `${apiBaseUrl}/v3/access-profiles/${accessProfileId}`;
    const response = await fetch(url, {
        headers: {
            Authorization: `Bearer ${token}`,
            Accept: "application/json",
        },
    });

    if (!response.ok) {
        const errorBody = await response.text();
        console.error(
            `Error loading entitlements for Access Profile ${accessProfileId}: ${response.status} - ${errorBody}`
        );
        return [];
    }

    const profileDetail = (await response.json()) as AccessProfileDetail;
    const entitlements = profileDetail.entitlements ?? [];
    const source = profileDetail.source;

    // If the source exists, map it to all child entitlements that don't already have one.
    if (source) {
        return entitlements.map((ent) => ({
            ...ent,
            source: ent.source ?? source, // Assign parent source if entitlement doesn't have its own
        }));
    }

    return entitlements;
}

/**
 * Evaluates a set of SoD Policies against a flat list of entitlement IDs.
 * Performs a localized "left vs. right" cross-reference comparison.
 * Returns a list of detected violations, or an empty array [] if none are found.
 */
function checkPoliciesAgainstEntitlements(
  policies: SodPolicy[],
  entitlementIds: string[]
): DetectedViolation[] { // ✅ Rückgabetyp auf exakt DetectedViolation[] geändert (kein 'string[]' mehr nötig)
  const entitlementIdSet = new Set(entitlementIds);
  const violations: DetectedViolation[] = [];

  console.log("=== SOD-Policy-Prüfung ===");
  console.log("Zu prüfende Entitlement-IDs:", entitlementIds);

  for (const policy of policies) {
    const criteria = policy.conflictingAccessCriteria;
    if (!criteria) continue;

    const matchedLeft = criteria.leftCriteria.criteriaList
      .filter((c) => entitlementIdSet.has(c.id))
      .map((c) => c.id);

    const matchedRight = criteria.rightCriteria.criteriaList
      .filter((c) => entitlementIdSet.has(c.id))
      .map((c) => c.id);

    console.log(`\nPolicy: ${policy.name} (${policy.id})`);
    console.log("  leftCriteria IDs: ", criteria.leftCriteria.criteriaList.map((c) => c.id));
    console.log("  rightCriteria IDs:", criteria.rightCriteria.criteriaList.map((c) => c.id));
    console.log("  matchedLeft:      ", matchedLeft);
    console.log("  matchedRight:     ", matchedRight);

    if (matchedLeft.length > 0 && matchedRight.length > 0) {
      console.log("  ⚠️  VERLETZUNG erkannt!");
      violations.push({
        policyId: policy.id,
        policyName: policy.name,
        matchedLeft,
        matchedRight,
      });
    } else {
      console.log("  ✓ keine Verletzung");
    }
  }

  console.log(`\n=== Ergebnis: ${violations.length} Verletzung(en) gefunden ===\n`);
  
  // ✅ Geändert von: violations.length > 0 ? violations : ["N/A"]
  return violations; 
}


/**
 * Fetches all active SoD policies configured on the SailPoint tenant
 */
async function fetchSodPolicies(
    apiBaseUrl: string,
    token: string
): Promise<SodPolicy[]> {
    const url = `${apiBaseUrl}/beta/sod-policies`;
    const response = await fetch(url, {
        headers: {
            Authorization: `Bearer ${token}`,
            Accept: "application/json",
        },
    });

    if (!response.ok) {
        const errorBody = await response.text();
        console.error(`Error loading SOD Policies: ${response.status} - ${errorBody}`);
        return [];
    }
    return (await response.json()) as SodPolicy[];
}

/**
 * Retrieves access requests for an identity that are currently in 'EXECUTING' status.
 * Used to check for concurrent requested access that hasn't finished provisioning.
 */
async function fetchOpenAccessRequests(
    apiBaseUrl: string,
    requestedForId: string,
    currentAccessRequestId: string | undefined,
    token: string
): Promise<OpenAccessRequestItem[]> {
    const url = `${apiBaseUrl}/v3/access-request-status?requested-for=${requestedForId}`;
    const response = await fetch(url, {
        headers: {
            Authorization: `Bearer ${token}`,
            Accept: "application/json",
        },
    });

    if (!response.ok) {
        const errorBody = await response.text();
        console.error(`Error loading Access Requests: ${response.status} - ${errorBody}`);
        return [];
    }
    const items = (await response.json()) as OpenAccessRequestItem[];
    return items.filter(
        (item) =>
            item.state === "EXECUTING" &&
            item.accessRequestId !== currentAccessRequestId
    );
}

/**
 * Fetches a single role's detail structure by ID
 */
async function fetchRoleDetail(
    apiBaseUrl: string,
    roleId: string,
    token: string
): Promise<RoleDetail | null> {
    const url = `${apiBaseUrl}/v3/roles/${roleId}`;
    const response = await fetch(url, {
        headers: {
            Authorization: `Bearer ${token}`,
            Accept: "application/json",
        },
    });

    if (!response.ok) {
        console.error(`Error loading Role ${roleId}: ${response.status}`);
        return null;
    }
    return (await response.json()) as RoleDetail;
}

/**
 * Resolves the underlying entitlements for an incoming item based on its type (Entitlement, Access Profile, or Role)
 */
async function fetchEntitlementsForItem(
    apiBaseUrl: string,
    item: OpenAccessRequestItem,
    token: string,
    addEntitlement: (ent: EntitlementRef | undefined) => void
): Promise<void> {
    switch (item.type) {
        case "ENTITLEMENT": {
            // Detail-Informationen laden, um an die Source zu gelangen
            const detail = await fetchEntitlementDetail(apiBaseUrl, item.id, token);

            if (detail) {
                addEntitlement({
                    type: "ENTITLEMENT",
                    id: detail.id,
                    // Falls name im Detail fehlt, greifen wir auf das item zurück
                    ...((detail.name ?? item.name) !== undefined && { name: detail.name ?? item.name }),
                    ...(detail.source !== undefined && { source: detail.source })
                });
            } else {
                // Fallback, falls der API-Call fehlschlägt
                addEntitlement({
                    type: "ENTITLEMENT",
                    id: item.id,
                    ...(item.name !== undefined && { name: item.name })
                });
            }
            break;
        }

        case "ACCESS_PROFILE": {
            const entitlements = await fetchAccessProfileEntitlements(apiBaseUrl, item.id, token);
            entitlements.forEach(addEntitlement);
            break;
        }
        case "ROLE": {
            const role = await fetchRoleDetail(apiBaseUrl, item.id, token);
            if (!role) break;

            // Handle entitlements directly on the role
            if (role.entitlements) {
                const enriched = await enrichEntitlementsWithSource(apiBaseUrl, role.entitlements, token);
                enriched.forEach(addEntitlement);
            }

            // Handle entitlements from access profiles within the role
            const accessProfiles = role.accessProfiles ?? [];
            const entitlementLists = await Promise.all(
                accessProfiles.map((profile) =>
                    fetchAccessProfileEntitlements(apiBaseUrl, profile.id, token)
                )
            );
            entitlementLists.flat().forEach(addEntitlement);
            break;
        }
        default:
            console.log(`Skipping unknown item type: ${item.type} (${item.id})`);
    }
}

/**
 * Gathers and flattens all entitlements contained in pending ("EXECUTING") access requests.
 */
async function extractAllOpenEntitlements(
    apiBaseUrl: string,
    requestedForId: string,
    currentAccessRequestId: string | undefined,
    token: string
): Promise<AccessRef[]> {
    const refs: AccessRef[] = [];
    const seenIds = new Set<string>();

    const addEntitlement = (ent: EntitlementRef | undefined) => {
        if (!ent?.id || seenIds.has(ent.id)) return;
        seenIds.add(ent.id);
        refs.push({
            type: "ENTITLEMENT",
            id: ent.id,
            ...(ent.name !== undefined && { name: ent.name }),
            // ✅ CORRECTED: Pass the source property through to the final AccessRef array
            ...(ent.source !== undefined && { source: ent.source }),
        });
    };

    const openItems = await fetchOpenAccessRequests(
        apiBaseUrl,
        requestedForId,
        currentAccessRequestId,
        token
    );

    for (const item of openItems) {
        await fetchEntitlementsForItem(apiBaseUrl, item, token, addEntitlement);
    }
    return refs;
}

/**
 * Extracts the raw Bearer JWT from the request Authorization Header
 */
function extractAccessToken(req: Request): string | null {
    const authHeader = req.headers["authorization"];
    if (!authHeader) return null;
    const [scheme, token] = authHeader.split(" ");
    if (scheme?.toLowerCase() !== "bearer" || !token) return null;
    return token;
}

/**
 * Retrieves the metadata attribute value for the 'iscRisk' attribute
 */
function extractIscRiskName(
    getRequestedItems: GetRequestedItems | null | undefined
): string {
    const attributes = getRequestedItems?.accessModelMetadata?.attributes;
    if (!attributes) {
        return "N/A";
    }
    const iscRiskAttribute = attributes.find((attr) => attr.key === "iscRisk");
    const riskName = iscRiskAttribute?.values?.[0]?.name;
    return riskName ?? "N/A";
}

/**
 * Extracts and maps policy names to an array with an "N/A" fallback
 */
function extractViolatedPolicyNames(
    violatedPolicies: ViolatedPolicy[] | null | undefined
): string[] {
    if (!violatedPolicies || violatedPolicies.length === 0) {
        return ["N/A"];
    }
    return violatedPolicies.map((p) => p.name);
}

/**
 * Executes a predictive check via SailPoint beta endpoint to determine if access causes SoD violation.
 */
async function predictSodViolations(
    apiBaseUrl: string,
    identityId: string,
    accessRefs: AccessRef[],
    token: string
): Promise<ViolationPrediction | null> {
    const url = `${apiBaseUrl}/sod-violations/v1/predict`;
    const body: IdentityWithNewAccess = {
        identityId,
        accessRefs,
    };

    console.log("→ Request-URL:", url);
    console.log("→ Body:", JSON.stringify(body, null, 2));

    const response = await fetch(url, {
        method: "POST",
        headers: {
            Authorization: `Bearer ${token}`,
            "Content-Type": "application/json",
            Accept: "application/json",
        },
        body: JSON.stringify(body),
    });

    console.log("← Status:", response.status);
    if (!response.ok) {
        const errorBody = await response.text();
        console.error(`Error in SOD Prediction: ${response.status} - ${errorBody}`);
        return null;
    }
    return (await response.json()) as ViolationPrediction;
}

/**
 * API ENDPOINT: Receives incoming basic SOD violation context webhooks
 */
app.post("/sod-violations", (req: Request, res: Response) => {
    access_token = extractAccessToken(req);
    const body = req.body as AccessRequestItem[];
    const firstItem = Array.isArray(body) ? body[0] : undefined;
    const policies =
        firstItem?.sodViolationContext?.violationCheckResult?.violatedPolicies;
    const violatedPolicyNames = extractViolatedPolicyNames(policies);

    res.json({
        violatedPolicies: violatedPolicyNames,
        receivedToken: access_token,
    });
});

/**
 * Decodes the JWT header from the token to automatically discover the tenant's API Base URL.
 */
function extractApiBaseUrl(token: string): string | null {
    try {
        const [headerB64] = token.split(".");
        if (!headerB64) return null;
        const headerJson = Buffer.from(headerB64, "base64url").toString("utf-8");
        const header = JSON.parse(headerJson) as { jku?: string };
        if (!header.jku) return null;

        // jku looks like: https://<tenant>.api.identitynow-demo.com/oauth/jwks
        const jkuUrl = new URL(header.jku);
        return `${jkuUrl.protocol}//${jkuUrl.host}`;
    } catch {
        return null;
    }
}

/**
 * Processes incoming role items, resolves profiles, child entitlements, and enriches source metadata.
 */
async function extractAccessRefs(
  getAccessRequestStatus: GetAccessRequestStatus | null | undefined,
  getRequestedItems: GetRequestedItems | null | undefined,
  token: string | null
): Promise<AccessRef[]> {
  
  // 1. Grundlegende Sicherheitsprüfung (token und getRequestedItems müssen da sein)
  if (!getAccessRequestStatus || !getRequestedItems || !token) {
    return [];
  }

  const refs: AccessRef[] = [];
  const seenIds = new Set<string>();

  // Unser robuster Helper, der Source & Name beim Hinzufügen erhält
  const addEntitlement = (ent: EntitlementRef | undefined) => {
    if (!ent?.id || seenIds.has(ent.id)) return;
    seenIds.add(ent.id);
    refs.push({
      type: "ENTITLEMENT",
      id: ent.id,
      ...(ent.name !== undefined && { name: ent.name }),
      ...(ent.source !== undefined && { source: ent.source }),
    });
  };

  const apiBaseUrl = extractApiBaseUrl(token);
  if (!apiBaseUrl) {
    console.error("Could not extract API base URL from token.");
    return refs;
  }

  const requestType = getAccessRequestStatus.type;

  // ==========================================
  // FALL A: Der Request ist ein "ENTITLEMENT"
  // ==========================================
  if (requestType === "ENTITLEMENT") {
    if (getRequestedItems.entitlements && getRequestedItems.entitlements.length > 0) {
      // Direkte Entitlements mit Source anreichern
      const enriched = await enrichEntitlementsWithSource(
        apiBaseUrl,
        getRequestedItems.entitlements,
        token
      );
      enriched.forEach(addEntitlement);
    }
  }

  // ==========================================
  // FALL B: Der Request ist ein "ACCESS_PROFILE"
  // ==========================================
  else if (requestType === "ACCESS_PROFILE") {
    const accessProfiles = getRequestedItems.accessProfiles ?? [];
    if (accessProfiles.length > 0) {
      // Entitlements aus dem Access Profile laden (inkl. Source des APs)
      const entitlementLists = await Promise.all(
        accessProfiles.map((profile) =>
          fetchAccessProfileEntitlements(apiBaseUrl, profile.id, token)
        )
      );
      entitlementLists.flat().forEach(addEntitlement);
    }
  }

  // ==========================================
  // FALL C: Der Request ist eine "ROLE" (Beinhaltet APs & direkte Entitlements)
  // ==========================================
  else if (requestType === "ROLE") {
    // 1. Direkt an der Rolle hängende Entitlements anreichern
    if (getRequestedItems.entitlements && getRequestedItems.entitlements.length > 0) {
      const enriched = await enrichEntitlementsWithSource(
        apiBaseUrl,
        getRequestedItems.entitlements,
        token
      );
      enriched.forEach(addEntitlement);
    }

    // 2. Entitlements aus den verknüpften Access Profiles der Rolle laden
    const accessProfiles = getRequestedItems.accessProfiles ?? [];
    if (accessProfiles.length > 0) {
      const entitlementLists = await Promise.all(
        accessProfiles.map((profile) =>
          fetchAccessProfileEntitlements(apiBaseUrl, profile.id, token)
        )
      );
      entitlementLists.flat().forEach(addEntitlement);
    }
  }

  return refs;
}


/**
 * Formats an identity risk/criticality score from decimal to percentage.
 */
function extractXdrScore(xdrData: XdrData | null | undefined): string {
    if (!xdrData || xdrData.score === undefined || xdrData.score === null) {
        return "N/A";
    }
    const percentage = xdrData.score * 100;
    return `${percentage.toFixed(2)}%`;
}

/**
 * API ENDPOINT: Event Trigger target route for full Access Request State updates
 */
app.post("/access-request-status", async (req: Request, res: Response) => {
    access_token = extractAccessToken(req);
    const body = req.body as AccessRequestStatusPayload;

    const getAccessRequestStatus = body?.getAccessRequestStatus ?? null;
    const getRequestedItems = body?.getRequestedItems ?? null;
    const getXdrData = body?.getXdrData ?? null;

    const policies =
        getAccessRequestStatus?.sodViolationContext?.violationCheckResult
            ?.violatedPolicies;
    const violatedPolicyNames = extractViolatedPolicyNames(policies);
    const xdrScore = extractXdrScore(getXdrData);
    const iscRiskName = extractIscRiskName(getRequestedItems);

    const accessRefs = await extractAccessRefs(
        getAccessRequestStatus,
        getRequestedItems,
        access_token
    );

    const requestedForId = getAccessRequestStatus?.requestedFor?.id;
    const currentAccessRequestId = getAccessRequestStatus?.accessRequestId;
    const apiBaseUrl = access_token ? extractApiBaseUrl(access_token) : null;

    const allOpenEntitlements =
        requestedForId && apiBaseUrl && access_token
            ? await extractAllOpenEntitlements(
                apiBaseUrl,
                requestedForId,
                currentAccessRequestId,
                access_token
            )
            : [];

    const identityId = getAccessRequestStatus?.requestedFor?.id;
    const sodPrediction =
        identityId && apiBaseUrl && access_token
            ? await predictSodViolations(apiBaseUrl, identityId, accessRefs, access_token)
            : null;

    const entitlementIds = accessRefs.map((ref) => ref.id);
    const sodPolicies =
        apiBaseUrl && access_token
            ? await fetchSodPolicies(apiBaseUrl, access_token)
            : [];

    const internalViolations = checkPoliciesAgainstEntitlements(
        sodPolicies,
        entitlementIds
    );

    const recommendationRequest = buildRecommendationRequest(
  getAccessRequestStatus,
  getRequestedItems
);

const rawRecommendations =
  recommendationRequest && apiBaseUrl && access_token
    ? await fetchRecommendations(apiBaseUrl, [recommendationRequest], access_token)
    : null;

const recommendations =
  rawRecommendations && rawRecommendations.length > 0
    ? rawRecommendations
    : [{ recommendation: "N/A" as const, interpretations: ["N/A"] }];

  

    res.json({
        getAccessRequestStatus,
        getRequestedItems,
        getXdrData,
        violatedPolicyNames,
        xdrScore,
        iscRiskName,
        accessRefs, // This will now contain the 'source' object where available
        allOpenEntitlements,
        sodPrediction, // Predict conflicts against currently assigned system access via SailPoint
        internalViolations, // Evaluate conflicts strictly locally inside the newly requested items list
        recommendations,
    });
});

/**
 * API ENDPOINT: Evaluates potential SOD violations for already pending access on demand.
 */
app.post("/check-sod-pending-request", async (req: Request, res: Response) => {
    access_token = extractAccessToken(req);
    const body = req.body as CheckSodPendingRequestBody;
    const identityId = body?.identityId;

    if (!identityId) {
        return res.status(400).json({ error: "identityId is required." });
    }
    if (!access_token) {
        return res.status(401).json({ error: "No valid access token supplied." });
    }

    const apiBaseUrl = extractApiBaseUrl(access_token);
    if (!apiBaseUrl) {
        return res.status(400).json({ error: "Could not extract API base URL from token." });
    }

    const allOpenEntitlements = await extractAllOpenEntitlements(
        apiBaseUrl,
        identityId,
        undefined, // No current request ID to exclude
        access_token
    );

    const entitlementIds = allOpenEntitlements.map((ref) => ref.id);
    const sodPolicies = await fetchSodPolicies(apiBaseUrl, access_token);
    const internalViolations = checkPoliciesAgainstEntitlements(
        sodPolicies,
        entitlementIds
    );

    res.json({
        identityId,
        allOpenEntitlements,
        internalViolations,
    });
});

const PORT = 3000;
app.listen(PORT, () => {
    console.log(`Server running on http://localhost:${PORT}`);
});

