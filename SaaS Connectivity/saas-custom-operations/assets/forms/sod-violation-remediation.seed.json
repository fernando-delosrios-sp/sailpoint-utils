{
    "description": "SOD violation remediation — launch form for corrective removal or compensating control mitigation.",
    "formInput": [
        { "id": "targetIdentityName", "type": "STRING", "label": "Target Identity Name", "description": "Display name of the violating identity" },
        { "id": "policyName", "type": "STRING", "label": "Policy Name", "description": "SOD policy that was violated" },
        { "id": "situationSummaryHtml", "type": "STRING", "label": "Situation Summary", "description": "HTML summary for form context" },
        { "id": "groupADisplay", "type": "STRING", "label": "Group A Display", "description": "Newline-separated access paths for group A" },
        { "id": "groupBDisplay", "type": "STRING", "label": "Group B Display", "description": "Newline-separated access paths for group B" },
        { "id": "groupAWarning", "type": "STRING", "label": "Group A Warning", "description": "Help text when group A includes AP/role paths" },
        { "id": "groupBWarning", "type": "STRING", "label": "Group B Warning", "description": "Help text when group B includes AP/role paths" },
        { "id": "hasControls", "type": "STRING", "label": "Has Controls", "description": "Whether tenant compensating controls exist (true/false)" },
        { "id": "violationId", "type": "STRING", "label": "Violation ID", "description": "Hidden workflow key" },
        { "id": "targetIdentityId", "type": "STRING", "label": "Target Identity ID", "description": "Hidden workflow key" },
        { "id": "groupARevokePayload", "type": "STRING", "label": "Group A Revoke Payload", "description": "Hidden JSON revoke payload for group A" },
        { "id": "groupBRevokePayload", "type": "STRING", "label": "Group B Revoke Payload", "description": "Hidden JSON revoke payload for group B" }
    ],
    "formElements": [
        {
            "id": "ctx-section",
            "elementType": "SECTION",
            "config": {
                "alignment": "LEFT",
                "description": "",
                "label": "Violation Context",
                "labelStyle": "h2",
                "showLabel": true,
                "formElements": [
                    {
                        "id": "ctx-identity",
                        "elementType": "DESCRIPTION",
                        "key": "",
                        "config": {
                            "label": "Target Identity",
                            "showLabel": true,
                            "description": "<p><strong>Identity:</strong> {{targetIdentityName}}</p><p><strong>Policy:</strong> {{policyName}}</p>"
                        },
                        "validations": []
                    },
                    {
                        "id": "ctx-summary",
                        "elementType": "DESCRIPTION",
                        "key": "",
                        "config": {
                            "label": "Situation",
                            "showLabel": true,
                            "description": "{{situationSummaryHtml}}"
                        },
                        "validations": []
                    }
                ]
            },
            "validations": []
        },
        {
            "id": "action-section",
            "elementType": "SECTION",
            "config": {
                "alignment": "LEFT",
                "description": "",
                "label": "Remediation Action",
                "labelStyle": "h2",
                "showLabel": true,
                "formElements": [
                    {
                        "id": "action-select",
                        "elementType": "SELECT",
                        "key": "action",
                        "config": {
                            "label": "Action",
                            "required": true,
                            "forceSelect": true,
                            "maximum": 1,
                            "dataSource": {
                                "dataSourceType": "STATIC",
                                "config": {
                                    "options": [
                                        { "label": "Correct", "value": "Correct", "sublabel": "Remove conflicting access" },
                                        { "label": "Mitigate", "value": "Mitigate", "sublabel": "Apply compensating control" }
                                    ]
                                }
                            }
                        },
                        "validations": [{ "validationType": "REQUIRED" }, { "validationType": "DATA_SOURCE" }]
                    }
                ]
            },
            "validations": []
        },
        {
            "id": "correct-section",
            "elementType": "SECTION",
            "config": {
                "alignment": "LEFT",
                "description": "",
                "label": "Correct Violation",
                "labelStyle": "h2",
                "showLabel": true,
                "formElements": [
                    {
                        "id": "toxic-column-set",
                        "elementType": "COLUMN_SET",
                        "key": "",
                        "config": {
                            "label": "Toxic Combination",
                            "labelStyle": "h5",
                            "showLabel": true,
                            "columnCount": 2,
                            "columns": [
                                [
                                    {
                                        "id": "group-a-display",
                                        "elementType": "TEXTAREA",
                                        "key": "groupADisplayReadonly",
                                        "config": {
                                            "label": "Group A",
                                            "default": "{{groupADisplay}}",
                                            "rows": 4,
                                            "required": false,
                                            "resize": false
                                        },
                                        "validations": []
                                    }
                                ],
                                [
                                    {
                                        "id": "group-b-display",
                                        "elementType": "TEXTAREA",
                                        "key": "groupBDisplayReadonly",
                                        "config": {
                                            "label": "Group B",
                                            "default": "{{groupBDisplay}}",
                                            "rows": 4,
                                            "required": false,
                                            "resize": false
                                        },
                                        "validations": []
                                    }
                                ]
                            ]
                        },
                        "validations": []
                    },
                    {
                        "id": "remediation-side",
                        "elementType": "SELECT",
                        "key": "remediationSide",
                        "config": {
                            "label": "Remove access from",
                            "helpText": "Select exactly one side of the toxic pair to remediate.",
                            "required": true,
                            "forceSelect": true,
                            "maximum": 1,
                            "dataSource": {
                                "dataSourceType": "STATIC",
                                "config": {
                                    "options": [
                                        { "label": "Group A", "value": "groupA", "sublabel": "{{groupAWarning}}" },
                                        { "label": "Group B", "value": "groupB", "sublabel": "{{groupBWarning}}" }
                                    ]
                                }
                            }
                        },
                        "validations": [{ "validationType": "REQUIRED" }, { "validationType": "DATA_SOURCE" }]
                    }
                ]
            },
            "validations": []
        },
        {
            "id": "mitigate-section",
            "elementType": "SECTION",
            "config": {
                "alignment": "LEFT",
                "description": "",
                "label": "Mitigate Violation",
                "labelStyle": "h2",
                "showLabel": true,
                "formElements": [
                    {
                        "id": "policy-control",
                        "elementType": "SELECT",
                        "key": "policyControl",
                        "config": {
                            "label": "Compensating Control",
                            "required": true,
                            "forceSelect": true,
                            "maximum": 1,
                            "dataSource": {
                                "dataSourceType": "STATIC",
                                "config": {
                                    "options": [
                                        { "label": "Select compensating control", "value": "", "sublabel": "Populated at runtime when controls exist" }
                                    ]
                                }
                            }
                        },
                        "validations": [{ "validationType": "REQUIRED" }, { "validationType": "DATA_SOURCE" }]
                    },
                    {
                        "id": "comments",
                        "elementType": "TEXTAREA",
                        "key": "comments",
                        "config": {
                            "label": "Comments",
                            "required": true,
                            "rows": 3,
                            "resize": false
                        },
                        "validations": [{ "validationType": "REQUIRED" }]
                    }
                ]
            },
            "validations": []
        },
        {
            "id": "hidden-section",
            "elementType": "SECTION",
            "config": {
                "alignment": "LEFT",
                "description": "",
                "label": "Workflow Keys",
                "labelStyle": "h6",
                "showLabel": false,
                "formElements": [
                    {
                        "id": "hidden-violation-id",
                        "elementType": "TEXT",
                        "key": "violationId",
                        "config": { "label": "Violation ID", "default": "{{violationId}}", "required": false },
                        "validations": []
                    },
                    {
                        "id": "hidden-target-id",
                        "elementType": "TEXT",
                        "key": "targetIdentityId",
                        "config": { "label": "Target Identity ID", "default": "{{targetIdentityId}}", "required": false },
                        "validations": []
                    },
                    {
                        "id": "hidden-group-a-payload",
                        "elementType": "TEXT",
                        "key": "groupARevokePayload",
                        "config": { "label": "Group A Revoke Payload", "default": "{{groupARevokePayload}}", "required": false },
                        "validations": []
                    },
                    {
                        "id": "hidden-group-b-payload",
                        "elementType": "TEXT",
                        "key": "groupBRevokePayload",
                        "config": { "label": "Group B Revoke Payload", "default": "{{groupBRevokePayload}}", "required": false },
                        "validations": []
                    }
                ]
            },
            "validations": []
        }
    ],
    "formConditions": [
        {
            "ruleOperator": "AND",
            "rules": [{ "sourceType": "ELEMENT", "source": "action", "operator": "EQ", "valueType": "STRING", "value": "Correct" }],
            "effects": [{ "effectType": "SHOW", "config": { "element": "correct-section" } }]
        },
        {
            "ruleOperator": "AND",
            "rules": [{ "sourceType": "ELEMENT", "source": "action", "operator": "EQ", "valueType": "STRING", "value": "Mitigate" }],
            "effects": [{ "effectType": "SHOW", "config": { "element": "mitigate-section" } }]
        },
        {
            "ruleOperator": "AND",
            "rules": [{ "sourceType": "INPUT", "source": "hasControls", "operator": "EQ", "valueType": "STRING", "value": "false" }],
            "effects": [{ "effectType": "HIDE", "config": { "element": "mitigate-section" } }]
        }
    ]
}

