{
    "id": "machine-identity-entitlements-apply",
    "name": "Machine Identity Entitlements - Apply",
    "description": "Account Created on the result source: invoke custom:machine-identity-entitlements-apply, which unions the persisted entitlements onto the machine identity's userEntitlements, then optionally delete the trigger account.",
    "definition": {
        "start": "Configuration",
        "steps": {
            "Configuration": {
                "actionId": "sp:define-variable",
                "attributes": {
                    "id": "sp:define-variable",
                    "variables": [
                        {
                            "description": "ISC API base URL, no trailing slash.",
                            "name": "API URL",
                            "transforms": [],
                            "variableA": "https://tenant.api.identitynow-demo.com"
                        },
                        {
                            "description": "SaaS Custom Operations connector id.",
                            "name": "SaaS Custom Operations Connector ID",
                            "transforms": [],
                            "variableA": "YOUR_CONNECTOR_ID"
                        },
                        {
                            "description": "Result source name the connector persists to.",
                            "name": "SaaS Custom Operations Source Name",
                            "transforms": [],
                            "variableA": "SaaS Custom Operations"
                        },
                        {
                            "description": "When true, delete the result-source trigger account after a successful userEntitlements patch.",
                            "name": "Delete Trigger Account",
                            "transforms": [],
                            "variableA": "false"
                        }
                    ]
                },
                "displayName": "Configuration",
                "nextStep": "Get Access Token",
                "type": "Mutation"
            },
            "Get Access Token": {
                "actionId": "sp:http",
                "attributes": {
                    "formRequestBody": {
                        "grant_type": "client_credentials"
                    },
                    "method": "post",
                    "param_authenticationRef": "basic",
                    "param_basic": {
                        "mapping": {
                            "auth_password": "password",
                            "auth_username": "username"
                        },
                        "paramID": "YOUR_OAUTH_BASIC_AUTH_PARAM_ID",
                        "paramType": "1.1",
                        "refID": "YOUR_OAUTH_BASIC_AUTH_REF_ID"
                    },
                    "requestContentType": "form",
                    "url": "{{$.configuration.aPIURL}}/oauth/token"
                },
                "description": "The connector invoke body carries config.token, so this workflow needs a token value and cannot rely on the step's own saved OAuth credential.",
                "displayName": "Get Access Token",
                "nextStep": "Call Apply Operation",
                "type": "action",
                "versionNumber": 3
            },
            "Call Apply Operation": {
                "actionId": "sp:http",
                "attributes": {
                    "jsonRequestBody": {
                        "config": {
                            "apiUrl": "{{$.configuration.aPIURL}}",
                            "sourceName": "{{$.configuration.saaSCustomOperationsSourceName}}",
                            "token": "{{$.getAccessToken.body.access_token}}"
                        },
                        "connectorRef": "{{$.configuration.saaSCustomOperationsConnectorID}}",
                        "input": {
                            "entitlementIds.$": "$.trigger.account.attributes['machine-identity-entitlements:entitlement-ids']",
                            "entitlementSourceIds.$": "$.trigger.account.attributes['machine-identity-entitlements:entitlement-source-ids']",
                            "machineIdentityId.$": "$.trigger.account.attributes['machine-identity-entitlements:machine-identity-id']",
                            "requestId": "mie-apply:{{$.trigger.accountId}}"
                        },
                        "tag": "latest",
                        "type": "custom:machine-identity-entitlements-apply"
                    },
                    "method": "post",
                    "param_authenticationRef": "none",
                    "requestContentType": "json",
                    "requestHeaders": {
                        "Authorization": "Bearer {{$.getAccessToken.body.access_token}}"
                    },
                    "url": "{{$.configuration.aPIURL}}/beta/platform-connectors/{{$.configuration.saaSCustomOperationsConnectorID}}/invoke"
                },
                "description": "The connector reads the identity's current userEntitlements and PATCHes the union, so the add list never replaces existing refs.",
                "displayName": "Call Apply Operation",
                "nextStep": "Check Delete Trigger Account",
                "type": "action",
                "versionNumber": 3
            },
            "Check Delete Trigger Account": {
                "choiceList": [
                    {
                        "comparator": "StringEquals",
                        "nextStep": "Delete Trigger Account",
                        "variableA.$": "$.configuration.deleteTriggerAccount",
                        "variableB": "true"
                    }
                ],
                "defaultStep": "End Step - Success",
                "displayName": "Check Delete Trigger Account",
                "type": "choice"
            },
            "Delete Trigger Account": {
                "actionId": "sp:http",
                "attributes": {
                    "method": "delete",
                    "param_authenticationRef": "none",
                    "requestHeaders": {
                        "Authorization": "Bearer {{$.getAccessToken.body.access_token}}"
                    },
                    "url": "{{$.configuration.aPIURL}}/v3/accounts/{{$.trigger.accountId}}"
                },
                "displayName": "Delete Trigger Account",
                "nextStep": "End Step - Success",
                "type": "action",
                "versionNumber": 3
            },
            "End Step - Success": {
                "actionId": "sp:operator-success",
                "displayName": "",
                "type": "success"
            }
        }
    },
    "enabled": false,
    "trigger": {
        "type": "EVENT",
        "mode": "advanced",
        "attributes": {
            "filter.$": "$.account.attributes[?(@.operationName == \"custom:machine-identity-entitlements\")]",
            "id": "idn:account-created",
            "integrationId": null
        }
    }
}
