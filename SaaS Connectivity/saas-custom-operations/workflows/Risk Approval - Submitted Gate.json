{
  "id": "YOUR_SUBMITTED_GATE_WORKFLOW_ID",
  "name": "Risk Approval - Submitted Gate",
  "description": "Access Request Submitted event-trigger wrapper. Scores the request with custom:evaluate-access-request-risk and approves or denies. Does not choose an extra approver. Import disabled, set Configuration, then subscribe the event trigger to this workflow external URL as Async.",
  "definition": {
    "start": "Configuration",
    "steps": {
      "Configuration": {
        "actionId": "sp:define-variable",
        "attributes": {
          "id": "sp:define-variable",
          "variables": [
            {
              "description": "ISC API base URL, no trailing slash.",
              "name": "API URL",
              "transforms": [],
              "variableA": "https://{tenant}.api.identitynow.com"
            },
            {
              "description": "Result source that stores custom operation output.",
              "name": "SaaS Custom Operations Source Name",
              "transforms": [],
              "variableA": "SaaS Custom Operations"
            },
            {
              "description": "Platform connector id for saas-custom-operations.",
              "name": "SaaS Custom Operations Connector ID",
              "transforms": [],
              "variableA": "YOUR_CONNECTOR_ID"
            },
            {
              "description": "true includes entitlement privilegeLevel.effective. false scores entitlements from Risk metadata only.",
              "name": "Consider Privilege",
              "transforms": [],
              "variableA": "true"
            },
            {
              "description": "High denies only High. Medium denies High and Medium. Low denies every tier.",
              "name": "Deny At Tier",
              "transforms": [],
              "variableA": "High"
            },
            {
              "description": "Value sent as callback approver. Use an existing identity username when Access Request Decision is subscribed.",
              "name": "Approver Name",
              "transforms": [],
              "variableA": "Workflow"
            }
          ]
        },
        "displayName": "Configuration",
        "nextStep": "Get Access Token",
        "type": "Mutation"
      },
      "Get Access Token": {
        "actionId": "sp:http",
        "attributes": {
          "formRequestBody": {
            "grant_type": "client_credentials"
          },
          "method": "post",
          "param_authenticationRef": "basic",
          "requestContentType": "form",
          "url": "{{$.configuration.aPIURL}}/oauth/token"
        },
        "catch": [
          {
            "next": "Callback Deny"
          }
        ],
        "description": "Set basic auth on this step to the workflow OAuth client. Do not store the secret in this export.",
        "displayName": "Get Access Token",
        "nextStep": "Call Evaluate Risk",
        "type": "action",
        "versionNumber": 3
      },
      "Call Evaluate Risk": {
        "actionId": "sp:http",
        "attributes": {
          "jsonRequestBody": {
            "config": {
              "apiUrl": "{{$.configuration.aPIURL}}",
              "sourceName": "{{$.configuration.saaSCustomOperationsSourceName}}",
              "token": "{{$.getAccessToken.body.access_token}}"
            },
            "connectorRef": "{{$.configuration.saaSCustomOperationsConnectorID}}",
            "input": {
              "accessRequestId": "{{$.trigger.accessRequestId}}",
              "considerPrivilege": "{{$.configuration.considerPrivilege}}",
              "requestId": "{{$.trigger.accessRequestId}}:submitted",
              "requestedItems.$": "$.trigger.requestedItems"
            },
            "tag": "latest",
            "type": "custom:evaluate-access-request-risk"
          },
          "method": "post",
          "param_authenticationRef": "none",
          "requestContentType": "json",
          "requestHeaders": {
            "Authorization": "Bearer {{$.getAccessToken.body.access_token}}"
          },
          "url": "{{$.configuration.aPIURL}}/beta/platform-connectors/{{$.configuration.saaSCustomOperationsConnectorID}}/invoke"
        },
        "catch": [
          {
            "next": "Callback Deny"
          }
        ],
        "displayName": "Call Evaluate Risk",
        "nextStep": "Read Risk Result",
        "type": "action",
        "versionNumber": 3
      },
      "Read Risk Result": {
        "actionId": "sp:get-accounts",
        "attributes": {
          "filterCriteria": "nativeIdentity",
          "getAccountsBy": "filters",
          "operator": "eq",
          "value": "{{$.trigger.accessRequestId}}:submitted"
        },
        "catch": [
          {
            "next": "Callback Deny"
          }
        ],
        "displayName": "Read Risk Result",
        "nextStep": "Check Tier",
        "type": "action",
        "versionNumber": 1
      },
      "Check Tier": {
        "actionId": "sp:compare-strings",
        "choiceList": [
          {
            "comparator": "StringEquals",
            "nextStep": "Check Deny Low",
            "variableA.$": "$.readRiskResult.accounts[0].attributes['evaluate-access-request-risk:tier']",
            "variableB": "Low"
          },
          {
            "comparator": "StringEquals",
            "nextStep": "Check Deny Medium",
            "variableA.$": "$.readRiskResult.accounts[0].attributes['evaluate-access-request-risk:tier']",
            "variableB": "Medium"
          }
        ],
        "defaultStep": "Callback Deny",
        "description": "High, a missing tier, or a failed read denies the request.",
        "displayName": "Which tier?",
        "type": "choice"
      },
      "Check Deny Low": {
        "actionId": "sp:compare-strings",
        "choiceList": [
          {
            "comparator": "StringEquals",
            "nextStep": "Callback Deny",
            "variableA.$": "$.configuration.denyAtTier",
            "variableB": "Low"
          }
        ],
        "defaultStep": "Callback Approve",
        "displayName": "Deny Low?",
        "type": "choice"
      },
      "Check Deny Medium": {
        "actionId": "sp:compare-strings",
        "choiceList": [
          {
            "comparator": "StringEquals",
            "nextStep": "Callback Approve",
            "variableA.$": "$.configuration.denyAtTier",
            "variableB": "High"
          }
        ],
        "defaultStep": "Callback Deny",
        "displayName": "Deny Medium?",
        "type": "choice"
      },
      "Callback Approve": {
        "actionId": "sp:http",
        "attributes": {
          "jsonRequestBody": {
            "output": {
              "approved": true,
              "approver": "{{$.configuration.approverName}}",
              "comment": "Risk tier {{$.readRiskResult.accounts[0].attributes['evaluate-access-request-risk:tier']}} is below Deny At Tier {{$.configuration.denyAtTier}}."
            },
            "secret": "{{$.trigger._metadata.secret}}"
          },
          "method": "post",
          "requestContentType": "json",
          "url.$": "$.trigger._metadata.callbackURL"
        },
        "displayName": "Callback Approve",
        "nextStep": "End Success",
        "type": "action",
        "versionNumber": 3
      },
      "Callback Deny": {
        "actionId": "sp:http",
        "attributes": {
          "jsonRequestBody": {
            "output": {
              "approved": false,
              "approver": "{{$.configuration.approverName}}",
              "comment": "Access request denied by risk policy. Deny At Tier is {{$.configuration.denyAtTier}}."
            },
            "secret": "{{$.trigger._metadata.secret}}"
          },
          "method": "post",
          "requestContentType": "json",
          "url.$": "$.trigger._metadata.callbackURL"
        },
        "displayName": "Callback Deny",
        "nextStep": "End Success",
        "type": "action",
        "versionNumber": 3
      },
      "End Success": {
        "actionId": "sp:operator-success",
        "description": "The Access Request Submitted callback was sent.",
        "displayName": "Success",
        "type": "success"
      }
    }
  },
  "enabled": false,
  "trigger": {
    "type": "EXTERNAL",
    "attributes": {
      "id": "idn:external-http",
      "integrationId": null
    }
  }
}
