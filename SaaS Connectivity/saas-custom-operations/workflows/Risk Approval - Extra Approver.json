{
  "id": "YOUR_EXTRA_APPROVER_WORKFLOW_ID",
  "name": "Risk Approval - Extra Approver",
  "description": "Access Request Dynamic Approval event-trigger wrapper. Approvers are single strings in the form IDENTITY|id or GOVERNANCE_GROUP|id. Phase 1 resolves Manager and Managers Manager to that form, falling back to Default Approver. Phase 2 scores risk with custom:evaluate-access-request-risk. Phase 3 has one step per tier that sets Approver from those variables or from a hardcoded value. Phase 4 answers with the approver, or with none when Approver is empty. Import disabled, set Configuration, then subscribe the event trigger to this workflow external URL as Async.",
  "definition": {
    "start": "Configuration",
    "steps": {
      "Configuration": {
        "actionId": "sp:define-variable",
        "attributes": {
          "id": "sp:define-variable",
          "variables": [
            {
              "description": "ISC API base URL, no trailing slash.",
              "name": "API URL",
              "transforms": [],
              "variableA": "https://{tenant}.api.identitynow.com"
            },
            {
              "description": "Result source that stores custom operation output.",
              "name": "SaaS Custom Operations Source Name",
              "transforms": [],
              "variableA": "SaaS Custom Operations"
            },
            {
              "description": "Platform connector id for saas-custom-operations.",
              "name": "SaaS Custom Operations Connector ID",
              "transforms": [],
              "variableA": "YOUR_CONNECTOR_ID"
            },
            {
              "description": "true includes entitlement privilegeLevel.effective. false scores entitlements from Risk metadata only.",
              "name": "Consider Privilege",
              "transforms": [],
              "variableA": "true"
            },
            {
              "description": "Approver used when a manager level is missing. IDENTITY|id or GOVERNANCE_GROUP|id.",
              "name": "Default Approver",
              "transforms": [],
              "variableA": "IDENTITY|YOUR_DEFAULT_APPROVER_ID"
            }
          ]
        },
        "displayName": "Configuration",
        "nextStep": "Approver Variables",
        "type": "Mutation"
      },
      "Approver Variables": {
        "actionId": "sp:define-variable",
        "attributes": {
          "id": "sp:define-variable",
          "variables": [
            {
              "description": "Overwritten by Set Manager when the recipient has a manager. Otherwise stays the default approver.",
              "name": "Manager",
              "transforms": [],
              "variableA.$": "$.configuration.defaultApprover"
            },
            {
              "description": "Overwritten by Set Managers Manager when that level exists. Otherwise stays the default approver.",
              "name": "Managers Manager",
              "transforms": [],
              "variableA.$": "$.configuration.defaultApprover"
            },
            {
              "description": "The winning tier's approver, IDENTITY|id or GOVERNANCE_GROUP|id. Empty means no extra approver.",
              "name": "Approver",
              "transforms": [],
              "variableA": ""
            },
            {
              "description": "Left side of Approver. Filled by Split Approver.",
              "name": "Approver Type",
              "transforms": [],
              "variableA": ""
            },
            {
              "description": "Right side of Approver. Filled by Split Approver.",
              "name": "Approver ID",
              "transforms": [],
              "variableA": ""
            }
          ]
        },
        "description": "Phase 1. Both manager levels start at the default approver, so a missing level needs no branch of its own.",
        "displayName": "Init approver variables",
        "nextStep": "Get Recipient",
        "type": "Mutation"
      },
      "Get Recipient": {
        "actionId": "sp:get-identity",
        "attributes": {
          "id.$": "$.trigger.requestedFor.id"
        },
        "catch": [
          {
            "next": "Get Access Token"
          }
        ],
        "displayName": "Get Recipient",
        "nextStep": "Check Manager",
        "type": "action",
        "versionNumber": 2
      },
      "Check Manager": {
        "actionId": "sp:compare-unary",
        "choiceList": [
          {
            "comparator": "IsPresent",
            "nextStep": "Get Manager",
            "variableA.$": "$.getRecipient.managerRef.id"
          }
        ],
        "defaultStep": "Get Access Token",
        "displayName": "Recipient has a manager?",
        "type": "choice"
      },
      "Get Manager": {
        "actionId": "sp:get-identity",
        "attributes": {
          "id.$": "$.getRecipient.managerRef.id"
        },
        "catch": [
          {
            "next": "Get Access Token"
          }
        ],
        "description": "Read to reach the next manager level. Set Manager only needs the id.",
        "displayName": "Get Manager",
        "nextStep": "Set Manager",
        "type": "action",
        "versionNumber": 2
      },
      "Set Manager": {
        "actionId": "sp:update-variable",
        "attributes": {
          "id": "sp:update-variable",
          "variables": [
            {
              "description": "",
              "name": "$.approverVariables.manager",
              "transforms": [
                {
                  "id": "sp:transform:concatenate:string",
                  "input": {
                    "variableB.$": "$.getManager.id"
                  }
                }
              ],
              "variableA": "IDENTITY|"
            }
          ]
        },
        "displayName": "Set manager",
        "nextStep": "Check Managers Manager",
        "type": "Mutation"
      },
      "Check Managers Manager": {
        "actionId": "sp:compare-unary",
        "choiceList": [
          {
            "comparator": "IsPresent",
            "nextStep": "Set Managers Manager",
            "variableA.$": "$.getManager.managerRef.id"
          }
        ],
        "defaultStep": "Get Access Token",
        "displayName": "Manager has a manager?",
        "type": "choice"
      },
      "Set Managers Manager": {
        "actionId": "sp:update-variable",
        "attributes": {
          "id": "sp:update-variable",
          "variables": [
            {
              "description": "",
              "name": "$.approverVariables.managersManager",
              "transforms": [
                {
                  "id": "sp:transform:concatenate:string",
                  "input": {
                    "variableB.$": "$.getManager.managerRef.id"
                  }
                }
              ],
              "variableA": "IDENTITY|"
            }
          ]
        },
        "displayName": "Set manager's manager",
        "nextStep": "Get Access Token",
        "type": "Mutation"
      },
      "Get Access Token": {
        "actionId": "sp:http",
        "attributes": {
          "formRequestBody": {
            "grant_type": "client_credentials"
          },
          "method": "post",
          "param_authenticationRef": "basic",
          "requestContentType": "form",
          "url": "{{$.configuration.aPIURL}}/oauth/token"
        },
        "catch": [
          {
            "next": "Set High Approver"
          }
        ],
        "description": "Phase 2. Set basic auth on this step to the workflow OAuth client. A failure falls through to the High approver.",
        "displayName": "Get Access Token",
        "nextStep": "Call Evaluate Risk",
        "type": "action",
        "versionNumber": 3
      },
      "Call Evaluate Risk": {
        "actionId": "sp:http",
        "attributes": {
          "jsonRequestBody": {
            "config": {
              "apiUrl": "{{$.configuration.aPIURL}}",
              "sourceName": "{{$.configuration.saaSCustomOperationsSourceName}}",
              "token": "{{$.getAccessToken.body.access_token}}"
            },
            "connectorRef": "{{$.configuration.saaSCustomOperationsConnectorID}}",
            "input": {
              "accessRequestId": "{{$.trigger.accessRequestId}}",
              "considerPrivilege": "{{$.configuration.considerPrivilege}}",
              "requestId": "{{$.trigger.accessRequestId}}:dynamic",
              "requestedItems.$": "$.trigger.requestedItems"
            },
            "tag": "latest",
            "type": "custom:evaluate-access-request-risk"
          },
          "method": "post",
          "param_authenticationRef": "none",
          "requestContentType": "json",
          "requestHeaders": {
            "Authorization": "Bearer {{$.getAccessToken.body.access_token}}"
          },
          "url": "{{$.configuration.aPIURL}}/beta/platform-connectors/{{$.configuration.saaSCustomOperationsConnectorID}}/invoke"
        },
        "catch": [
          {
            "next": "Set High Approver"
          }
        ],
        "displayName": "Call Evaluate Risk",
        "nextStep": "Read Risk Result",
        "type": "action",
        "versionNumber": 3
      },
      "Read Risk Result": {
        "actionId": "sp:get-accounts",
        "attributes": {
          "filterCriteria": "nativeIdentity",
          "getAccountsBy": "filters",
          "operator": "eq",
          "value": "{{$.trigger.accessRequestId}}:dynamic"
        },
        "catch": [
          {
            "next": "Set High Approver"
          }
        ],
        "displayName": "Read Risk Result",
        "nextStep": "Check Tier",
        "type": "action",
        "versionNumber": 1
      },
      "Check Tier": {
        "actionId": "sp:compare-strings",
        "choiceList": [
          {
            "comparator": "StringEquals",
            "nextStep": "Set High Approver",
            "variableA.$": "$.readRiskResult.accounts[0].attributes['evaluate-access-request-risk:tier']",
            "variableB": "High"
          }
        ],
        "defaultStep": "Check Tier Medium",
        "description": "Phase 3. One step per tier sets Approver. Edit those three steps to change who approves.",
        "displayName": "Tier is High?",
        "type": "choice"
      },
      "Check Tier Medium": {
        "actionId": "sp:compare-strings",
        "choiceList": [
          {
            "comparator": "StringEquals",
            "nextStep": "Set Medium Approver",
            "variableA.$": "$.readRiskResult.accounts[0].attributes['evaluate-access-request-risk:tier']",
            "variableB": "Medium"
          }
        ],
        "defaultStep": "Check Tier Low",
        "displayName": "Tier is Medium?",
        "type": "choice"
      },
      "Check Tier Low": {
        "actionId": "sp:compare-strings",
        "choiceList": [
          {
            "comparator": "StringEquals",
            "nextStep": "Set Low Approver",
            "variableA.$": "$.readRiskResult.accounts[0].attributes['evaluate-access-request-risk:tier']",
            "variableB": "Low"
          }
        ],
        "defaultStep": "Set High Approver",
        "displayName": "Tier is Low?",
        "type": "choice"
      },
      "Set High Approver": {
        "actionId": "sp:update-variable",
        "attributes": {
          "id": "sp:update-variable",
          "variables": [
            {
              "description": "",
              "name": "$.approverVariables.approver",
              "transforms": [],
              "variableA.$": "$.approverVariables.managersManager"
            }
          ]
        },
        "description": "Point at $.approverVariables.manager, $.configuration.defaultApprover, or type a literal such as GOVERNANCE_GROUP|id.",
        "displayName": "High approver is the manager's manager",
        "nextStep": "Check Approver",
        "type": "Mutation"
      },
      "Set Medium Approver": {
        "actionId": "sp:update-variable",
        "attributes": {
          "id": "sp:update-variable",
          "variables": [
            {
              "description": "",
              "name": "$.approverVariables.approver",
              "transforms": [],
              "variableA.$": "$.approverVariables.manager"
            }
          ]
        },
        "description": "Point at $.approverVariables.managersManager, $.configuration.defaultApprover, or type a literal such as GOVERNANCE_GROUP|id.",
        "displayName": "Medium approver is the manager",
        "nextStep": "Check Approver",
        "type": "Mutation"
      },
      "Set Low Approver": {
        "actionId": "sp:update-variable",
        "attributes": {
          "id": "sp:update-variable",
          "variables": [
            {
              "description": "",
              "name": "$.approverVariables.approver",
              "transforms": [],
              "variableA": ""
            }
          ]
        },
        "description": "Empty means no extra approver on Low. Set a variable or a literal here to add one.",
        "displayName": "Low adds no approver",
        "nextStep": "Check Approver",
        "type": "Mutation"
      },
      "Check Approver": {
        "actionId": "sp:compare-strings",
        "choiceList": [
          {
            "comparator": "StringEquals",
            "nextStep": "Callback None",
            "variableA.$": "$.approverVariables.approver",
            "variableB": ""
          }
        ],
        "defaultStep": "Split Approver",
        "description": "Phase 4. Every tier converges here.",
        "displayName": "Approver is empty?",
        "type": "choice"
      },
      "Split Approver": {
        "actionId": "sp:update-variable",
        "attributes": {
          "id": "sp:update-variable",
          "variables": [
            {
              "description": "",
              "name": "$.approverVariables.approverType",
              "transforms": [
                {
                  "id": "sp:transform:replace:string",
                  "input": {
                    "pattern": "\\|.*",
                    "replacement": ""
                  }
                }
              ],
              "variableA.$": "$.approverVariables.approver"
            },
            {
              "description": "",
              "name": "$.approverVariables.approverID",
              "transforms": [
                {
                  "id": "sp:transform:replace:string",
                  "input": {
                    "pattern": ".*\\|",
                    "replacement": ""
                  }
                }
              ],
              "variableA.$": "$.approverVariables.approver"
            }
          ]
        },
        "description": "Splits IDENTITY|id or GOVERNANCE_GROUP|id into the two callback fields.",
        "displayName": "Split approver",
        "nextStep": "Callback",
        "type": "Mutation"
      },
      "Callback": {
        "actionId": "sp:http",
        "attributes": {
          "jsonRequestBody": {
            "output": {
              "id": "{{$.approverVariables.approverID}}",
              "name": "",
              "type": "{{$.approverVariables.approverType}}"
            },
            "secret": "{{$.trigger._metadata.secret}}"
          },
          "method": "post",
          "requestContentType": "json",
          "url.$": "$.trigger._metadata.callbackURL"
        },
        "description": "The trigger routes on id and type. name is informational, so no identity or group read is needed.",
        "displayName": "Callback",
        "nextStep": "End Success",
        "type": "action",
        "versionNumber": 3
      },
      "Callback None": {
        "actionId": "sp:http",
        "attributes": {
          "jsonRequestBody": {
            "output": {
              "id": "",
              "name": "",
              "type": ""
            },
            "secret": "{{$.trigger._metadata.secret}}"
          },
          "method": "post",
          "requestContentType": "json",
          "url.$": "$.trigger._metadata.callbackURL"
        },
        "displayName": "Callback None",
        "nextStep": "End Success",
        "type": "action",
        "versionNumber": 3
      },
      "End Success": {
        "actionId": "sp:operator-success",
        "description": "The dynamic approval callback was sent.",
        "displayName": "Success",
        "type": "success"
      }
    }
  },
  "enabled": false,
  "trigger": {
    "type": "EXTERNAL",
    "attributes": {
      "id": "idn:external-http",
      "integrationId": null
    }
  }
}
