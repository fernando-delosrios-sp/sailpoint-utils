{
  "id": "YOUR_EXTRA_APPROVER_WORKFLOW_ID",
  "name": "Risk Approval - Extra Approver",
  "description": "Access Request Dynamic Approval event-trigger wrapper. Scores risk with custom:evaluate-access-request-risk, then adds one identity or governance group, or none on Low. Missing manager levels use the default approver. Import disabled, set Configuration, then subscribe the event trigger to this workflow external URL as Async.",
  "definition": {
    "start": "Configuration",
    "steps": {
      "Configuration": {
        "actionId": "sp:define-variable",
        "attributes": {
          "id": "sp:define-variable",
          "variables": [
            {
              "description": "ISC API base URL, no trailing slash.",
              "name": "API URL",
              "transforms": [],
              "variableA": "https://{tenant}.api.identitynow.com"
            },
            {
              "description": "Result source that stores custom operation output.",
              "name": "SaaS Custom Operations Source Name",
              "transforms": [],
              "variableA": "SaaS Custom Operations"
            },
            {
              "description": "Platform connector id for saas-custom-operations.",
              "name": "SaaS Custom Operations Connector ID",
              "transforms": [],
              "variableA": "YOUR_CONNECTOR_ID"
            },
            {
              "description": "true includes entitlement privilegeLevel.effective. false scores entitlements from Risk metadata only.",
              "name": "Consider Privilege",
              "transforms": [],
              "variableA": "true"
            },
            {
              "description": "High tier selector: manager, managersManager, defaultApprover, customIdentity, or customGovernanceGroup.",
              "name": "High Selector",
              "transforms": [],
              "variableA": "managersManager"
            },
            {
              "description": "Medium tier selector: manager, managersManager, defaultApprover, customIdentity, or customGovernanceGroup.",
              "name": "Medium Selector",
              "transforms": [],
              "variableA": "manager"
            },
            {
              "description": "Identity id used when the selected manager level is missing, the selector is defaultApprover, or evaluation fails.",
              "name": "Default Approver ID",
              "transforms": [],
              "variableA": "YOUR_DEFAULT_APPROVER_ID"
            },
            {
              "description": "Display name sent with the default approver id.",
              "name": "Default Approver Name",
              "transforms": [],
              "variableA": "YOUR_DEFAULT_APPROVER_NAME"
            },
            {
              "description": "Identity id when High Selector is customIdentity.",
              "name": "Custom High Identity ID",
              "transforms": [],
              "variableA": "YOUR_CUSTOM_HIGH_IDENTITY_ID"
            },
            {
              "description": "Display name when High Selector is customIdentity.",
              "name": "Custom High Identity Name",
              "transforms": [],
              "variableA": "YOUR_CUSTOM_HIGH_IDENTITY_NAME"
            },
            {
              "description": "Governance group id when High Selector is customGovernanceGroup.",
              "name": "Custom High Group ID",
              "transforms": [],
              "variableA": "YOUR_CUSTOM_HIGH_GROUP_ID"
            },
            {
              "description": "Governance group name when High Selector is customGovernanceGroup.",
              "name": "Custom High Group Name",
              "transforms": [],
              "variableA": "YOUR_CUSTOM_HIGH_GROUP_NAME"
            },
            {
              "description": "Identity id when Medium Selector is customIdentity.",
              "name": "Custom Medium Identity ID",
              "transforms": [],
              "variableA": "YOUR_CUSTOM_MEDIUM_IDENTITY_ID"
            },
            {
              "description": "Display name when Medium Selector is customIdentity.",
              "name": "Custom Medium Identity Name",
              "transforms": [],
              "variableA": "YOUR_CUSTOM_MEDIUM_IDENTITY_NAME"
            },
            {
              "description": "Governance group id when Medium Selector is customGovernanceGroup.",
              "name": "Custom Medium Group ID",
              "transforms": [],
              "variableA": "YOUR_CUSTOM_MEDIUM_GROUP_ID"
            },
            {
              "description": "Governance group name when Medium Selector is customGovernanceGroup.",
              "name": "Custom Medium Group Name",
              "transforms": [],
              "variableA": "YOUR_CUSTOM_MEDIUM_GROUP_NAME"
            }
          ]
        },
        "displayName": "Configuration",
        "nextStep": "Get Recipient",
        "type": "Mutation"
      },
      "Get Recipient": {
        "actionId": "sp:get-identity",
        "attributes": {
          "id.$": "$.trigger.requestedFor.id"
        },
        "catch": [
          {
            "next": "Get Access Token"
          }
        ],
        "displayName": "Get Recipient",
        "nextStep": "Check Manager",
        "type": "action",
        "versionNumber": 2
      },
      "Check Manager": {
        "actionId": "sp:compare-unary",
        "choiceList": [
          {
            "comparator": "IsPresent",
            "nextStep": "Get Manager",
            "variableA.$": "$.getRecipient.managerRef.id"
          }
        ],
        "defaultStep": "Get Access Token",
        "displayName": "Recipient has a manager?",
        "type": "choice"
      },
      "Get Manager": {
        "actionId": "sp:get-identity",
        "attributes": {
          "id.$": "$.getRecipient.managerRef.id"
        },
        "catch": [
          {
            "next": "Get Access Token"
          }
        ],
        "displayName": "Get Manager",
        "nextStep": "Check Managers Manager",
        "type": "action",
        "versionNumber": 2
      },
      "Check Managers Manager": {
        "actionId": "sp:compare-unary",
        "choiceList": [
          {
            "comparator": "IsPresent",
            "nextStep": "Get Managers Manager",
            "variableA.$": "$.getManager.managerRef.id"
          }
        ],
        "defaultStep": "Get Access Token",
        "displayName": "Manager has a manager?",
        "type": "choice"
      },
      "Get Managers Manager": {
        "actionId": "sp:get-identity",
        "attributes": {
          "id.$": "$.getManager.managerRef.id"
        },
        "catch": [
          {
            "next": "Get Access Token"
          }
        ],
        "displayName": "Get Managers Manager",
        "nextStep": "Get Access Token",
        "type": "action",
        "versionNumber": 2
      },
      "Get Access Token": {
        "actionId": "sp:http",
        "attributes": {
          "formRequestBody": {
            "grant_type": "client_credentials"
          },
          "method": "post",
          "param_authenticationRef": "basic",
          "requestContentType": "form",
          "url": "{{$.configuration.aPIURL}}/oauth/token"
        },
        "catch": [
          {
            "next": "Callback Default Approver"
          }
        ],
        "description": "Set basic auth on this step to the workflow OAuth client.",
        "displayName": "Get Access Token",
        "nextStep": "Call Evaluate Risk",
        "type": "action",
        "versionNumber": 3
      },
      "Call Evaluate Risk": {
        "actionId": "sp:http",
        "attributes": {
          "jsonRequestBody": {
            "config": {
              "apiUrl": "{{$.configuration.aPIURL}}",
              "sourceName": "{{$.configuration.saaSCustomOperationsSourceName}}",
              "token": "{{$.getAccessToken.body.access_token}}"
            },
            "connectorRef": "{{$.configuration.saaSCustomOperationsConnectorID}}",
            "input": {
              "accessRequestId": "{{$.trigger.accessRequestId}}",
              "considerPrivilege": "{{$.configuration.considerPrivilege}}",
              "requestId": "{{$.trigger.accessRequestId}}:dynamic",
              "requestedItems.$": "$.trigger.requestedItems"
            },
            "tag": "latest",
            "type": "custom:evaluate-access-request-risk"
          },
          "method": "post",
          "param_authenticationRef": "none",
          "requestContentType": "json",
          "requestHeaders": {
            "Authorization": "Bearer {{$.getAccessToken.body.access_token}}"
          },
          "url": "{{$.configuration.aPIURL}}/beta/platform-connectors/{{$.configuration.saaSCustomOperationsConnectorID}}/invoke"
        },
        "catch": [
          {
            "next": "Callback Default Approver"
          }
        ],
        "displayName": "Call Evaluate Risk",
        "nextStep": "Read Risk Result",
        "type": "action",
        "versionNumber": 3
      },
      "Read Risk Result": {
        "actionId": "sp:get-accounts",
        "attributes": {
          "filterCriteria": "nativeIdentity",
          "getAccountsBy": "filters",
          "operator": "eq",
          "value": "{{$.trigger.accessRequestId}}:dynamic"
        },
        "catch": [
          {
            "next": "Callback Default Approver"
          }
        ],
        "displayName": "Read Risk Result",
        "nextStep": "Check Tier",
        "type": "action",
        "versionNumber": 1
      },
      "Check Tier": {
        "actionId": "sp:compare-strings",
        "choiceList": [
          {
            "comparator": "StringEquals",
            "nextStep": "Select High Approver",
            "variableA.$": "$.readRiskResult.accounts[0].attributes['evaluate-access-request-risk:tier']",
            "variableB": "High"
          },
          {
            "comparator": "StringEquals",
            "nextStep": "Select Medium Approver",
            "variableA.$": "$.readRiskResult.accounts[0].attributes['evaluate-access-request-risk:tier']",
            "variableB": "Medium"
          },
          {
            "comparator": "StringEquals",
            "nextStep": "Callback None",
            "variableA.$": "$.readRiskResult.accounts[0].attributes['evaluate-access-request-risk:tier']",
            "variableB": "Low"
          }
        ],
        "defaultStep": "Callback Default Approver",
        "description": "Low adds no approver. A missing tier fails closed to the default approver.",
        "displayName": "Which tier?",
        "type": "choice"
      },
      "Select High Approver": {
        "actionId": "sp:compare-strings",
        "choiceList": [
          {
            "comparator": "StringEquals",
            "nextStep": "Check High Manager",
            "variableA.$": "$.configuration.highSelector",
            "variableB": "manager"
          },
          {
            "comparator": "StringEquals",
            "nextStep": "Check High Managers Manager",
            "variableA.$": "$.configuration.highSelector",
            "variableB": "managersManager"
          },
          {
            "comparator": "StringEquals",
            "nextStep": "Callback High Custom Identity",
            "variableA.$": "$.configuration.highSelector",
            "variableB": "customIdentity"
          },
          {
            "comparator": "StringEquals",
            "nextStep": "Callback High Custom Group",
            "variableA.$": "$.configuration.highSelector",
            "variableB": "customGovernanceGroup"
          }
        ],
        "defaultStep": "Callback Default Approver",
        "displayName": "High selector",
        "type": "choice"
      },
      "Select Medium Approver": {
        "actionId": "sp:compare-strings",
        "choiceList": [
          {
            "comparator": "StringEquals",
            "nextStep": "Check Medium Manager",
            "variableA.$": "$.configuration.mediumSelector",
            "variableB": "manager"
          },
          {
            "comparator": "StringEquals",
            "nextStep": "Check Medium Managers Manager",
            "variableA.$": "$.configuration.mediumSelector",
            "variableB": "managersManager"
          },
          {
            "comparator": "StringEquals",
            "nextStep": "Callback Medium Custom Identity",
            "variableA.$": "$.configuration.mediumSelector",
            "variableB": "customIdentity"
          },
          {
            "comparator": "StringEquals",
            "nextStep": "Callback Medium Custom Group",
            "variableA.$": "$.configuration.mediumSelector",
            "variableB": "customGovernanceGroup"
          }
        ],
        "defaultStep": "Callback Default Approver",
        "displayName": "Medium selector",
        "type": "choice"
      },
      "Check High Manager": {
        "actionId": "sp:compare-unary",
        "choiceList": [
          {
            "comparator": "IsPresent",
            "nextStep": "Callback Manager",
            "variableA.$": "$.getManager.id"
          }
        ],
        "defaultStep": "Callback Default Approver",
        "displayName": "High manager present?",
        "type": "choice"
      },
      "Check High Managers Manager": {
        "actionId": "sp:compare-unary",
        "choiceList": [
          {
            "comparator": "IsPresent",
            "nextStep": "Callback Managers Manager",
            "variableA.$": "$.getManagersManager.id"
          }
        ],
        "defaultStep": "Callback Default Approver",
        "displayName": "High manager's manager present?",
        "type": "choice"
      },
      "Check Medium Manager": {
        "actionId": "sp:compare-unary",
        "choiceList": [
          {
            "comparator": "IsPresent",
            "nextStep": "Callback Manager",
            "variableA.$": "$.getManager.id"
          }
        ],
        "defaultStep": "Callback Default Approver",
        "displayName": "Medium manager present?",
        "type": "choice"
      },
      "Check Medium Managers Manager": {
        "actionId": "sp:compare-unary",
        "choiceList": [
          {
            "comparator": "IsPresent",
            "nextStep": "Callback Managers Manager",
            "variableA.$": "$.getManagersManager.id"
          }
        ],
        "defaultStep": "Callback Default Approver",
        "displayName": "Medium manager's manager present?",
        "type": "choice"
      },
      "Callback None": {
        "actionId": "sp:http",
        "attributes": {
          "jsonRequestBody": {
            "output": {
              "id": "",
              "name": "",
              "type": ""
            },
            "secret": "{{$.trigger._metadata.secret}}"
          },
          "method": "post",
          "requestContentType": "json",
          "url.$": "$.trigger._metadata.callbackURL"
        },
        "displayName": "Callback None",
        "nextStep": "End Success",
        "type": "action",
        "versionNumber": 3
      },
      "Callback Manager": {
        "actionId": "sp:http",
        "attributes": {
          "jsonRequestBody": {
            "output": {
              "id": "{{$.getManager.id}}",
              "name": "{{$.getManager.attributes.displayName}}",
              "type": "IDENTITY"
            },
            "secret": "{{$.trigger._metadata.secret}}"
          },
          "method": "post",
          "requestContentType": "json",
          "url.$": "$.trigger._metadata.callbackURL"
        },
        "displayName": "Callback Manager",
        "nextStep": "End Success",
        "type": "action",
        "versionNumber": 3
      },
      "Callback Managers Manager": {
        "actionId": "sp:http",
        "attributes": {
          "jsonRequestBody": {
            "output": {
              "id": "{{$.getManagersManager.id}}",
              "name": "{{$.getManagersManager.attributes.displayName}}",
              "type": "IDENTITY"
            },
            "secret": "{{$.trigger._metadata.secret}}"
          },
          "method": "post",
          "requestContentType": "json",
          "url.$": "$.trigger._metadata.callbackURL"
        },
        "displayName": "Callback Managers Manager",
        "nextStep": "End Success",
        "type": "action",
        "versionNumber": 3
      },
      "Callback Default Approver": {
        "actionId": "sp:http",
        "attributes": {
          "jsonRequestBody": {
            "output": {
              "id": "{{$.configuration.defaultApproverID}}",
              "name": "{{$.configuration.defaultApproverName}}",
              "type": "IDENTITY"
            },
            "secret": "{{$.trigger._metadata.secret}}"
          },
          "method": "post",
          "requestContentType": "json",
          "url.$": "$.trigger._metadata.callbackURL"
        },
        "displayName": "Callback Default Approver",
        "nextStep": "End Success",
        "type": "action",
        "versionNumber": 3
      },
      "Callback High Custom Identity": {
        "actionId": "sp:http",
        "attributes": {
          "jsonRequestBody": {
            "output": {
              "id": "{{$.configuration.customHighIdentityID}}",
              "name": "{{$.configuration.customHighIdentityName}}",
              "type": "IDENTITY"
            },
            "secret": "{{$.trigger._metadata.secret}}"
          },
          "method": "post",
          "requestContentType": "json",
          "url.$": "$.trigger._metadata.callbackURL"
        },
        "displayName": "Callback High Custom Identity",
        "nextStep": "End Success",
        "type": "action",
        "versionNumber": 3
      },
      "Callback High Custom Group": {
        "actionId": "sp:http",
        "attributes": {
          "jsonRequestBody": {
            "output": {
              "id": "{{$.configuration.customHighGroupID}}",
              "name": "{{$.configuration.customHighGroupName}}",
              "type": "GOVERNANCE_GROUP"
            },
            "secret": "{{$.trigger._metadata.secret}}"
          },
          "method": "post",
          "requestContentType": "json",
          "url.$": "$.trigger._metadata.callbackURL"
        },
        "displayName": "Callback High Custom Group",
        "nextStep": "End Success",
        "type": "action",
        "versionNumber": 3
      },
      "Callback Medium Custom Identity": {
        "actionId": "sp:http",
        "attributes": {
          "jsonRequestBody": {
            "output": {
              "id": "{{$.configuration.customMediumIdentityID}}",
              "name": "{{$.configuration.customMediumIdentityName}}",
              "type": "IDENTITY"
            },
            "secret": "{{$.trigger._metadata.secret}}"
          },
          "method": "post",
          "requestContentType": "json",
          "url.$": "$.trigger._metadata.callbackURL"
        },
        "displayName": "Callback Medium Custom Identity",
        "nextStep": "End Success",
        "type": "action",
        "versionNumber": 3
      },
      "Callback Medium Custom Group": {
        "actionId": "sp:http",
        "attributes": {
          "jsonRequestBody": {
            "output": {
              "id": "{{$.configuration.customMediumGroupID}}",
              "name": "{{$.configuration.customMediumGroupName}}",
              "type": "GOVERNANCE_GROUP"
            },
            "secret": "{{$.trigger._metadata.secret}}"
          },
          "method": "post",
          "requestContentType": "json",
          "url.$": "$.trigger._metadata.callbackURL"
        },
        "displayName": "Callback Medium Custom Group",
        "nextStep": "End Success",
        "type": "action",
        "versionNumber": 3
      },
      "End Success": {
        "actionId": "sp:operator-success",
        "description": "The dynamic approval callback was sent.",
        "displayName": "Success",
        "type": "success"
      }
    }
  },
  "enabled": false,
  "trigger": {
    "type": "EXTERNAL",
    "attributes": {
      "id": "idn:external-http",
      "integrationId": null
    }
  }
}
