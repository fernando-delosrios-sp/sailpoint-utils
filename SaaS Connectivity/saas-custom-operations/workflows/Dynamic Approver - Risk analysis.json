{
  "id": "YOUR_DYNAMIC_APPROVER_WORKFLOW_ID",
  "name": "Dynamic Approver - Risk analysis",
  "description": "Access Request Dynamic Approval event-trigger wrapper. Adds at most one extra approver, or none, depending on the risk tier. Phase 1 stores Manager and Managers Manager as identity ids, falling back to Default Approver. Phase 2 scores risk with custom:evaluate-access-request-risk. Phase 3 sets Approver to a bare id on each tier step, or leaves NONE to add nobody. Any failure, and a missing or unknown tier, takes Set Error approver instead of a tier step. Phase 4 detects whether that id is an identity or a governance group, reads its display name, and sends the callback; the none callback goes out when Approver is NONE. Import disabled, set Configuration, then subscribe the event trigger to this workflow external URL as Async.",
  "definition": {
    "start": "Configuration",
    "steps": {
      "Configuration": {
        "actionId": "sp:define-variable",
        "attributes": {
          "id": "sp:define-variable",
          "variables": [
            {
              "description": "ISC API base URL, no trailing slash.",
              "name": "API URL",
              "transforms": [],
              "variableA": "https://{tenant}.api.identitynow.com"
            },
            {
              "description": "Result source that stores custom operation output.",
              "name": "SaaS Custom Operations Source Name",
              "transforms": [],
              "variableA": "SaaS Custom Operations"
            },
            {
              "description": "Platform connector id for saas-custom-operations.",
              "name": "SaaS Custom Operations Connector ID",
              "transforms": [],
              "variableA": "YOUR_CONNECTOR_ID"
            },
            {
              "description": "true includes entitlement privilegeLevel.effective. false scores entitlements from Risk metadata only.",
              "name": "Consider Privilege",
              "transforms": [],
              "variableA": "true"
            },
            {
              "description": "Identity or governance group id used when a manager level is missing, and when the risk evaluation fails or returns no tier. Enter the id on its own, with no type prefix. The workflow detects the kind from the id format.",
              "name": "Default Approver",
              "transforms": [],
              "variableA": "YOUR_DEFAULT_APPROVER_ID"
            }
          ]
        },
        "displayName": "Configuration",
        "nextStep": "Define Variable",
        "type": "Mutation"
      },
      "Define Variable": {
        "actionId": "sp:define-variable",
        "attributes": {
          "id": "sp:define-variable",
          "variables": [
            {
              "description": "Identity id. Set by Set manager, or by the default-approver step when the recipient has no manager.",
              "name": "Manager",
              "transforms": [],
              "variableA": "NONE"
            },
            {
              "description": "Identity id. Set by Set manager's manager, or by the default-approver step when that level is missing.",
              "name": "Managers Manager",
              "transforms": [],
              "variableA": "NONE"
            },
            {
              "description": "The winning tier's approver id, with no type prefix. NONE means no extra approver.",
              "name": "Approver",
              "transforms": [],
              "variableA": "NONE"
            },
            {
              "description": "IDENTITY or GOVERNANCE_GROUP. Set by the step that detects the kind from the Approver id format.",
              "name": "Approver Type",
              "transforms": [],
              "variableA": "NONE"
            },
            {
              "description": "Display name sent on the callback. The approval engine assigns no owner when this is empty, so it always carries the resolved name or the id.",
              "name": "Approver Name",
              "transforms": [],
              "variableA": "NONE"
            }
          ]
        },
        "description": "Phase 1. Every variable starts at NONE, because Define Variable rejects empty values. Each manager level becomes the identity id or the Default Approver id. The step key must stay Define Variable: ISC builds the defineVariable paths from it and rejects update steps that target any other key.",
        "displayName": "Approver Variables",
        "nextStep": "Get Recipient",
        "type": "Mutation"
      },
      "Get Recipient": {
        "actionId": "sp:get-identity",
        "attributes": {
          "id.$": "$.trigger.requestedFor.id"
        },
        "catch": [
          {
            "next": "Set Default Manager Levels"
          }
        ],
        "displayName": "Get Recipient",
        "nextStep": "Check Manager",
        "type": "action",
        "versionNumber": 2
      },
      "Check Manager": {
        "actionId": "sp:compare-unary",
        "choiceList": [
          {
            "comparator": "IsPresent",
            "nextStep": "Get Manager",
            "variableA.$": "$.getRecipient.managerRef.id"
          }
        ],
        "defaultStep": "Set Default Manager Levels",
        "displayName": "Recipient has a manager?",
        "type": "choice"
      },
      "Set Default Manager Levels": {
        "actionId": "sp:update-variable",
        "attributes": {
          "id": "sp:update-variable",
          "variables": [
            {
              "description": "",
              "name": "$.defineVariable.manager",
              "transforms": [],
              "variableA.$": "$.configuration.defaultApprover"
            }
          ]
        },
        "description": "The recipient has no manager, or the manager could not be read. Sets Manager to the default approver id, then the next step sets Managers Manager the same way.",
        "displayName": "No manager, use default approver",
        "nextStep": "Set Default Managers Manager",
        "type": "Mutation"
      },
      "Get Manager": {
        "actionId": "sp:get-identity",
        "attributes": {
          "id.$": "$.getRecipient.managerRef.id"
        },
        "catch": [
          {
            "next": "Set Default Manager Levels"
          }
        ],
        "description": "Read to reach the next manager level. Set manager stores the identity id only.",
        "displayName": "Get Manager",
        "nextStep": "Set Manager",
        "type": "action",
        "versionNumber": 2
      },
      "Set Manager": {
        "actionId": "sp:update-variable",
        "attributes": {
          "id": "sp:update-variable",
          "variables": [
            {
              "description": "",
              "name": "$.defineVariable.manager",
              "transforms": [],
              "variableA.$": "$.getManager.id"
            }
          ]
        },
        "displayName": "Set manager",
        "nextStep": "Check Managers Manager",
        "type": "Mutation"
      },
      "Check Managers Manager": {
        "actionId": "sp:compare-unary",
        "choiceList": [
          {
            "comparator": "IsPresent",
            "nextStep": "Set Managers Manager",
            "variableA.$": "$.getManager.managerRef.id"
          }
        ],
        "defaultStep": "Set Default Managers Manager",
        "displayName": "Manager has a manager?",
        "type": "choice"
      },
      "Set Default Managers Manager": {
        "actionId": "sp:update-variable",
        "attributes": {
          "id": "sp:update-variable",
          "variables": [
            {
              "description": "",
              "name": "$.defineVariable.managersManager",
              "transforms": [],
              "variableA.$": "$.configuration.defaultApprover"
            }
          ]
        },
        "description": "The manager has no manager, so that level falls back to the default approver id. Manager keeps the resolved identity id.",
        "displayName": "No manager's manager, use default approver",
        "nextStep": "Get Access Token",
        "type": "Mutation"
      },
      "Set Managers Manager": {
        "actionId": "sp:update-variable",
        "attributes": {
          "id": "sp:update-variable",
          "variables": [
            {
              "description": "",
              "name": "$.defineVariable.managersManager",
              "transforms": [],
              "variableA.$": "$.getManager.managerRef.id"
            }
          ]
        },
        "displayName": "Set manager's manager",
        "nextStep": "Get Access Token",
        "type": "Mutation"
      },
      "Get Access Token": {
        "actionId": "sp:http",
        "attributes": {
          "formRequestBody": {
            "grant_type": "client_credentials"
          },
          "method": "post",
          "param_authenticationRef": "basic",
          "requestContentType": "form",
          "url": "{{$.configuration.aPIURL}}/oauth/token"
        },
        "catch": [
          {
            "next": "Set Default Approver"
          }
        ],
        "description": "Phase 2. Set basic auth on this step to the workflow OAuth client. A failure falls through to the error approver.",
        "displayName": "Get Access Token",
        "nextStep": "Call Evaluate Risk",
        "type": "action",
        "versionNumber": 3
      },
      "Call Evaluate Risk": {
        "actionId": "sp:http",
        "attributes": {
          "jsonRequestBody": {
            "config": {
              "apiUrl": "{{$.configuration.aPIURL}}",
              "sourceName": "{{$.configuration.saaSCustomOperationsSourceName}}",
              "token": "{{$.getAccessToken.body.access_token}}"
            },
            "connectorRef": "{{$.configuration.saaSCustomOperationsConnectorID}}",
            "input": {
              "accessRequestId": "{{$.trigger.accessRequestId}}",
              "considerPrivilege": "{{$.configuration.considerPrivilege}}",
              "requestId": "evaluate-access-request-risk:{{$.trigger.accessRequestId}}:dynamic",
              "requestedItems.$": "$.trigger.requestedItems"
            },
            "tag": "latest",
            "type": "custom:evaluate-access-request-risk"
          },
          "method": "post",
          "param_authenticationRef": "none",
          "requestContentType": "json",
          "requestHeaders": {
            "Authorization": "Bearer {{$.getAccessToken.body.access_token}}"
          },
          "url": "{{$.configuration.aPIURL}}/beta/platform-connectors/{{$.configuration.saaSCustomOperationsConnectorID}}/invoke"
        },
        "catch": [
          {
            "next": "Set Default Approver"
          }
        ],
        "displayName": "Call Evaluate Risk",
        "nextStep": "Check Invoke Result",
        "type": "action",
        "versionNumber": 3
      },
      "Check Invoke Result": {
        "actionId": "sp:compare-strings",
        "choiceList": [
          {
            "comparator": "StringContains",
            "nextStep": "Set Default Approver",
            "variableA.$": "$.callEvaluateRisk.body",
            "variableB": "\"status\":\"failed\""
          }
        ],
        "defaultStep": "Read Risk Result",
        "description": "The connector returns HTTP 200 even when the operation failed. Catch that here so a leftover result account cannot look like a scored request.",
        "displayName": "Invoke failed?",
        "type": "choice"
      },
      "Read Risk Result": {
        "actionId": "sp:get-accounts",
        "attributes": {
          "filterCriteria": "nativeIdentity",
          "getAccountsBy": "filters",
          "operator": "eq",
          "value": "evaluate-access-request-risk:{{$.trigger.accessRequestId}}:dynamic"
        },
        "catch": [
          {
            "next": "Set Default Approver"
          }
        ],
        "description": "A failed read uses the error approver, not the High step.",
        "displayName": "Read Risk Result",
        "nextStep": "Check Tier",
        "type": "action",
        "versionNumber": 1
      },
      "Check Tier": {
        "actionId": "sp:compare-strings",
        "choiceList": [
          {
            "comparator": "StringEquals",
            "nextStep": "Set High Approver",
            "variableA.$": "$.readRiskResult.accounts[0].attributes['evaluate-access-request-risk:tier']",
            "variableB": "High"
          }
        ],
        "defaultStep": "Check Tier Medium",
        "description": "Phase 3. One step per tier sets Approver. Edit those three steps to change who approves.",
        "displayName": "Tier is High?",
        "type": "choice"
      },
      "Check Tier Medium": {
        "actionId": "sp:compare-strings",
        "choiceList": [
          {
            "comparator": "StringEquals",
            "nextStep": "Set Medium Approver",
            "variableA.$": "$.readRiskResult.accounts[0].attributes['evaluate-access-request-risk:tier']",
            "variableB": "Medium"
          }
        ],
        "defaultStep": "Check Tier Low",
        "displayName": "Tier is Medium?",
        "type": "choice"
      },
      "Check Tier Low": {
        "actionId": "sp:compare-strings",
        "choiceList": [
          {
            "comparator": "StringEquals",
            "nextStep": "Set Low Approver",
            "variableA.$": "$.readRiskResult.accounts[0].attributes['evaluate-access-request-risk:tier']",
            "variableB": "Low"
          }
        ],
        "defaultStep": "Set Default Approver",
        "description": "A missing or unknown tier is treated as a failed evaluation, not as High.",
        "displayName": "Tier is Low?",
        "type": "choice"
      },
      "Set High Approver": {
        "actionId": "sp:update-variable",
        "attributes": {
          "id": "sp:update-variable",
          "variables": [
            {
              "description": "",
              "name": "$.defineVariable.approver",
              "transforms": [],
              "variableA.$": "$.defineVariable.managersManager"
            }
          ]
        },
        "displayName": "Set High approver",
        "nextStep": "Check Approver",
        "type": "Mutation",
        "description": "Pick the High approver. Set this to the Manager, Managers Manager, or Default Approver variable, or to a literal id. Ids carry no type prefix; the kind is detected later. Set NONE to add no approver."
      },
      "Set Medium Approver": {
        "actionId": "sp:update-variable",
        "attributes": {
          "id": "sp:update-variable",
          "variables": [
            {
              "description": "",
              "name": "$.defineVariable.approver",
              "transforms": [],
              "variableA.$": "$.defineVariable.manager"
            }
          ]
        },
        "displayName": "Set Medium approver",
        "nextStep": "Check Approver",
        "type": "Mutation",
        "description": "Pick the Medium approver. Set this to the Manager, Managers Manager, or Default Approver variable, or to a literal id. Ids carry no type prefix; the kind is detected later. Set NONE to add no approver."
      },
      "Set Low Approver": {
        "actionId": "sp:update-variable",
        "attributes": {
          "id": "sp:update-variable",
          "variables": [
            {
              "description": "NONE adds no approver. Replace it with an approver id to add one.",
              "name": "$.defineVariable.approver",
              "transforms": [],
              "variableA": "NONE"
            }
          ]
        },
        "displayName": "Set Low approver",
        "nextStep": "Check Approver",
        "type": "Mutation",
        "description": "Pick the Low approver. Set this to the Manager, Managers Manager, or Default Approver variable, or to a literal id. Ids carry no type prefix; the kind is detected later. Set NONE to add no approver."
      },
      "Set Default Approver": {
        "actionId": "sp:update-variable",
        "attributes": {
          "id": "sp:update-variable",
          "variables": [
            {
              "description": "",
              "name": "$.defineVariable.approver",
              "transforms": [],
              "variableA.$": "$.configuration.defaultApprover"
            }
          ]
        },
        "displayName": "Set Error approver",
        "nextStep": "Check Approver",
        "type": "Mutation",
        "description": "Used whenever the risk evaluation cannot produce a tier: a failed token, invoke, or result read, and a missing or unknown tier."
      },
      "Check Approver": {
        "actionId": "sp:compare-strings",
        "choiceList": [
          {
            "comparator": "StringEquals",
            "nextStep": "Callback None",
            "variableA.$": "$.defineVariable.approver",
            "variableB": "NONE"
          }
        ],
        "defaultStep": "Check Approver Kind",
        "description": "Phase 4. Every tier converges here.",
        "displayName": "Approver is NONE?",
        "type": "choice"
      },
      "Callback": {
        "actionId": "sp:http",
        "attributes": {
          "jsonRequestBody": {
            "output": {
              "id": "{{$.defineVariable.approver}}",
              "name": "{{$.defineVariable.approverName}}",
              "type": "{{$.defineVariable.approverType}}"
            },
            "secret": "{{$.trigger._metadata.secret}}"
          },
          "method": "post",
          "param_authenticationRef": "none",
          "requestContentType": "json",
          "url.$": "$.trigger._metadata.callbackURL"
        },
        "description": "The trigger routes on id and type. An empty name leaves the approval with no owner and the approval workflow fails, so the name is always resolved before this step.",
        "displayName": "Callback",
        "nextStep": "End Success",
        "type": "action",
        "versionNumber": 3
      },
      "Callback None": {
        "actionId": "sp:http",
        "attributes": {
          "jsonRequestBody": {
            "output": {
              "id": "",
              "name": "",
              "type": ""
            },
            "secret": "{{$.trigger._metadata.secret}}"
          },
          "method": "post",
          "param_authenticationRef": "none",
          "requestContentType": "json",
          "url.$": "$.trigger._metadata.callbackURL"
        },
        "displayName": "Callback None",
        "nextStep": "End Success",
        "type": "action",
        "versionNumber": 3
      },
      "End Success": {
        "actionId": "sp:operator-success",
        "description": "The dynamic approval callback was sent.",
        "displayName": "Success",
        "type": "success"
      },
      "Check Approver Kind": {
        "actionId": "sp:compare-strings",
        "choiceList": [
          {
            "comparator": "StringContains",
            "nextStep": "Set Group Type",
            "variableA.$": "$.defineVariable.approver",
            "variableB": "-"
          }
        ],
        "defaultStep": "Set Identity Type",
        "description": "Governance group ids are hyphenated UUIDs and identity ids are unhyphenated 32-character hex, so the hyphen decides the kind and the operator never types a type prefix.",
        "displayName": "Approver is a governance group?",
        "type": "choice"
      },
      "Set Identity Type": {
        "actionId": "sp:update-variable",
        "attributes": {
          "id": "sp:update-variable",
          "variables": [
            {
              "description": "",
              "name": "$.defineVariable.approverType",
              "transforms": [],
              "variableA": "IDENTITY"
            }
          ]
        },
        "displayName": "Set identity type",
        "nextStep": "Get Approver Identity",
        "type": "Mutation"
      },
      "Set Group Type": {
        "actionId": "sp:update-variable",
        "attributes": {
          "id": "sp:update-variable",
          "variables": [
            {
              "description": "",
              "name": "$.defineVariable.approverType",
              "transforms": [],
              "variableA": "GOVERNANCE_GROUP"
            }
          ]
        },
        "displayName": "Set governance group type",
        "nextStep": "Get Approver Group",
        "type": "Mutation"
      },
      "Get Approver Identity": {
        "actionId": "sp:http",
        "attributes": {
          "method": "get",
          "param_authenticationRef": "none",
          "requestHeaders": {
            "Authorization": "Bearer {{$.getAccessToken.body.access_token}}"
          },
          "url": "{{$.configuration.aPIURL}}/v2026/identities/{{$.defineVariable.approver}}"
        },
        "catch": [
          {
            "next": "Set Fallback Name"
          }
        ],
        "description": "Reads the display name for the callback. A failure falls through to the id as the name, which keeps the callback valid.",
        "displayName": "Get Approver Identity",
        "nextStep": "Set Identity Name",
        "type": "action",
        "versionNumber": 3
      },
      "Get Approver Group": {
        "actionId": "sp:http",
        "attributes": {
          "method": "get",
          "param_authenticationRef": "none",
          "requestHeaders": {
            "Authorization": "Bearer {{$.getAccessToken.body.access_token}}"
          },
          "url": "{{$.configuration.aPIURL}}/v2026/workgroups/{{$.defineVariable.approver}}"
        },
        "catch": [
          {
            "next": "Set Fallback Name"
          }
        ],
        "description": "Reads the governance group display name for the callback. A failure falls through to the id as the name.",
        "displayName": "Get Approver Group",
        "nextStep": "Set Group Name",
        "type": "action",
        "versionNumber": 3
      },
      "Set Identity Name": {
        "actionId": "sp:update-variable",
        "attributes": {
          "id": "sp:update-variable",
          "variables": [
            {
              "description": "",
              "name": "$.defineVariable.approverName",
              "transforms": [],
              "variableA.$": "$.getApproverIdentity.body.name"
            }
          ]
        },
        "displayName": "Set identity name",
        "nextStep": "Callback",
        "type": "Mutation"
      },
      "Set Group Name": {
        "actionId": "sp:update-variable",
        "attributes": {
          "id": "sp:update-variable",
          "variables": [
            {
              "description": "",
              "name": "$.defineVariable.approverName",
              "transforms": [],
              "variableA.$": "$.getApproverGroup.body.name"
            }
          ]
        },
        "displayName": "Set governance group name",
        "nextStep": "Callback",
        "type": "Mutation"
      },
      "Set Fallback Name": {
        "actionId": "sp:update-variable",
        "attributes": {
          "id": "sp:update-variable",
          "variables": [
            {
              "description": "",
              "name": "$.defineVariable.approverName",
              "transforms": [],
              "variableA.$": "$.defineVariable.approver"
            }
          ]
        },
        "displayName": "Name lookup failed, use the id",
        "nextStep": "Callback",
        "type": "Mutation",
        "description": "The callback needs a non-empty name. Sending the id keeps routing correct and only degrades what the approver list displays."
      }
    }
  },
  "enabled": false,
  "trigger": {
    "type": "EXTERNAL",
    "attributes": {
      "id": "idn:external-http",
      "integrationId": null
    }
  }
}
