{
  "id": "YOUR_DYNAMIC_APPROVAL_WORKFLOW_ID",
  "name": "Dynamic Approval Workflow - Risk analysis",
  "description": "Adaptive Approvals wrapper. Native Access Request Submitted trigger plus one Approval Policy per risk tier. Scores with custom:evaluate-access-request-risk, then opens the High, Medium, or Low policy. Bind each policy's reviewer in the builder. Enable this workflow, then set the access item Approval Type to this workflow. A failed evaluation, or a missing tier, opens the Evaluation Failed policy rather than the High one.",
  "definition": {
    "start": "Configuration",
    "steps": {
      "Configuration": {
        "actionId": "sp:define-variable",
        "attributes": {
          "id": "sp:define-variable",
          "variables": [
            {
              "description": "ISC API base URL, no trailing slash.",
              "name": "API URL",
              "transforms": [],
              "variableA": "https://{tenant}.api.identitynow.com"
            },
            {
              "description": "Result source that stores custom operation output.",
              "name": "SaaS Custom Operations Source Name",
              "transforms": [],
              "variableA": "SaaS Custom Operations"
            },
            {
              "description": "Platform connector id for saas-custom-operations.",
              "name": "SaaS Custom Operations Connector ID",
              "transforms": [],
              "variableA": "YOUR_CONNECTOR_ID"
            },
            {
              "description": "true includes entitlement privilegeLevel.effective. false scores entitlements from Risk metadata only.",
              "name": "Consider Privilege",
              "transforms": [],
              "variableA": "true"
            }
          ]
        },
        "displayName": "Configuration",
        "nextStep": "Get Access Token",
        "type": "Mutation"
      },
      "Get Access Token": {
        "actionId": "sp:http",
        "attributes": {
          "formRequestBody": {
            "grant_type": "client_credentials"
          },
          "method": "post",
          "param_authenticationRef": "basic",
          "requestContentType": "form",
          "url": "{{$.configuration.aPIURL}}/oauth/token"
        },
        "catch": [
          {
            "next": "Approval Policy Evaluation Failed"
          }
        ],
        "description": "Set basic auth on this step to the workflow OAuth client.",
        "displayName": "Get Access Token",
        "nextStep": "Call Evaluate Risk",
        "type": "action",
        "versionNumber": 3
      },
      "Call Evaluate Risk": {
        "actionId": "sp:http",
        "attributes": {
          "jsonRequestBody": {
            "config": {
              "apiUrl": "{{$.configuration.aPIURL}}",
              "sourceName": "{{$.configuration.saaSCustomOperationsSourceName}}",
              "token": "{{$.getAccessToken.body.access_token}}"
            },
            "connectorRef": "{{$.configuration.saaSCustomOperationsConnectorID}}",
            "input": {
              "accessRequestId": "{{$.trigger.accessRequestId}}",
              "considerPrivilege": "{{$.configuration.considerPrivilege}}",
              "requestId": "evaluate-access-request-risk:{{$.trigger.accessRequestId}}:dynamic-approval",
              "requestedItems.$": "$.trigger.requestedItems"
            },
            "tag": "latest",
            "type": "custom:evaluate-access-request-risk"
          },
          "method": "post",
          "param_authenticationRef": "none",
          "requestContentType": "json",
          "requestHeaders": {
            "Authorization": "Bearer {{$.getAccessToken.body.access_token}}"
          },
          "url": "{{$.configuration.aPIURL}}/beta/platform-connectors/{{$.configuration.saaSCustomOperationsConnectorID}}/invoke"
        },
        "catch": [
          {
            "next": "Approval Policy Evaluation Failed"
          }
        ],
        "displayName": "Call Evaluate Risk",
        "nextStep": "Check Invoke Result",
        "type": "action",
        "versionNumber": 3
      },
      "Check Invoke Result": {
        "actionId": "sp:compare-strings",
        "choiceList": [
          {
            "comparator": "StringContains",
            "nextStep": "Approval Policy Evaluation Failed",
            "variableA.$": "$.callEvaluateRisk.body",
            "variableB": "\"status\":\"failed\""
          }
        ],
        "defaultStep": "Read Risk Result",
        "description": "The connector returns HTTP 200 even when the operation failed. Catch that here so a leftover result account cannot look like a scored request.",
        "displayName": "Invoke failed?",
        "type": "choice"
      },
      "Read Risk Result": {
        "actionId": "sp:get-accounts",
        "attributes": {
          "filterCriteria": "nativeIdentity",
          "getAccountsBy": "filters",
          "operator": "eq",
          "value": "evaluate-access-request-risk:{{$.trigger.accessRequestId}}:dynamic-approval"
        },
        "catch": [
          {
            "next": "Approval Policy Evaluation Failed"
          }
        ],
        "displayName": "Read Risk Result",
        "nextStep": "Check Tier",
        "type": "action",
        "versionNumber": 1
      },
      "Check Tier": {
        "actionId": "sp:compare-strings",
        "choiceList": [
          {
            "comparator": "StringEquals",
            "nextStep": "Approval Policy High",
            "variableA.$": "$.readRiskResult.accounts[0].attributes['evaluate-access-request-risk:tier']",
            "variableB": "High"
          }
        ],
        "defaultStep": "Check Tier Medium",
        "displayName": "Tier is High?",
        "type": "choice"
      },
      "Check Tier Medium": {
        "actionId": "sp:compare-strings",
        "choiceList": [
          {
            "comparator": "StringEquals",
            "nextStep": "Approval Policy Medium",
            "variableA.$": "$.readRiskResult.accounts[0].attributes['evaluate-access-request-risk:tier']",
            "variableB": "Medium"
          }
        ],
        "defaultStep": "Check Tier Low",
        "displayName": "Tier is Medium?",
        "type": "choice"
      },
      "Check Tier Low": {
        "actionId": "sp:compare-strings",
        "choiceList": [
          {
            "comparator": "StringEquals",
            "nextStep": "Approval Policy Low",
            "variableA.$": "$.readRiskResult.accounts[0].attributes['evaluate-access-request-risk:tier']",
            "variableB": "Low"
          }
        ],
        "defaultStep": "Approval Policy Evaluation Failed",
        "description": "A missing or unknown tier is treated as a failed evaluation, not as High.",
        "displayName": "Tier is Low?",
        "type": "choice"
      },
      "Approval Policy High": {
        "actionId": "sp:access-request-approval",
        "attributes": {
          "accessRequestId.$": "$.trigger.accessRequestId",
          "accountActivityId.$": "$.trigger.accountActivityId",
          "approvalActionAtTimeout": "EXPIRED",
          "approvalReminder": "false",
          "approvalTimeout": 7,
          "approvalType": "SINGLE",
          "autoApprovalEnabled.$": "$.trigger.autoApprove",
          "description": "High-risk approval. Bind the reviewer in this step after import.",
          "fallbackApprover.$": "$.trigger.fallbackApprover",
          "multiApproverReviewersConfig_approvalScheme": "SERIAL",
          "parentWorkflowExecutionId.$": "$.trigger.parentWorkflowExecutionId",
          "priority": "HIGH",
          "quorumApproverReviewersConfig_approvalScheme": "SERIAL",
          "reminderFrequency_timeZone": "Europe/Madrid",
          "requestId.$": "$.trigger.requestId",
          "requestedAt.$": "$.trigger.createdAt",
          "requestedBy.$": "$.trigger.requestedBy",
          "requestedFor.$": "$.trigger.requestedFor",
          "requestedItem.$": "$.trigger.requestedItem",
          "reviewerCategory": "IDENTITY",
          "reviewerId": "YOUR_HIGH_REVIEWER_ID",
          "singleApproverCategory": "MANAGER_OF",
          "sodViolationContext.$": "$.trigger.sodViolationContext",
          "staticAttributes.$": "$.trigger.staticAttributes",
          "timeout": "7",
          "timeoutAction": "EXPIRE",
          "workflowExecutionId.$": "$.trigger.workflowExecutionId"
        },
        "displayName": "Approval Policy High",
        "nextStep": "End Success",
        "type": "action",
        "versionNumber": 1
      },
      "Approval Policy Medium": {
        "actionId": "sp:access-request-approval",
        "attributes": {
          "accessRequestId.$": "$.trigger.accessRequestId",
          "accountActivityId.$": "$.trigger.accountActivityId",
          "approvalActionAtTimeout": "EXPIRED",
          "approvalReminder": "false",
          "approvalTimeout": 7,
          "approvalType": "SINGLE",
          "autoApprovalEnabled.$": "$.trigger.autoApprove",
          "description": "Medium-risk approval. Bind the reviewer in this step after import.",
          "fallbackApprover.$": "$.trigger.fallbackApprover",
          "multiApproverReviewersConfig_approvalScheme": "SERIAL",
          "parentWorkflowExecutionId.$": "$.trigger.parentWorkflowExecutionId",
          "priority": "MEDIUM",
          "quorumApproverReviewersConfig_approvalScheme": "SERIAL",
          "reminderFrequency_timeZone": "Europe/Madrid",
          "requestId.$": "$.trigger.requestId",
          "requestedAt.$": "$.trigger.createdAt",
          "requestedBy.$": "$.trigger.requestedBy",
          "requestedFor.$": "$.trigger.requestedFor",
          "requestedItem.$": "$.trigger.requestedItem",
          "reviewerCategory": "IDENTITY",
          "reviewerId": "YOUR_MEDIUM_REVIEWER_ID",
          "singleApproverCategory": "MANAGER_OF",
          "sodViolationContext.$": "$.trigger.sodViolationContext",
          "staticAttributes.$": "$.trigger.staticAttributes",
          "timeout": "7",
          "timeoutAction": "EXPIRE",
          "workflowExecutionId.$": "$.trigger.workflowExecutionId"
        },
        "displayName": "Approval Policy Medium",
        "nextStep": "End Success",
        "type": "action",
        "versionNumber": 1
      },
      "Approval Policy Low": {
        "actionId": "sp:access-request-approval",
        "attributes": {
          "accessRequestId.$": "$.trigger.accessRequestId",
          "accountActivityId.$": "$.trigger.accountActivityId",
          "approvalActionAtTimeout": "EXPIRED",
          "approvalReminder": "false",
          "approvalTimeout": 7,
          "approvalType": "SINGLE",
          "autoApprovalEnabled.$": "$.trigger.autoApprove",
          "description": "Low-risk approval. Bind the reviewer in this step after import.",
          "fallbackApprover.$": "$.trigger.fallbackApprover",
          "multiApproverReviewersConfig_approvalScheme": "SERIAL",
          "parentWorkflowExecutionId.$": "$.trigger.parentWorkflowExecutionId",
          "priority": "LOW",
          "quorumApproverReviewersConfig_approvalScheme": "SERIAL",
          "reminderFrequency_timeZone": "Europe/Madrid",
          "requestId.$": "$.trigger.requestId",
          "requestedAt.$": "$.trigger.createdAt",
          "requestedBy.$": "$.trigger.requestedBy",
          "requestedFor.$": "$.trigger.requestedFor",
          "requestedItem.$": "$.trigger.requestedItem",
          "reviewerCategory": "IDENTITY",
          "reviewerId": "YOUR_LOW_REVIEWER_ID",
          "singleApproverCategory": "MANAGER_OF",
          "sodViolationContext.$": "$.trigger.sodViolationContext",
          "staticAttributes.$": "$.trigger.staticAttributes",
          "timeout": "7",
          "timeoutAction": "EXPIRE",
          "workflowExecutionId.$": "$.trigger.workflowExecutionId"
        },
        "displayName": "Approval Policy Low",
        "nextStep": "End Success",
        "type": "action",
        "versionNumber": 1
      },
      "Approval Policy Evaluation Failed": {
        "actionId": "sp:access-request-approval",
        "attributes": {
          "accessRequestId.$": "$.trigger.accessRequestId",
          "accountActivityId.$": "$.trigger.accountActivityId",
          "approvalActionAtTimeout": "EXPIRED",
          "approvalReminder": "false",
          "approvalTimeout": 7,
          "approvalType": "SINGLE",
          "autoApprovalEnabled.$": "$.trigger.autoApprove",
          "description": "The risk evaluation could not produce a tier. Bind the reviewer in this step after import.",
          "fallbackApprover.$": "$.trigger.fallbackApprover",
          "multiApproverReviewersConfig_approvalScheme": "SERIAL",
          "parentWorkflowExecutionId.$": "$.trigger.parentWorkflowExecutionId",
          "priority": "HIGH",
          "quorumApproverReviewersConfig_approvalScheme": "SERIAL",
          "reminderFrequency_timeZone": "Europe/Madrid",
          "requestId.$": "$.trigger.requestId",
          "requestedAt.$": "$.trigger.createdAt",
          "requestedBy.$": "$.trigger.requestedBy",
          "requestedFor.$": "$.trigger.requestedFor",
          "requestedItem.$": "$.trigger.requestedItem",
          "reviewerCategory": "IDENTITY",
          "reviewerId": "YOUR_EVALUATION_FAILED_REVIEWER_ID",
          "singleApproverCategory": "MANAGER_OF",
          "sodViolationContext.$": "$.trigger.sodViolationContext",
          "staticAttributes.$": "$.trigger.staticAttributes",
          "timeout": "7",
          "timeoutAction": "EXPIRE",
          "workflowExecutionId.$": "$.trigger.workflowExecutionId"
        },
        "description": "Every failed token, invoke, or result read lands here, as does a missing or unknown tier. A request that was never scored is not the same as a High-risk one, so it gets its own reviewer.",
        "displayName": "Approval Policy Evaluation Failed",
        "nextStep": "End Success",
        "type": "action",
        "versionNumber": 1
      },
      "End Success": {
        "actionId": "sp:operator-success",
        "description": "The approval policy was submitted.",
        "displayName": "Success",
        "type": "success"
      }
    }
  },
  "enabled": false,
  "trigger": {
    "type": "EVENT",
    "attributes": {
      "id": "idn:access-request-trigger"
    }
  }
}
