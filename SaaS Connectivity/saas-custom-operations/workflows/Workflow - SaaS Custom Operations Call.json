{
  "id": "ce96dd2e-6135-47e9-b7dd-e6840f5e6366",
  "name": "SaaS Custom Operations Call",
  "description": "",
  "definition": {
    "start": "Configuration",
    "steps": {
      "Call SaaS Custom Operation": {
        "actionId": "sp:http",
        "attributes": {
          "jsonRequestBody": {
            "config": {
              "apiUrl": "{{$.configuration.aPIURL}}",
              "sourceId": "{{$.configuration.saaSCustomOperationsSourceID}}",
              "token": "{{$.getAccessToken.body.access_token}}"
            },
            "connectorRef": "{{$.configuration.saaSCustomOperationsConnectorID}}",
            "input": {
              "message": "Hello, world!",
              "requestId": "req-888"
            },
            "tag": "latest",
            "type": "custom:example"
          },
          "method": "post",
          "param_authenticationRef": "none",
          "requestContentType": "json",
          "requestHeaders": {
            "Authorization": "Bearer {{$.getAccessToken.body.access_token}}"
          },
          "url": "{{$.configuration.aPIURL}}/beta/platform-connectors/{{$.configuration.saaSCustomOperationsConnectorID}}/invoke"
        },
        "displayName": "Call SaaS Custom Operation",
        "nextStep": "Read SaaS Custom Operations Result",
        "type": "action",
        "versionNumber": 3
      },
      "Configuration": {
        "actionId": "sp:define-variable",
        "attributes": {
          "id": "sp:define-variable",
          "variables": [
            {
              "description": "",
              "name": "API URL",
              "transforms": [],
              "variableA": "https://company22986-poc.api.identitynow.com"
            },
            {
              "description": "",
              "name": "SaaS Custom Operations Source ID",
              "transforms": [],
              "variableA": "170f7a14192043b49ce429fed77f6c9e"
            },
            {
              "description": "",
              "name": "SaaS Custom Operations Connector ID",
              "transforms": [],
              "variableA": "131d48cc-d53f-4a67-9858-845f16166376"
            }
          ]
        },
        "displayName": "Configuration",
        "nextStep": "Get Access Token",
        "type": "Mutation"
      },
      "End Step - Success": {
        "actionId": "sp:operator-success",
        "displayName": "",
        "type": "success"
      },
      "Get Access Token": {
        "actionId": "sp:http",
        "attributes": {
          "formRequestBody": {
            "grant_type": "client_credentials"
          },
          "method": "post",
          "param_authenticationRef": "basic",
          "param_basic": {
            "mapping": {
              "auth_password": "password",
              "auth_username": "username"
            },
            "paramID": "06484d5d-98e6-44c6-8de0-3f7f855bf888",
            "paramType": "1.1",
            "refID": "cfefeca4-9db2-4356-8630-c814739e6bbb"
          },
          "requestContentType": "form",
          "url": "{{$.configuration.aPIURL}}/oauth/token"
        },
        "displayName": "Get Access Token",
        "nextStep": "Call SaaS Custom Operation",
        "type": "action",
        "versionNumber": 3
      },
      "Read SaaS Custom Operation Result": {
        "actionId": "sp:get-accounts",
        "attributes": {
          "filterCriteria": "nativeIdentity",
          "getAccountsBy": "filters",
          "operator": "eq",
          "resultSelector": [
            "$.readSaaSCustomOperationResult.accounts[*].attributes"
          ],
          "value": "req-888"
        },
        "displayName": "Read SaaS Custom Operation Result",
        "nextStep": "End Step - Success",
        "type": "action",
        "versionNumber": 1
      }
    }
  },
  "enabled": false,
  "executionCount": 1,
  "failureCount": 0,
  "trigger": {
    "type": "EXTERNAL",
    "attributes": {
      "id": "idn:external-http",
      "integrationId": null
    }
  }
}