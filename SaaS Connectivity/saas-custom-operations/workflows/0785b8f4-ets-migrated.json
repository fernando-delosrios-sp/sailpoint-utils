{
  "version": 1,
  "description": "Migrated template for ETS access request submitted workflow — replaces isc-custom-endpoint with custom:access-request-status (ets-comment profile)",
  "object": {
    "id": "0785b8f4-7623-4be6-a9fa-757521f60efb",
    "name": "T1.21 etsAccessRequestSubmitted (Migrated)",
    "description": "Uses custom:access-request-status (ets-comment profile) for preApproval callback comment.",
    "enabled": false,
    "definition": {
      "start": "Configuration",
      "steps": {
        "Configuration": {
          "actionId": "sp:define-variable",
          "attributes": {
            "variables": [
              {
                "name": "API URL",
                "variableA": "https://your-tenant.api.identitynow.com"
              },
              {
                "name": "SaaS Custom Operations Source ID",
                "variableA": "YOUR_DUMMY_SOURCE_ID"
              },
              {
                "name": "SaaS Custom Operations Connector ID",
                "variableA": "YOUR_CONNECTOR_ID"
              }
            ]
          },
          "nextStep": "Get Access Token",
          "type": "Mutation"
        },
        "Get Access Token": {
          "actionId": "sp:http",
          "attributes": {
            "formRequestBody": {
              "grant_type": "client_credentials"
            },
            "method": "post",
            "param_authenticationRef": "basic",
            "requestContentType": "form",
            "url": "{{$.configuration.aPIURL}}/oauth/token"
          },
          "nextStep": "Invoke Access Request Status",
          "type": "action",
          "versionNumber": 3
        },
        "Invoke Access Request Status": {
          "actionId": "sp:http",
          "attributes": {
            "jsonRequestBody": {
              "connectorRef": "{{$.configuration.saaSCustomOperationsConnectorID}}",
              "tag": "latest",
              "type": "custom:access-request-status",
              "input": {
                "requestId": "{{$.trigger.accessRequestId}}",
                "accessRequestId": "{{$.trigger.accessRequestId}}",
                "outputProfile": "ets-comment"
              },
              "config": {
                "apiUrl": "{{$.configuration.aPIURL}}",
                "token": "{{$.getAccessToken.body.access_token}}",
                "sourceId": "{{$.configuration.saaSCustomOperationsSourceID}}"
              }
            },
            "method": "post",
            "requestContentType": "json",
            "requestHeaders": {
              "Authorization": "Bearer {{$.getAccessToken.body.access_token}}"
            },
            "url": "{{$.configuration.aPIURL}}/beta/platform-connectors/{{$.configuration.saaSCustomOperationsConnectorID}}/invoke"
          },
          "nextStep": "Read ETS Comment Result",
          "type": "action",
          "versionNumber": 3
        },
        "Read ETS Comment Result": {
          "actionId": "sp:get-accounts",
          "attributes": {
            "filterCriteria": "nativeIdentity",
            "getAccountsBy": "filters",
            "operator": "eq",
            "resultSelector": ["$.readETSCommentResult.accounts[*].attributes"],
            "value": "{{$.trigger.accessRequestId}}"
          },
          "nextStep": "HTTP Callback Response",
          "type": "action",
          "versionNumber": 1
        },
        "HTTP Callback Response": {
          "actionId": "sp:http",
          "attributes": {
            "jsonRequestBody": {
              "output": {
                "approved": true,
                "approver": "RiskEvaluator",
                "comment.$": "$.readETSCommentResult.accounts[0].attributes.param1"
              },
              "secret": "{{$.trigger._metadata.secret}}"
            },
            "method": "post",
            "requestContentType": "json",
            "url.$": "$.trigger._metadata.callbackURL"
          },
          "nextStep": "End Step - Success",
          "type": "action",
          "versionNumber": 3
        },
        "End Step - Success": {
          "actionId": "sp:operator-success",
          "type": "success"
        }
      }
    },
    "trigger": {
      "type": "EXTERNAL",
      "attributes": {
        "id": "idn:external-http"
      }
    }
  }
}
