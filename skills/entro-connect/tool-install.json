    "aws": {
      "authOnce": "aws sso login",
      "credentialBoundary": "vendor CLI token cache",
      "docsUrl": "https://docs.aws.amazon.com/cli/latest/userguide/getting-started-install.html",
      "presenceCheck": {
        "command": "command -v aws",
        "sourceUrl": "https://docs.aws.amazon.com/cli/latest/userguide/getting-started-install.html",
        "retrievedAt": "2026-08-31"
      },
      "capabilityProbe": {
        "command": "aws --version",
        "sourceUrl": "https://docs.aws.amazon.com/cli/latest/userguide/getting-started-install.html",
        "retrievedAt": "2026-08-31",
        "suitableWhen": "aws-cli/2 is reported"
      },
      "authCheck": {
        "command": "aws sts get-caller-identity",
        "sourceUrl": "https://docs.aws.amazon.com/cli/latest/reference/sts/get-caller-identity.html",
        "retrievedAt": "2026-08-31"
      },
      "platformIdentity": {
        "command": "aws sts get-caller-identity --output json",
        "principal": "Arn",
        "endpoint": "sts regional endpoint in use",
        "scope": "Account",
        "sourceUrl": "https://docs.aws.amazon.com/cli/latest/reference/sts/get-caller-identity.html",
        "retrievedAt": "2026-08-31"
      },
      "install": {
        "windows": {
          "method": "winget",
          "command": "winget install --id Amazon.AWSCLI",
          "docsUrl": "https://docs.aws.amazon.com/cli/latest/userguide/getting-started-install.html"
        },
        "macos": {
          "method": "homebrew",
          "command": "brew install awscli",
          "docsUrl": "https://docs.aws.amazon.com/cli/latest/userguide/getting-started-install.html"
        },
        "linux": {
          "method": "docs",
          "command": null,
          "docsUrl": "https://docs.aws.amazon.com/cli/latest/userguide/getting-started-install.html"
        }
      },
      "configureOnce": {
        "methods": [
          {
            "name": "IAM user access keys",
            "whenToPick": "Your organization does not use IAM Identity Center, or you already hold an IAM user access key. Needs nothing configured at the organization level and works in any AWS account. The keys are long-lived, so rotate or delete them once onboarding is done.",
            "command": "aws configure",
            "check": {
              "command": "CREDS=\"${AWS_SHARED_CREDENTIALS_FILE:-$HOME/.aws/credentials}\"; test -f \"$CREDS\" && grep -q \"aws_access_key_id\" \"$CREDS\"",
              "sourceUrl": "https://docs.aws.amazon.com/cli/latest/userguide/cli-authentication-user.html",
              "retrievedAt": "2026-09-03"
            },
            "suitableWhen": "Shared credentials file already holds an access key ID",
            "prompts": [
              {
                "prompt": "AWS Access Key ID",
                "whereToFind": "IAM console \u2192 Users \u2192 your user \u2192 Security credentials \u2192 Access keys \u2192 Create access key, or the credentials CSV downloaded when that key was created. aws configure import --csv loads the same CSV without retyping."
              },
              {
                "prompt": "AWS Secret Access Key",
                "whereToFind": "Shown once when the access key is created, and in that same credentials CSV. Type it straight into the prompt.",
                "secret": true
              },
              {
                "prompt": "Default region name",
                "whereToFind": "Operator choice: the default AWS Region this profile sends commands to."
              },
              {
                "prompt": "Default output format",
                "whereToFind": "Operator choice: typically json if unspecified."
              }
            ],
            "authOnce": null,
            "credentialBoundary": "shared credentials file holding long-lived keys",
            "docsUrl": "https://docs.aws.amazon.com/cli/latest/userguide/cli-authentication-user.html",
            "sourceUrl": "https://docs.aws.amazon.com/cli/latest/userguide/cli-authentication-user.html",
            "retrievedAt": "2026-09-03"
          },
          {
            "name": "IAM Identity Center",
            "whenToPick": "Your organization has IAM Identity Center \u2014 the AWS access portal \u2014 enabled and you sign in through it. Credentials are short-lived and refresh with a browser sign-in.",
            "command": "aws configure sso",
            "check": {
              "command": "CONFIG=\"${AWS_CONFIG_FILE:-$HOME/.aws/config}\"; test -f \"$CONFIG\" && grep -qE \"sso_session|sso_start_url\" \"$CONFIG\"",
              "sourceUrl": "https://docs.aws.amazon.com/cli/latest/userguide/cli-configure-sso.html",
              "retrievedAt": "2026-09-03"
            },
            "suitableWhen": "AWS config file already has an IAM Identity Center session or start URL",
            "prompts": [
              {
                "prompt": "SSO session name (Recommended)",
                "whereToFind": "Operator-chosen name for this IAM Identity Center session in the AWS config file."
              },
              {
                "prompt": "SSO start URL",
                "whereToFind": "AWS access portal \u2192 permission set \u2192 Access keys \u2192 IAM Identity Center credentials (Start URL). On AWS CLI 2.22.0+, the Issuer URL from the IAM Identity Center console Dashboard or Settings is an alternative."
              },
              {
                "prompt": "SSO region",
                "whereToFind": "Same AWS access portal path as the start URL (IAM Identity Center credentials). The AWS Region that hosts the IAM Identity Center directory."
              },
              {
                "prompt": "SSO registration scopes",
                "whereToFind": "Press Enter to accept the default sso:account:access unless an administrator named other OAuth scopes."
              },
              {
                "prompt": "AWS account",
                "whereToFind": "The target AWS account Entro will scan; pick an account whose permission set can create the Entro role."
              },
              {
                "prompt": "IAM role",
                "whereToFind": "A permission set in that account that can create the Entro integration role."
              },
              {
                "prompt": "Default client Region",
                "whereToFind": "Operator choice: the default AWS Region this CLI profile sends commands to."
              },
              {
                "prompt": "CLI default output format",
                "whereToFind": "Operator choice: typically json if unspecified."
              },
              {
                "prompt": "Profile name",
                "whereToFind": "Operator choice: the name this profile is stored under; default makes it the default profile."
              }
            ],
            "authOnce": "aws sso login",
            "credentialBoundary": "vendor CLI token cache",
            "docsUrl": "https://docs.aws.amazon.com/cli/latest/userguide/cli-configure-sso.html",
            "sourceUrl": "https://docs.aws.amazon.com/cli/latest/userguide/cli-configure-sso.html",
            "retrievedAt": "2026-09-03"
          }
        ]
      }
    },
