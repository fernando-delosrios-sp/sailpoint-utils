{
  "toolInstall": {
    "az": {
      "authOnce": "az login",
      "credentialBoundary": "vendor CLI token cache",
      "docsUrl": "https://learn.microsoft.com/cli/azure/install-azure-cli",
      "presenceCheck": {
        "command": "command -v az",
        "sourceUrl": "https://learn.microsoft.com/cli/azure/install-azure-cli",
        "retrievedAt": "2026-08-31"
      },
      "capabilityProbe": {
        "command": "az version",
        "sourceUrl": "https://learn.microsoft.com/cli/azure/install-azure-cli",
        "retrievedAt": "2026-08-31",
        "suitableWhen": "JSON includes azure-cli"
      },
      "authCheck": {
        "command": "az account show",
        "sourceUrl": "https://learn.microsoft.com/cli/azure/account",
        "retrievedAt": "2026-08-31"
      },
      "platformIdentity": {
        "command": "az account show --output json",
        "principal": "user.name",
        "endpoint": "environmentName",
        "scope": "id (subscription) and tenantId",
        "sourceUrl": "https://learn.microsoft.com/cli/azure/account",
        "retrievedAt": "2026-08-31"
      },
      "install": {
        "windows": {
          "method": "winget",
          "command": "winget install --exact --id Microsoft.AzureCLI",
          "docsUrl": "https://learn.microsoft.com/cli/azure/install-azure-cli-windows"
        },
        "macos": {
          "method": "homebrew",
          "command": "brew update && brew install azure-cli",
          "docsUrl": "https://learn.microsoft.com/cli/azure/install-azure-cli-macos"
        },
        "linux": {
          "method": "docs",
          "command": null,
          "docsUrl": "https://learn.microsoft.com/cli/azure/install-azure-cli-linux"
        }
      }
    },
    "pwsh": {
      "authOnce": "pwsh (then Connect-AzAccount when using Azure modules)",
      "credentialBoundary": "vendor CLI token cache",
      "docsUrl": "https://learn.microsoft.com/powershell/scripting/install/installing-powershell",
      "presenceCheck": {
        "command": "command -v pwsh",
        "sourceUrl": "https://learn.microsoft.com/powershell/scripting/install/installing-powershell",
        "retrievedAt": "2026-08-31"
      },
      "capabilityProbe": {
        "command": "pwsh -NoProfile -Command \"Get-Module -ListAvailable Az, Microsoft.Graph | Select-Object Name, Version\"",
        "sourceUrl": "https://learn.microsoft.com/powershell/azure/install-azure-powershell",
        "retrievedAt": "2026-08-31",
        "suitableWhen": "Az and Microsoft.Graph modules are listed",
        "minVersion": "7.0"
      },
      "authCheck": {
        "command": "pwsh -NoProfile -Command \"Get-AzSubscription -ErrorAction Stop | Select-Object -First 1 | Out-Null\"",
        "sourceUrl": "https://learn.microsoft.com/powershell/module/az.accounts/get-azcontext",
        "retrievedAt": "2026-08-31"
      },
      "platformIdentity": {
        "command": "pwsh -NoProfile -Command \"Get-AzContext | Select-Object Account, Environment, Tenant, Subscription | ConvertTo-Json\"",
        "principal": "Account",
        "endpoint": "Environment",
        "scope": "Tenant and Subscription",
        "sourceUrl": "https://learn.microsoft.com/powershell/module/az.accounts/get-azcontext",
        "retrievedAt": "2026-08-31"
      },
      "install": {
        "windows": {
          "method": "winget",
          "command": "winget install --id Microsoft.PowerShell --source winget",
          "docsUrl": "https://learn.microsoft.com/powershell/scripting/install/installing-powershell-on-windows"
        },
        "macos": {
          "method": "homebrew",
          "command": "brew install --cask powershell",
          "docsUrl": "https://learn.microsoft.com/powershell/scripting/install/installing-powershell-on-macos"
        },
        "linux": {
          "method": "docs",
          "command": null,
          "docsUrl": "https://learn.microsoft.com/powershell/scripting/install/installing-powershell-on-linux"
        }
      }
    },
